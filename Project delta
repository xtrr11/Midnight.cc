function applyForce(Part, Color, p42, p43)
	local P42 = p42 or "ForceField"
	local ClampedValueRatio = math.clamp(p43 or 100, 10, 100) / 100
	local ForceField = Enum.Material.ForceField
	local Transparency = 0
	local Reflectance = 0
	
	if P42 == "Glass" then
		ForceField = Enum.Material.Glass
		Transparency = (1 - ClampedValueRatio) * 0.72
		Reflectance = 0.2
	elseif P42 == "Neon" or P42 == "Glow" then
		ForceField = Enum.Material.Neon
		Transparency = P42 == "Glow" and (1 - ClampedValueRatio) * 0.45 or 0
	elseif P42 == "Smooth" then
		ForceField = Enum.Material.SmoothPlastic
	end
	Part.Material = ForceField
	Part.Color = Color
	Part.Transparency = Transparency
	Part.Reflectance = Reflectance
	pcall(function()
		Part.MaterialVariant = ""
	end)
	
	if Part:IsA("MeshPart") then
		Part.TextureID = ""
	end
	local SpecialMesh = Part:FindFirstChildOfClass("SpecialMesh")
	
	if SpecialMesh then
		SpecialMesh.TextureId = ""
	end
end

