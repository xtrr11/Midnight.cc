function installSwimHooks()
	if swimHooked or type(hookmetamethod) ~= "function" then
		return
	end
	swimHooked = true
	local oldName
	local function namecallHook(self, ...)
		local args = { ... }
		local method = getnamecallmethod()
		if method == "GetAttribute" and flagBool("NoSpread_Enabled") then
			if args[1] == "AccuracyDeviation" then
				return 0
			end
		end
		local instantShot = Library.Flags["SA_NoDrag"] == true and silentOn() and silentPart and silentPart.Parent and shotInstant and os.clock() - shotInstant < 0.25
		if method == "Raycast" and instantShot and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
			local traced = debug.traceback()
			local bulletRay = string.find(traced, "Bullet", 1, true) ~= nil
			if not bulletRay then
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				bulletRay = root and (args[1] - root.Position).Magnitude < 10 and args[2].Magnitude > 25
			end
			if bulletRay then
				args[2] = silentPart.Position - args[1]
				return oldName(self, unpack(args))
			end
		end
		if method == "InvokeServer" and typeof(self) == "Instance" and self.Name == "FireProjectile" and instantShot then
			bulletInfos = bulletInfos or {}
			local packet = table.create(3)
			packet[1] = args[2]
			packet[2] = args[3]
			packet[3] = args[1]
			bulletInfos[args[2]] = packet
			if args[1] ~= nil then
				bulletInfos[args[1]] = packet
			end
			return oldName(self, unpack(args))
		end
		if method == "FireServer" and typeof(self) == "Instance" and self.Name == "ProjectileInflict" and Library.Flags["SA_NoDrag"] == true and silentOn() then
			local traced = debug.traceback()
			local fromController = string.find(traced, "CharacterController", 1, true) ~= nil
			local fromBullet = string.find(traced, "Bullet", 1, true) ~= nil
			if fromController and not fromBullet then
				return coroutine.yield()
			end
			local packet = bulletInfos and (bulletInfos[args[3]] or bulletInfos[args[2]] or bulletInfos[args[1]])
			if type(packet) == "table" and type(packet[2]) == "number" then
				args[4] = packet[2] + 5
			end
			return oldName(self, unpack(args))
		end
		return oldName(self, ...)
	end
	if type(newcclosure) == "function" then
		namecallHook = newcclosure(namecallHook)
	end
	oldName = hookmetamethod(game, "__namecall", namecallHook)
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", function(self, key)
		if key == "ReducedMotionEnabled" and flagBool("NoRecoil_Enabled") and self == game:GetService("GuiService") then
			return true
		end
		return oldIndex(self, key)
	end)
end

