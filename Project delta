						end
						local HealthOfResult, HealthOfResult2 = healthOf(Character)
						local ClampedValue = math.clamp(HealthOfResult2 > 0 and HealthOfResult / HealthOfResult2 or 0, 0, 1)
						local ClampedValue1 = math.clamp(EnsurePackResult.name.Size, 11, 14)
