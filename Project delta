local espPacks = {}
local drawingWarned = false

function hidePack(pack)
	for key, drawing in pack do
		if key == "bones" or key == "limbs" or key == "corners" then
			for _, line in drawing do
				line.Visible = false
			end
		else
			drawing.Visible = false
		end
	end
end

function destroyPack(pack)
	for key, drawing in pack do
		if key == "bones" or key == "limbs" or key == "corners" then
			for _, line in drawing do
				pcall(function()
					line:Remove()
				end)
			end
		else
			pcall(function()
				drawing:Remove()
			end)
		end
	end
end

function makePack()
	local function square(thickness, filled)
		local drawing = Drawing.new("Square")
		drawing.Visible = false
		drawing.Thickness = thickness
		drawing.Filled = filled
		drawing.Transparency = 1
		return drawing
	end
	local function text()
		local drawing = Drawing.new("Text")
		drawing.Visible = false
		drawing.Size = 13
		drawing.Center = true
		drawing.Outline = true
		drawing.OutlineColor = Color3.new(0, 0, 0)
		drawing.Transparency = 1
		drawing.Font = 2
		return drawing
	end
	local bones = {}
	local limbs = {}
	for index = 1, 32 do
		local ok, line = pcall(function()
			local created = Drawing.new("Line")
			created.Visible = false
			created.Thickness = index % 2 == 0 and 1 or 3
			created.Transparency = 1
			return created
		end)
		if ok and line then
			bones[#bones + 1] = line
		end
		if index <= 16 then
			local okBox, limb = pcall(function()
				return square(1, false)
			end)
			if okBox and limb then
				limbs[#limbs + 1] = limb
			end
		end
	end
	local corners = {}
	for index = 1, 16 do
		local okLine, line = pcall(function()
			local created = Drawing.new("Line")
			created.Visible = false
			created.Thickness = index <= 8 and 3 or 1
			created.Transparency = 1
			return created
		end)
		if okLine and line then
			corners[#corners + 1] = line
		end
	end
	local cheat = text()
	cheat.Color = Color3.fromRGB(255, 50, 50)
	cheat.Size = 11
	cheat.Outline = true
	cheat.OutlineColor = Color3.new(0, 0, 0)
	pcall(function()
		cheat.ZIndex = 8
	end)
	local kd = text()
	kd.Size = 11
	kd.Center = true
	return {
		outline = square(3, false),
		box = square(1, false),
		name = text(),
		dist = text(),
		weapon = text(),
		hpOutline = square(1, false),
		hpBack = square(1, true),
		hpFill = square(1, true),
		hpText = text(),
		visor = text(),
		aim = text(),
		cheat = cheat,
		kd = kd,
		bones = bones,
		limbs = limbs,
		corners = corners,
	}
end

function ensurePack(player)
	local pack = espPacks[player]
	if pack then
		return pack
	end
	local ok, created = pcall(makePack)
	if not ok then
		return nil
	end
	espPacks[player] = created
	return created
end

function rootPart(character)
	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("Head")
		or character.PrimaryPart
end

function healthOf(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.MaxHealth > 0 then
		return humanoid.Health, humanoid.MaxHealth
	end
	local current = character:GetAttribute("Health") or character:GetAttribute("HP")
	local maxHealth = character:GetAttribute("MaxHealth") or 100
	if type(current) == "number" then
		return current, type(maxHealth) == "number" and maxHealth or 100
	end
	return 100, 100
end

function weaponOf(character)
	local gun = heldGun(character)
	if gun then
		return gun.Name
	end
	return ""
end

function findItemModel(name)
	if not name or name == "" then
		return nil
	end
	local cached = modelCache and modelCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	modelCache = modelCache or {}
	local replicated = game:GetService("ReplicatedStorage")
	for _, folderName in { "ItemsList", "Items", "ItemModels", "HandModels", "Models", "Assets" } do
		local folder = replicated:FindFirstChild(folderName)
		local node = folder and folder:FindFirstChild(name, true)
		if node and (node:IsA("Model") or node:IsA("Folder") or node:IsA("BasePart")) then
			modelCache[name] = node
			return node
		end
	end
	modelCache[name] = false
	return nil
end

function itemIcon(name, model)
	local cached = iconCache and iconCache[name]
	if type(cached) == "string" then
		return cached
	end
	iconCache = iconCache or {}
	local function asset(value)
		if type(value) == "number" and value > 0 then
			return "rbxassetid://" .. tostring(math.floor(value))
		end
		if type(value) == "string" and value ~= "" then
			if string.find(value, "rbxasset", 1, true) or string.find(value, "rbxthumb", 1, true) then
				return value
			end
			local id = tonumber(value)
			if id and id > 0 then
				return "rbxassetid://" .. value
			end
		end
		return ""
	end
	local function fromInst(inst)
		if not inst then
			return ""
		end
		for _, key in { "Icon", "Image", "Thumbnail", "ImageId", "IconId" } do
			local image = asset(inst:GetAttribute(key))
			if image ~= "" then
				return image
			end
		end
		for _, child in inst:GetChildren() do
			if child:IsA("ImageLabel") and child.Image ~= "" then
				return child.Image
			end
			if child:IsA("StringValue") or child:IsA("NumberValue") or child:IsA("IntValue") then
				if string.find(string.lower(child.Name), "icon", 1, true) then
					local image = asset(child.Value)
					if image ~= "" then
						return image
					end
				end
			end
		end
		return ""
	end
	local function fromRoot(root)
		if not root then
			return ""
		end
		local image = fromInst(root)
		if image == "" then
			image = fromInst(root:FindFirstChild("ItemProperties"))
		end
		if image ~= "" then
			return image
		end
		for _, child in root:GetDescendants() do
			if child:IsA("ImageLabel") and child.Image ~= "" then
				local blob = string.lower(child.Name)
				if blob == "icon" or blob == "image" or string.find(blob, "icon", 1, true) then
					return child.Image
				end
			end
		end
		return ""
	end
	local found = fromRoot(findItemModel(name))
	if found == "" then
		found = fromRoot(model)
	end
	if found == "" then
		local replicated = game:GetService("ReplicatedStorage")
		for _, folderName in { "ItemsList", "Items", "ItemModels", "Icons", "ItemIcons", "Images" } do
			local folder = replicated:FindFirstChild(folderName)
			local node = folder and folder:FindFirstChild(name, true)
			found = fromRoot(node)
			if found ~= "" then
				break
			end
		end
	end
	iconCache[name] = found
	return found
end

function weaponIcon(player)
	weaponIcons = weaponIcons or {}
	local icon = weaponIcons[player]
	if icon and icon:IsA("ImageLabel") then
		return icon
	end
	if icon and icon.Parent then
		icon:Destroy()
	end
	if not iconGui then
		local parent = nil
		pcall(function()
			parent = gethui()
		end)
		iconGui = Instance.new("ScreenGui")
		iconGui.Name = "MidnightIcons"
		iconGui.IgnoreGuiInset = true
		iconGui.ResetOnSpawn = false
		iconGui.DisplayOrder = 30
		iconGui.Parent = parent or game:GetService("CoreGui")
	end
	icon = Instance.new("ImageLabel")
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Size = UDim2.fromOffset(48, 48)
	icon.AnchorPoint = Vector2.new(0.5, 0)
	icon.Visible = false
	icon.ScaleType = Enum.ScaleType.Fit
	icon.Parent = iconGui
	weaponIcons[player] = icon
	return icon
end

