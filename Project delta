	if Inventory then
		for _, child in Inventory:GetDescendants() do
			Seen += 1
			if Seen > 140 then
				break
			end
			local Slot = tostring(child:GetAttribute("Slot") or child:GetAttribute("SlotType") or "")
			if isVisorName(child.Name, Slot) then
				local Item = readItem(child)
				if Item ~= nil then
					IsTransparencyBelow = Item
					break
				end
				if IsTransparencyBelow == nil then
					IsTransparencyBelow = "equipped"
				end
			end
		end
	end
	if (IsTransparencyBelow == nil or IsTransparencyBelow == "equipped") and Player.Character then
		local Head = Player.Character:FindFirstChild("Head")
		
