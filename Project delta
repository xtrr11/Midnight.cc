function questFits(Text, Pattern)
	return Text ~= "" and (Pattern ~= "" and (#Pattern >= 4 and (Text == Pattern or not ({
		rations = true,
		ration = true,
		documents = true,
		document = true,
		meds = true,
		bandage = true,
