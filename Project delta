function listIcon(Text)
	if type(Text) ~= "string" or Text == "" then
		return ""
	end
	iconCache = iconCache or {}
	local Icon = iconCache["list:" .. Text]
	
	if type(Icon) == "string" then
		return Icon
	end
	local function thumb(Match)
		return "rbxthumb://type=Asset&id=" .. tostring(math.floor(tonumber(Match))) .. "&w=150&h=150"
	end
	
	local function asset(Text)
		if type(Text) == "number" and Text > 1000 then
			return thumb(Text)
		elseif type(Text) ~= "string" or Text == "" then
			return ""
		elseif string.find(Text, "rbxthumb://", 1, true) then
			return Text
		else
			local Match = string.match(Text, "(%d%d%d%d%d%d+)")
			
			return if Match and (string.find(Text, "rbxasset", 1, true) or string.find(Text, "id=", 1, true) or tonumber(Text)) then thumb(Match) elseif string.find(Text, "rbxasset", 1, true) then Text else ""
		end
	end
	
	local function read(Object)
		if typeof(Object) ~= "Instance" then
			return ""
		end
		if Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
			local AssetResult = asset(Object.Image)
			
			if AssetResult ~= "" then
				return AssetResult
			end
		end
		if Object:IsA("Decal") or Object:IsA("Texture") then
			local AssetResult = asset(Object.Texture)
			
			if AssetResult ~= "" then
				return AssetResult
			end
		end
		if Object:IsA("StringValue") or Object:IsA("NumberValue") or Object:IsA("IntValue") then
			local AssetResult = asset(Object.Value)
			
			if AssetResult ~= "" then
				return AssetResult
			end
		end
		local AssetResult = nil
		for Text, attribute in Object:GetAttributes() do
			AssetResult = asset(attribute)
			
			if AssetResult ~= "" and (type(attribute) == "number" or string.find(string.lower(Text), "icon", 1, true) or string.find(string.lower(Text), "image", 1, true) or type(attribute) == "string" and string.find(attribute, "rbxasset", 1, true)) then
				return AssetResult
			end
		end
		local Success, Result = pcall(function()
			return Object.ImageContent
		end)
		
		if Success and Result ~= nil then
			local AssetResult1 = asset(tostring(Result))
			
			if AssetResult1 ~= "" then
				return AssetResult1
			end
		end
		return ""
	end
	
	local ItemsList = game:GetService("ReplicatedStorage"):FindFirstChild("ItemsList")
	local Text1 = ItemsList and (ItemsList:FindFirstChild(Text) or ItemsList:FindFirstChild(Text, true))
	
	if not Text1 and ItemsList then
		local Lowered = string.lower(Text)
		
		for _, child in ItemsList:GetChildren() do
			if string.lower(child.Name) == Lowered then
				Text1 = child
				break
			end
		end
	end
	local v646 = ""
	
	if Text1 then
		v646 = read(Text1:FindFirstChild("Icon", true) or (Text1:FindFirstChild("ItemIcon", true) or Text1:FindFirstChild("Thumbnail", true)))
		
		if v646 == "" then
			v646 = read(Text1)
		end
		if v646 == "" then
			for _, descendant in Text1:GetDescendants() do
				local Lowered = string.lower(descendant.Name)
				
				if Lowered == "icon" or string.find(Lowered, "icon", 1, true) or descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
					v646 = read(descendant)
					
					if v646 ~= "" then break end
				end
			end
		end
		if v646 == "" then
			local ItemProperties = Text1:FindFirstChild("ItemProperties") or Text1:FindFirstChildWhichIsA("ModuleScript")
			
			if ItemProperties and ItemProperties:IsA("ModuleScript") then
				local Success, Result = pcall(require, ItemProperties)
				
				if Success and type(Result) == "table" then
					v646 = asset(Result.Icon or (Result.Image or (Result.IconId or (Result.Thumbnail or Result.AssetId))))
				end
			end
		end
	end
	iconCache["list:" .. Text] = v646
	
	return v646
end

