function updateEspMap()
	if not espMapMarkers or not espMapImage or not espMapTemplate then
		return
	end
	for _, player in Players:GetPlayers() do
		if not espMapMarkers[player] then
			local dot = espMapTemplate:Clone()
			dot.Visible = true
			dot.ImageColor3 = Color3.fromRGB(227, 36, 36)
			if dot:FindFirstChild("TextLabel") then
				dot.TextLabel.Visible = true
				dot.TextLabel.Text = player.Name
			end
			dot.Parent = espMapFolder
			espMapMarkers[player] = dot
		end
	end
	local sizeReal = espMapImage:GetAttribute("SizeReal")
	if type(sizeReal) ~= "number" or sizeReal == 0 then
		sizeReal = 1
	end
	local playersFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	for player, dot in espMapMarkers do
		if not player.Parent then
			dot:Destroy()
			espMapMarkers[player] = nil
		else
			local profile = playersFolder and playersFolder:FindFirstChild(player.Name)
			local status = profile and profile:FindFirstChild("Status")
			local uac = status and status:FindFirstChild("UAC")
			local pos = uac and uac:GetAttribute("LastVerifiedPos")
			if typeof(pos) ~= "Vector3" and player.Character then
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				pos = root and root.Position
			end
			if typeof(pos) == "Vector3" and dot.Parent then
				dot.Position = UDim2.new(0.5 + ((pos.X - 208) / sizeReal), 0, 0.5 + ((pos.Z + 203) / sizeReal), 0)
				dot.Visible = true
			elseif dot.Parent then
				dot.Visible = false
			end
		end
	end
	local keep = {}
	harvestMapPoints()
	for key, saved in mapSaved or {} do
		local show = false
		if string.sub(key, 1, 6) == "exfil:" then
			show = flagBool("ExfilESPEnabled")
		elseif string.sub(key, 1, 6) == "quest:" then
			show = flagBool("QuestESP")
		elseif string.sub(key, 1, 5) == "boss:" then
			show = flagBool("BossESPEnabled") or Library.Flags["BossTracker"] ~= false
		end
		if show then
			keep[key] = true
			mapExtra(key, saved.text, saved.color, saved.pos)
		end
	end
	if espMapExtra then
		for key, dot in espMapExtra do
			if not keep[key] then
				dot:Destroy()
				espMapExtra[key] = nil
			end
		end
	end
end

function runEspMap()
	local opened = pcall(openEspMap)
	if not opened or not espMapMarkers then
		task.wait(1)
		espMapRunning = false
		return
	end
	while flagBool("EspMap") do
		pcall(warmMapStream)
		pcall(updateEspMap)
		task.wait(0.15)
	end
	closeEspMap()
	espMapRunning = false
end

