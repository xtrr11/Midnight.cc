function applyInstantHeal()
	if flagBool("InstantHeal") then
		if os.clock() - (healPatchAt or 0) > 0.75 then
			healPatchAt = os.clock()
			pcall(patchHealItems)
		end
		local HoldingHeal = holdingHeal()
		healRushed = healRushed or {}
		
		local function rushTrack(AnimationTrack)
			if typeof(AnimationTrack) ~= "Instance" or not AnimationTrack.IsPlaying then return end
			local Animation = AnimationTrack.Animation
			local Lowered = string.lower(tostring(AnimationTrack.Name or "") .. " " .. tostring(Animation and Animation.Name or "") .. " " .. tostring(Animation and Animation.Parent and Animation.Parent.Name or ""))
			local Loco = string.find(Lowered, "idle", 1, true) or string.find(Lowered, "walk", 1, true) or string.find(Lowered, "run", 1, true) or string.find(Lowered, "sprint", 1, true) or string.find(Lowered, "jump", 1, true) or string.find(Lowered, "equip", 1, true) or string.find(Lowered, "inspect", 1, true) or string.find(Lowered, "reload", 1, true) or string.find(Lowered, "fire", 1, true) or string.find(Lowered, "shoot", 1, true) or string.find(Lowered, "aim", 1, true)
			local Named = isHealName(Lowered) or string.find(Lowered, "heal", 1, true) or string.find(Lowered, "use", 1, true) or string.find(Lowered, "action", 1, true) or string.find(Lowered, "consum", 1, true) or string.find(Lowered, "apply", 1, true) or string.find(Lowered, "inject", 1, true) or string.find(Lowered, "bandage", 1, true)
			
			if Loco or not HoldingHeal and not Named then return end
			if AnimationTrack.Looped and not Named then return end
			if AnimationTrack.Length > 0.2 and not healRushed[AnimationTrack] and AnimationTrack.TimePosition < AnimationTrack.Length * 0.5 then
				healRushed[AnimationTrack] = true
				AnimationTrack.TimePosition = math.max(AnimationTrack.Length - 0.08, 0)
			end
			if AnimationTrack.Speed < 40 then
				AnimationTrack:AdjustSpeed(40)
			end
		end
		
		local function rushRoot(Object)
			if not Object then return end
			local function take(Object1)
				if not Object1 or not (Object1:IsA("Animator") or Object1:IsA("Humanoid") or Object1:IsA("AnimationController")) then return end
				pcall(function()
					for _, playingAnimationTrack in Object1:GetPlayingAnimationTracks() do
						rushTrack(playingAnimationTrack)
					end
				end)
			end
			
			take(Object)
			
			for _, descendant in Object:GetDescendants() do
				take(descendant)
			end
		end
		
		local Character = LocalPlayer.Character
		
		if Character then
			rushRoot(Character)
		end
		local CurrentCamera = workspace.CurrentCamera
		
		if CurrentCamera then
			rushRoot(CurrentCamera:FindFirstChild("ViewModel") or CurrentCamera:FindFirstChild("Viewmodel"))
		end
		healWas = true
		
		return
	else
		healRushed = nil
		
		if healWas then
			pcall(patchHealItems)
		end
		healWas = false
	end
end

