		if atmo then
			lightBase.Atmo = atmo
			lightBase.Density = atmo.Density
			lightBase.Haze = atmo.Haze
		end
	end
	if flagBool("Fullbright") then
		lighting.FogStart = 0
		lighting.FogEnd = 100000
		if not flagBool("Amb_Enabled") then
			lighting.Brightness = 2
			lighting.Ambient = Color3.fromRGB(190, 190, 190)
			lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
		end
		if lightBase.Atmo then
			lightBase.Atmo.Density = 0
			lightBase.Atmo.Haze = 0
		end
		lightBase.fogOn = true
	elseif lightBase.fogOn then
		lighting.FogEnd = lightBase.FogEnd
		lighting.FogStart = lightBase.FogStart
		if not flagBool("Amb_Enabled") then
			lighting.Brightness = lightBase.Brightness
			lighting.Ambient = lightBase.Ambient
			lighting.OutdoorAmbient = lightBase.OutdoorAmbient
		end
		if lightBase.Atmo then
			lightBase.Atmo.Density = lightBase.Density
			lightBase.Atmo.Haze = lightBase.Haze
		end
		lightBase.fogOn = false
	end
	if flagBool("NoShadows") then
		lighting.GlobalShadows = false
		lightBase.shadowOn = true
	elseif lightBase.shadowOn then
		lighting.GlobalShadows = lightBase.GlobalShadows
		lightBase.shadowOn = false
	end
	if flagBool("TimeChanger") then
		lighting.ClockTime = flagNum("ClockHour", 14)
		lightBase.timeOn = true
	elseif lightBase.timeOn then
		lighting.ClockTime = lightBase.ClockTime
		lightBase.timeOn = false
	end

	local wantHud = flagBool("Coords") or flagBool("ProxAlert")
	if wantHud then
		ensureUtilityGui()
	end
	if coordFrame then
		coordFrame.Visible = flagBool("Coords")
		if coordFrame.Visible and camera then
			local character = LocalPlayer.Character
			local root = character and rootPart(character)
			local pos = root and root.Position or camera.CFrame.Position
			local look = camera.CFrame.LookVector
			local deg = (math.deg(math.atan2(look.X, look.Z)) + 360) % 360
			local names = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
			local facing = names[math.floor((deg + 22.5) / 45) % 8 + 1]
			coordLabel.Text = string.format("%d, %d, %d   %s", math.floor(pos.X + 0.5), math.floor(pos.Y + 0.5), math.floor(pos.Z + 0.5), facing)
		end
	end
	if proxFrame then
		local showProx = flagBool("ProxAlert")
		proxFrame.Visible = showProx
		if showProx and camera then
			local origin = camera.CFrame.Position
			local metersMax = flagNum("ProxRange", 40)
			local studs = metersMax <= 0 and math.huge or metersMax / 0.28
			local lines = {}
			for _, player in Players:GetPlayers() do
				local character = player ~= LocalPlayer and player.Character
				local root = character and rootPart(character)
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= studs then
						lines[#lines + 1] = string.format("%s  %dm", player.Name, math.floor(dist * 0.28 + 0.5))
					end
				end
			end
			proxLabel.Text = #lines > 0 and table.concat(lines, "\n") or "clear"
			proxFrame.Visible = true
		end
	end

	if flagBool("Crosshair") and camera and type(Drawing) == "table" and type(Drawing.new) == "function" then
		if not crossDraw then
			crossDraw = {}
			for index = 1, 4 do
				local line = Drawing.new("Line")
				line.Visible = false
				line.Thickness = 1
				crossDraw[index] = line
			end
		end
		local center = camera.ViewportSize * 0.5
		local gap = flagNum("CrossGap", 4)
		local size = flagNum("CrossSize", 8)
		local color = flagColor("CrossColor", Color3.fromRGB(255, 255, 255))
		local arms = {
			{ center.X - gap - size, center.Y, center.X - gap, center.Y },
			{ center.X + gap, center.Y, center.X + gap + size, center.Y },
			{ center.X, center.Y - gap - size, center.X, center.Y - gap },
			{ center.X, center.Y + gap, center.X, center.Y + gap + size },
		}
		for index, arm in arms do
			local line = crossDraw[index]
			line.Visible = true
			line.Color = color
			line.From = Vector2.new(arm[1], arm[2])
			line.To = Vector2.new(arm[3], arm[4])
		end
	elseif crossDraw then
		for _, line in crossDraw do
			line.Visible = false
		end
	end
end

function muteOneSprint(track, sprinting)
	local anim = track.Animation
	local blob = string.lower(tostring(track.Name or "") .. " " .. tostring(anim and anim.Name or "") .. " " .. tostring(anim and anim.Parent and anim.Parent.Name or ""))
	local id = anim and anim.AnimationId
	local hit = sprintIds and id and sprintIds[id]
	if not hit then
		if string.find(blob, "sprint", 1, true) then
			hit = true
		elseif sprinting and string.find(blob, "run", 1, true) and not string.find(blob, "walk", 1, true) and not string.find(blob, "idle", 1, true) then
			hit = true
		end
	end
	if not hit then
		return
	end
	pcall(function()
		track:AdjustWeight(0, 0)
		track:AdjustSpeed(0)
	end)
end

function watchSprintAnimator(animator)
	sprintWatched = sprintWatched or {}
	if not animator or sprintWatched[animator] then
		return
	end
	sprintWatched[animator] = true
	animator.AnimationPlayed:Connect(function(track)
		if flagBool("NoSprintAnim") then
			muteOneSprint(track, true)
		end
	end)
end

function muteSprintAnims(character, camera)
	sprintIds = sprintIds or {}
	local now = os.clock()
	if now - (sprintScanTime or 0) > 0.4 then
		sprintScanTime = now
		sprintAnims = {}
		local function collect(root)
			if not root then
				return
			end
			for _, inst in root:GetDescendants() do
				if inst:IsA("Animation") then
					local blob = string.lower(inst.Name .. " " .. (inst.Parent and inst.Parent.Name or ""))
					if string.find(blob, "sprint", 1, true) and inst.AnimationId ~= "" then
						sprintIds[inst.AnimationId] = true
					end
				elseif inst:IsA("Animator") then
					sprintAnims[#sprintAnims + 1] = inst
				end
			end
		end
		collect(character)
		local viewmodel = camera and (camera:FindFirstChild("ViewModel") or camera:FindFirstChild("Viewmodel"))
		collect(viewmodel or camera)
	end
	local sprinting = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	for _, animator in sprintAnims or {} do
		if animator.Parent then
			watchSprintAnimator(animator)
			for _, track in animator:GetPlayingAnimationTracks() do
				muteOneSprint(track, sprinting)
			end
		end
	end
end

RunService:BindToRenderStep("MidnightMisc", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if flagBool("AA_Enabled") then
		local character = LocalPlayer.Character
		local root = character and rootPart(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid then
			humanoid.AutoRotate = false
			local _, yaw = camera.CFrame:ToOrientation()
			if flagBool("AA_Pitch") then
				local tilt = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
				tilt = tilt and tilt:FindFirstChild("UpdateTilt")
				if tilt then
					pcall(function()
						tilt:FireServer(flagNum("AA_PitchValue", 0) / 100, 0)
					end)
				end
			end
			if flagBool("AA_Yaw") then
				yaw += math.rad(flagNum("AA_YawValue", 180))
			end
			if flagBool("AA_Jitter") then
				aaJitterTime = (aaJitterTime or 0) + (dt or 0)
				local strength = math.rad(flagNum("AA_JitterValue", 45))
				yaw += aaJitterSide and strength or -strength
				if aaJitterTime > 0.03 then
					aaJitterSide = not aaJitterSide
					aaJitterTime = 0
				end
			end
			if flagBool("AA_Spin") then
				local speed = math.rad(flagNum("AA_SpinSpeed", 3) * 36)
				yaw += (tick() * speed) % (math.pi * 2)
			end
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
		end
		if Library.Flags["AA_ShowServer"] ~= false then
			local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
			local profile = folder and folder:FindFirstChild(LocalPlayer.Name)
			local status = profile and profile:FindFirstChild("Status")
			local uac = status and status:FindFirstChild("UAC")
			local pos = uac and uac:GetAttribute("LastVerifiedPos")
			if typeof(pos) == "CFrame" then
				pos = pos.Position
			end
			if typeof(pos) == "Vector3" then
				if not serverGhost then
					serverGhost = Instance.new("Part")
					serverGhost.Name = "MidnightServer"
					serverGhost.Anchored = true
					serverGhost.CanCollide = false
					serverGhost.CanQuery = false
					serverGhost.CanTouch = false
					serverGhost.Transparency = 1
					serverGhost.Size = Vector3.new(2, 5, 1)
					serverGhost.Parent = workspace
					local highlight = Instance.new("Highlight")
					highlight.FillColor = Color3.fromRGB(255, 70, 70)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.45
					highlight.OutlineTransparency = 0
					highlight.Adornee = serverGhost
					highlight.Parent = serverGhost
				end
				serverGhost.CFrame = CFrame.new(pos)
				serverGhost.Parent = workspace
			end
		elseif serverGhost then
			serverGhost.Parent = nil
		end
	elseif aaWasOn then
		local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.AutoRotate = true
		end
	end
	if not flagBool("AA_Enabled") and serverGhost then
		serverGhost.Parent = nil
	end
	aaWasOn = flagBool("AA_Enabled")

	applyUtility(camera)

	checkHits()
	gunClock += dt
	if gunClock > 0.5 then
		gunClock = 0
		applyGunMods()
	end

	local targetFov = nil
	if flagBool("FovChanger_Enabled") then
		targetFov = flagNum("FovChanger_Amount", 100)
	end
	if flagBool("FovZoom_Enabled") and zoomWanted then
		targetFov = flagNum("FovZoom_Amount", 30)
	end
	if targetFov and not freecamActive then
		local speed = flagNum("FovZoom_AnimSpeed", 8)
		camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * math.clamp(dt * speed, 0, 1)
	end

	if flagBool("Freecam_Enabled") and freecamWanted and not freecamActive then
		freecamActive = true
		freecamCf = camera.CFrame
		local look = freecamCf.LookVector
		freecamYaw = math.atan2(-look.X, -look.Z)
		freecamPitch = math.asin(math.clamp(look.Y, -1, 1))
		camera.CameraType = Enum.CameraType.Scriptable
		streamFocus = Instance.new("Part")
		streamFocus.Name = "MidnightStream"
		streamFocus.Anchored = true
		streamFocus.CanCollide = false
		streamFocus.CanQuery = false
		streamFocus.Transparency = 1
		streamFocus.Size = Vector3.new(2, 2, 2)
		streamFocus.CFrame = freecamCf
		streamFocus.Parent = workspace
		pcall(function()
			LocalPlayer.ReplicationFocus = streamFocus
		end)
	elseif freecamActive and not (flagBool("Freecam_Enabled") and freecamWanted) then
		freecamActive = false
		camera.CameraType = Enum.CameraType.Custom
		local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		pcall(function()
			LocalPlayer.ReplicationFocus = LocalPlayer.Character
		end)
		if streamFocus then
			streamFocus:Destroy()
			streamFocus = nil
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	if freecamActive and freecamCf then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UserInputService:GetMouseDelta()
			freecamYaw -= delta.X * 0.003
			freecamPitch = math.clamp(freecamPitch - delta.Y * 0.003, -1.4, 1.4)
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		freecamCf = CFrame.new(freecamCf.Position) * CFrame.fromEulerAnglesYXZ(freecamPitch, freecamYaw, 0)
		local speed = math.max(flagNum("Freecam_Speed", 30), 1) * 2
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move += freecamCf.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move -= freecamCf.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move -= freecamCf.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += freecamCf.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			move -= Vector3.yAxis
		end
		if move.Magnitude > 0 then
			freecamCf += move.Unit * speed * dt
		end
		camera.CFrame = freecamCf
		if targetFov then
			camera.FieldOfView = targetFov
		end
		if streamFocus then
			streamFocus.CFrame = freecamCf
			pcall(function()
				LocalPlayer.ReplicationFocus = streamFocus
			end)
		end
		streamClock += dt
		if streamClock > 0.35 then
			streamClock = 0
			local pos = freecamCf.Position
			task.spawn(function()
				pcall(function()
					LocalPlayer:RequestStreamAroundAsync(pos, 1)
				end)
			end)
		end
	end

	if flagBool("Amb_Enabled") then
		local lighting = game:GetService("Lighting")
		if not ambSaved then
			ambSaved = {
				Brightness = lighting.Brightness,
				Ambient = lighting.Ambient,
				OutdoorAmbient = lighting.OutdoorAmbient,
				ColorShift_Top = lighting.ColorShift_Top,
			}
		end
		local color = flagColor("Amb_Color", Color3.fromRGB(80, 255, 140))
		lighting.Brightness = flagNum("Amb_Brightness", 12) / 100 * 4
		lighting.OutdoorAmbient = color
		lighting.Ambient = color:Lerp(Color3.new(0, 0, 0), 1 - flagNum("Amb_Indoor", 4) / 100)
		lighting.ColorShift_Top = color
		local correction = lighting:FindFirstChild("MidnightAmb")
		if not correction then
			correction = Instance.new("ColorCorrectionEffect")
			correction.Name = "MidnightAmb"
			correction.Parent = lighting
		end
		correction.Enabled = true
		correction.TintColor = color
		correction.Brightness = flagNum("Amb_Indoor", 4) / 100 * 0.4
		if flagBool("Bloom_Enabled") then
			local bloom = lighting:FindFirstChildOfClass("BloomEffect")
			if not bloom then
				bloom = Instance.new("BloomEffect")
				bloom.Name = "MidnightBloom"
				bloom.Parent = lighting
			end
			bloom.Enabled = true
			bloom.Intensity = flagNum("Bloom_Intensity", 1)
			bloom.Size = flagNum("Bloom_Size", 24)
		end
	elseif ambSaved then
		local lighting = game:GetService("Lighting")
		lighting.Brightness = ambSaved.Brightness
		lighting.Ambient = ambSaved.Ambient
		lighting.OutdoorAmbient = ambSaved.OutdoorAmbient
		lighting.ColorShift_Top = ambSaved.ColorShift_Top
		local correction = lighting:FindFirstChild("MidnightAmb")
		if correction then
			correction.Enabled = false
		end
		ambSaved = nil
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and rootPart(character)
	if flagBool("OmniSprint") and humanoid and humanoid.MoveDirection.Magnitude > 0.05 and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
		humanoid.WalkSpeed = math.clamp(flagNum("OmniSprintSpeed", 20), 16, 20)
	elseif flagBool("Speedhack") and humanoid then
		humanoid.WalkSpeed = math.clamp(flagNum("SpeedhackSpeed", 20), 16, 24)
	end
	if flagBool("NoSprintAnim") then
		muteSprintAnims(character, camera)
	end
	if flagBool("JumpHack") and humanoid then
		humanoid.JumpHeight = math.clamp(flagNum("JumpHeight", 5), 3, 8)
	end
	if flagBool("Gravity") then
		if gravBase == nil then
			gravBase = workspace.Gravity
		end
		workspace.Gravity = math.clamp(flagNum("GravityValue", 80), 20, 196)
	elseif gravBase then
		workspace.Gravity = gravBase
		gravBase = nil
	end
	if flagBool("NoJumpCd") and humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end
	if flagBool("Bhop") and humanoid and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.Running then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	if flagBool("LongJump") and humanoid and root then
		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Jumping and not longJumpUsed then
			longJumpUsed = true
			local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			if flat.Magnitude > 0.05 then
				local boost = math.clamp(flagNum("LongJumpPower", 18), 5, 40)
				root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + flat.Unit * boost
			end
		elseif state ~= Enum.HumanoidStateType.Freefall then
			longJumpUsed = false
		end
	end
	if flagBool("SpiderClimb") and (spiderOn or keyHeld("SpiderKey")) and humanoid and root and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0.1 then
		local flat = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z)
		if flat.Magnitude > 0.05 then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			local hit = workspace:Raycast(root.Position, flat.Unit * 2.2, params)
			if hit and hit.Normal.Y < 0.4 then
				local climb = math.clamp(flagNum("SpiderSpeed", 14), 8, 15)
				local velocity = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(velocity.X, climb, velocity.Z)
			end
		end
	end
	if flagBool("NoFallDamage_Enabled") and humanoid and root then
		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.PlatformStanding then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
		if root.AssemblyLinearVelocity.Y < -30 then
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, -8, velocity.Z)
		end
	end
	if flagBool("Jesus_Enabled") and root then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.IgnoreWater = false
		local ahead = root.CFrame.LookVector * 5
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0) + ahead, params)
		if hit and hit.Material == Enum.Material.Water then
			if not jesusPart then
				jesusPart = Instance.new("Part")
				jesusPart.Name = "MidnightWater"
				jesusPart.Anchored = true
				jesusPart.CanCollide = true
				jesusPart.CanQuery = false
				jesusPart.Size = Vector3.new(14, 0.2, 14)
				jesusPart.Transparency = 1
				jesusPart.Parent = workspace
			end
			jesusPart.CFrame = CFrame.new(hit.Position)
		elseif jesusPart then
			jesusPart:Destroy()
			jesusPart = nil
		end
	elseif jesusPart then
		jesusPart:Destroy()
		jesusPart = nil
	end
	if humanoid then
		if thirdActive() then
			installCameraHook()
			installSwimHooks()
			if flagBool("ThirdShow") and character then
				for _, part in character:GetDescendants() do
					if part:IsA("BasePart") then
						part.LocalTransparencyModifier = 0
					end
				end
			end
		elseif thirdWas then
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
			LocalPlayer.CameraMaxZoomDistance = 0.5
			LocalPlayer.CameraMinZoomDistance = 0.5
		end
		thirdWas = thirdActive()
	end
	if flagBool("InstantEquip") or flagBool("InstantReload") then
		local viewmodel = camera:FindFirstChild("ViewModel")
		local viewHumanoid = viewmodel and viewmodel:FindFirstChildOfClass("Humanoid")
		local animator = viewHumanoid and viewHumanoid:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in animator:GetPlayingAnimationTracks() do
				local anim = track.Animation
				local animName = anim and string.lower(anim.Name) or ""
				local skipEquip = flagBool("InstantEquip") and string.find(animName, "equip", 1, true)
				local skipReload = flagBool("InstantReload") and string.find(animName, "reload", 1, true)
				if (skipEquip or skipReload) and track.Speed < 8 then
					track:AdjustSpeed(8)
				end
			end
		end
	end
	if flagBool("ViewTex") then
		applyViewmodel()
	end
	if flagBool("ViewOffset") then
		local viewmodel = camera:FindFirstChild("ViewModel")
		local root = viewmodel and viewmodel:FindFirstChild("HumanoidRootPart")
		if root then
			local offset = Vector3.new(flagNum("ViewX", 0), flagNum("ViewY", 0), flagNum("ViewZ", 0))
			viewWelds = viewWelds or {}
			for _, name in { "LeftUpperArm", "RightUpperArm", "ItemRoot", "Motor6D" } do
				local weld = root:FindFirstChild(name)
				if weld and weld:IsA("Motor6D") then
					if not viewWelds[weld] then
						viewWelds[weld] = weld.C0
					end
					weld.C0 = viewWelds[weld] + offset
				end
			end
		end
	elseif viewWelds then
		for weld, origin in viewWelds do
			if weld.Parent then
				weld.C0 = origin
			end
		end
		viewWelds = nil
	end
	if not swimHooked then
		installSwimHooks()
	end
	if flagBool("NoScreenEffects") or screenFxWas then
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		local noInset = playerGui and playerGui:FindFirstChild("NoInsetGui")
		local mainFrame = noInset and noInset:FindFirstChild("MainFrame")
		local effects = mainFrame and mainFrame:FindFirstChild("ScreenEffects")
		if effects then
			effects.Visible = not flagBool("NoScreenEffects")
		end
		screenFxWas = flagBool("NoScreenEffects")
	end
	if flagBool("NoVisor") then
		if os.clock() - (visorScanAt or 0) > 0.35 then
			visorScanAt = os.clock()
			local viewmodel = camera:FindFirstChildOfClass("Model")
			if viewmodel then
				for _, object in viewmodel:GetDescendants() do
					local name = string.lower(object.Name)
					if string.find(name, "visor", 1, true) or string.find(name, "glass", 1, true) then
						if object:IsA("BasePart") then
							object.LocalTransparencyModifier = 1
						elseif object:IsA("Decal") or object:IsA("Texture") then
							object.Transparency = 1
						elseif object:IsA("SurfaceGui") or object:IsA("BillboardGui") then
							object.Enabled = false
						end
					end
				end
			end
			local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
			if playerGui then
				for _, object in playerGui:GetDescendants() do
					if object:IsA("GuiObject") and string.find(string.lower(object.Name), "visor", 1, true) then
						object.Visible = false
					end
				end
			end
		end
	end
	if flagBool("HideServerInfo") or serverInfoWas then
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		local info = playerGui and playerGui:FindFirstChild("ServerInfo")
		local frame = info and info:FindFirstChild("Frame")
		local label = frame and frame:FindFirstChild("serverInfo")
		if label then
			label.Visible = not flagBool("HideServerInfo")
		end
		serverInfoWas = flagBool("HideServerInfo")
	end
	if flagBool("VisorIndicator") then
		if not visorLabel then
			visorLabel = Instance.new("TextLabel")
			visorLabel.BackgroundTransparency = 1
			visorLabel.Font = Enum.Font.Code
			visorLabel.TextSize = 14
			visorLabel.TextStrokeTransparency = 0
			visorLabel.AnchorPoint = Vector2.new(0.5, 0)
			visorLabel.Position = UDim2.new(0.5, 0, 0.62, 0)
			visorLabel.Size = UDim2.fromOffset(120, 18)
			visorLabel.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
			visorLabel.BackgroundTransparency = 0.25
			visorLabel.Parent = hitLog and hitLog.Parent or LocalPlayer:FindFirstChildOfClass("PlayerGui")
			dragOverlay(visorLabel)
		end
		local down = false
		local profile = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
		profile = profile and profile:FindFirstChild(LocalPlayer.Name)
		local inventory = profile and profile:FindFirstChild("Inventory")
		if inventory then
			for _, item in inventory:GetChildren() do
				local slot = tostring(item:GetAttribute("Slot") or "")
				if slot == "ClothingHeadware" and string.find(string.lower(item.Name), "visor", 1, true) then
					down = item:GetAttribute("VisorDown") ~= false
				end
			end
		end
		visorLabel.Visible = true
		visorLabel.Text = down and "visor on" or "visor off"
		visorLabel.TextColor3 = down and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(255, 80, 80)
	elseif visorLabel then
		visorLabel.Visible = false
	end
	if flagBool("EspMap") then
		if not espMapRunning then
			espMapRunning = true
			task.spawn(runEspMap)
		end
	end
	if flagBool("RemoveGrass_Enabled") then
		if not grassOn then
			grassOn = true
			pcall(function()
				sethiddenproperty(workspace.Terrain, "Decoration", false)
			end)
		end
	elseif grassOn then
		grassOn = false
		pcall(function()
			sethiddenproperty(workspace.Terrain, "Decoration", true)
		end)
	end
	local wantLeaves = flagBool("NoLeaves_Enabled")
	local wantTrees = flagBool("RemoveTrees")
	local foliageMode = (wantTrees and "t" or "") .. (wantLeaves and "l" or "")
	if wantLeaves or wantTrees then
		if leafMode ~= foliageMode then
			for inst, value in leafState do
				if inst.Parent and inst:IsA("BasePart") then
					inst.LocalTransparencyModifier = value
				end
			end
			table.clear(leafState)
			leafMode = foliageMode
			leafOn = false
		end
		if not leafOn then
			leafOn = true
			leafStack = { workspace }
			leafClock = 0
		end
		leafClock += dt or 0
		if not leafStack and leafClock > 4 then
			leafStack = { workspace }
			leafClock = 0
		end
		if leafStack then
			local budget = 250
			while budget > 0 and #leafStack > 0 do
				budget -= 1
				local inst = table.remove(leafStack)
				if inst and inst ~= workspace.Terrain then
					if inst:IsA("BasePart") then
						local name = string.lower(inst.Name)
						local parentName = string.lower(inst.Parent and inst.Parent.Name or "")
						local model = inst:FindFirstAncestorOfClass("Model")
						local modelName = string.lower(model and model.Name or "")
						local function has(text, word)
							return string.find(text, word, 1, true) ~= nil
						end
						local trunk = has(name, "trunk") or has(name, "bark") or has(name, "stump") or has(name, "log") or name == "wood"
						local leafWord = has(name, "leaf") or has(name, "foliage") or has(name, "canopy") or has(name, "needle") or has(name, "frond")
						local treeWord = has(name, "tree") or has(parentName, "tree") or has(modelName, "tree") or has(name, "pine") or has(parentName, "pine") or has(modelName, "pine") or has(parentName, "birch") or has(modelName, "birch") or has(parentName, "vegetation") or has(modelName, "vegetation")
						local inFoliage = has(parentName, "foliage") or has(parentName, "leaf") or has(modelName, "foliage") or has(modelName, "leaves") or has(modelName, "canopy")
						local appearance = inst:FindFirstChildOfClass("SurfaceAppearance")
						local hide = false
						if wantTrees and (treeWord or trunk or has(parentName, "trees")) then
							hide = true
						end
						if wantLeaves and not trunk and not has(name, "tree") and not has(name, "pine") then
							if leafWord or (appearance and inFoliage) then
								hide = true
							elseif appearance and treeWord then
								local parent = inst.Parent
								if parent then
									for _, sibling in parent:GetChildren() do
										if sibling ~= inst and sibling:IsA("BasePart") then
											local siblingName = string.lower(sibling.Name)
											if string.find(siblingName, "trunk", 1, true) or string.find(siblingName, "bark", 1, true) or string.find(siblingName, "wood", 1, true) or not sibling:FindFirstChildOfClass("SurfaceAppearance") then
												hide = true
												break
											end
										end
									end
								end
							end
						end
						if hide and leafState[inst] == nil then
							leafState[inst] = inst.LocalTransparencyModifier
							inst.LocalTransparencyModifier = 1
						elseif hide then
							inst.LocalTransparencyModifier = 1
						end
					end
					for _, child in inst:GetChildren() do
						leafStack[#leafStack + 1] = child
					end
				end
			end
			if #leafStack == 0 then
				leafStack = nil
			end
		end
		for inst in leafState do
			if inst.Parent then
				inst.LocalTransparencyModifier = 1
			end
		end
	elseif leafOn then
		leafOn = false
		leafStack = nil
		for inst, value in leafState do
			if inst.Parent and inst:IsA("BasePart") then
				inst.LocalTransparencyModifier = value
			end
		end
		table.clear(leafState)
	end
end)

