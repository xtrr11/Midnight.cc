function quickBosses()
	local t = {}
	
	local function consider(Object)
		if typeof(Object) ~= "Instance" or ownedCharacter(Object) then return end
		if isWhisper(Object) then
			t.Whisper = Object
			
			return
		end
		if not Object:IsA("Model") and not Object:IsA("BasePart") and not Object:IsA("Folder") then return end
		local Humanoid = Object:FindFirstChildOfClass("Humanoid")
		
		if isEscort(Object, Humanoid and Humanoid.DisplayName) then return end
		local BossLabelResult = bossLabel(Object.Name)
		
		if not BossLabelResult and Humanoid then
			BossLabelResult = bossLabel(Humanoid.DisplayName)
		end
		if not BossLabelResult then
			local BossNameAttribute = Object:GetAttribute("BossName") or Object:GetAttribute("NPCName")
			
			if type(BossNameAttribute) == "string" then
				BossLabelResult = bossLabel(BossNameAttribute)
			end
		end
		if not BossLabelResult then return end
		if not Humanoid or Humanoid.Health > 0 then
			local Entry = t[BossLabelResult]
			local IsNotInstance = typeof(Entry) ~= "Instance"
			
			if not IsNotInstance and Humanoid then
				local Humanoid1 = Entry:FindFirstChildOfClass("Humanoid")
				IsNotInstance = (Humanoid1 and Humanoid1.MaxHealth or 0) < Humanoid.MaxHealth or string.lower(Object.Name) == string.lower(BossLabelResult) and string.lower(Entry.Name) ~= string.lower(BossLabelResult)
			end
			if IsNotInstance then
				t[BossLabelResult] = Object
				
				return
			end
		elseif t[BossLabelResult] == nil then
			t[BossLabelResult] = false
		end
	end
	
	local function considerNpc(Object)
		if Object:IsA("Model") then
			consider(Object)
			
			return
		end
		if Object:IsA("Folder") then
			for _, Model in Object:GetChildren() do
				if Model:IsA("Model") then
					consider(Model)
				end
			end
		end
	end
	
	local AiZones = workspace:FindFirstChild("AiZones")
	
	if AiZones then
		for _, Model in AiZones:GetChildren() do
			considerNpc(Model)
			
			if not Model:IsA("Model") then
				for _, child in Model:GetChildren() do
					considerNpc(child)
				end
			end
		end
	end
	for _, Model1 in workspace:GetChildren() do
		if Model1:IsA("Model") then
			consider(Model1)
		end
	end
	return t
end

function instancePoint(Object)
	if typeof(Object) ~= "Instance" then
