	if not flagBool("SA_Snapline") or not targeting then
		snapLine.Visible = false
		return
	end
	local screen, onScreen = camera:WorldToViewportPoint(silentPart.Position)
	if not onScreen then
		snapLine.Visible = false
		return
	end
	local origin = Library.Flags["SA_SnapOrigin"]
	if type(origin) == "table" then
		origin = origin.Name or origin[1]
	end
	local from = camera.ViewportSize * 0.5
	if origin == "Mouse" then
		from = game:GetService("UserInputService"):GetMouseLocation()
	elseif origin == "Barrel" then
		from = barrelScreen(camera) or from
	end
	snapLine.Visible = true
	snapLine.From = from
	snapLine.To = Vector2.new(screen.X, screen.Y)
	snapLine.Color = flagColor("SA_SnapColor", Color3.fromRGB(255, 255, 255))
	snapLine.Thickness = math.clamp(flagNum("SA_SnapThick", 2), 1, 6)
end

function drawFov(camera)
	ensureFovDrawings()
	local show = aimOn() and Library.Flags["SA_FovCircle"] ~= false and camera
	local shape = fovShape()
	local center = camera and camera.ViewportSize * 0.5 or Vector2.new()
	local radius = silentRadius()
	local color1 = flagColor("SA_FovColor", Color3.fromRGB(255, 255, 255))
	local color2 = flagColor("SA_FovColor2", Color3.fromRGB(255, 255, 255))
	if fovCircle2 then
		fovCircle2.Visible = show and shape ~= "Star"
		fovCircle2.Position = center
		fovCircle2.Radius = radius
		fovCircle2.Color = color2
		fovCircle2.Thickness = 3
	end
	if fovCircle then
		fovCircle.Visible = show and shape ~= "Star"
		fovCircle.Position = center
		fovCircle.Radius = radius
		fovCircle.Color = color1
		fovCircle.Thickness = 1.5
	end
	if fovStar then
		local starOn = show and shape == "Star"
		local spin = 0
		if flagBool("SA_FovSpin") then
			spin = os.clock() * flagNum("SA_FovSpinSpeed", 6)
		end
		local function point(angle)
			return Vector2.new(center.X + math.cos(angle) * radius, center.Y + math.sin(angle) * radius)
		end
		local up = { -math.pi / 2 + spin, math.pi / 6 + spin, math.pi * 5 / 6 + spin }
		local down = { math.pi / 2 + spin, math.pi * 7 / 6 + spin, -math.pi / 6 + spin }
		local sets = { up, down }
		local colors = { color1, color2 }
		for tri = 1, 2 do
			local angles = sets[tri]
			for edge = 1, 3 do
				local line = fovStar[(tri - 1) * 3 + edge]
				local a = angles[edge]
				local b = angles[edge % 3 + 1]
				line.Visible = starOn
				line.From = point(a)
				line.To = point(b)
				line.Color = colors[tri]
				line.Thickness = 1.5
			end
		end
	end
end

