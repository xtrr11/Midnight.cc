						rebuildInventory(ClosestInFovResult)
					end
				end
			else
				Panel.Visible = false
				v64 = ""
			end
		else
			Panel.Visible = false
		end
	end
	if Label then
		if v0.Flags.PlayersKD == false then
			if Label.Parent then
				Label.Parent.Visible = false
			end
		else
			local _, _, ProfileStatsResult3, ProfileStatsResult4 = profileStats(LocalPlayer)
			Label.Text = string.format("kd%s\nreports %d", ProfileStatsResult3 and string.format("%.2f", ProfileStatsResult3) or "--", ProfileStatsResult4 or 0)
			
			if Label.Parent then
