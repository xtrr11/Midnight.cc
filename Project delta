function closestInFov(Camera)
	local SilentRadiusResult = silentRadius()
	local ScaledViewportSize = Camera.ViewportSize * 0.5
	local Position = Camera.CFrame.Position
	local v722 = nil
	local Infinity = math.huge
	local ScaledMagnitude = 0
	
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and player.Character then
			local Humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local Head = player.Character:FindFirstChild("Head") or rootPart(player.Character)
			
			if Humanoid and Humanoid.Health > 0 and Head then
				local ViewportPosition, OnScreen = Camera:WorldToViewportPoint(Head.Position)
				
				if OnScreen then
					local Distance = (Vector2.new(ViewportPosition.X, ViewportPosition.Y) - ScaledViewportSize).Magnitude
					
					if Distance <= SilentRadiusResult and Distance < Infinity then
						local RootPartResult = rootPart(player.Character)
						v722 = player
						Infinity = Distance
						ScaledMagnitude = RootPartResult and (RootPartResult.Position - Position).Magnitude * 0.28 or 0
					end
				end
			end
		end
	end
	return v722, ScaledMagnitude
end

function closestInvTarget(Camera)
	local ClosestInFovResult, ClosestInFovResult2 = closestInFov(Camera)
	local Player = ClosestInFovResult
	local Infinity = math.huge
	local ClosestInFovResult2_1 = ClosestInFovResult2 or 0
	local Flag = false
	local ScaledViewportSize = Camera.ViewportSize * 0.5
	local SilentRadiusResult = silentRadius()
	
	if ClosestInFovResult and ClosestInFovResult.Character then
		local Head = ClosestInFovResult.Character:FindFirstChild("Head") or rootPart(ClosestInFovResult.Character)
		
		if Head then
			local ViewportPoint = Camera:WorldToViewportPoint(Head.Position)
			Infinity = (Vector2.new(ViewportPoint.X, ViewportPoint.Y) - ScaledViewportSize).Magnitude
		end
	end
	if not flagBool("Inv_Corpse") then
		return Player, ClosestInFovResult2_1, false
	end
	local DroppedItems = workspace:FindFirstChild("DroppedItems")
	
	if not DroppedItems then
		return Player, ClosestInFovResult2_1, false
	end
	local function considerModel(Object)
		if not Object:IsA("Model") then return end
		local Humanoid = Object:FindFirstChildOfClass("Humanoid")
		
		if Humanoid and Humanoid.Health > 0 and Players:GetPlayerFromCharacter(Object) then return end
		local Inventory = Object:FindFirstChild("Inventory") or Object:FindFirstChild("Inventory", true)
		
		if not Inventory then
			for _, child in Object:GetChildren() do
				if child:FindFirstChild("ItemProperties") or child:GetAttribute("Slot") or child:GetAttribute("SlotType") then
					Inventory = Object
					break
				end
			end
		end
		if not Inventory then return end
		local Head = Object:FindFirstChild("Head") or (Object:FindFirstChild("HumanoidRootPart") or Object:FindFirstChildWhichIsA("BasePart", true))
		
		if not Head or not Head:IsA("BasePart") then return end
		local ViewportPosition, OnScreen = Camera:WorldToViewportPoint(Head.Position)
		
		if not OnScreen then return end
		local Distance = (Vector2.new(ViewportPosition.X, ViewportPosition.Y) - ScaledViewportSize).Magnitude
		
		if Distance <= SilentRadiusResult and Distance < Infinity then
			Player = Object
			Infinity = Distance
			ClosestInFovResult2_1 = (Head.Position - Camera.CFrame.Position).Magnitude * 0.28
			Flag = true
		end
	end
	
	for _, Folder in DroppedItems:GetChildren() do
		considerModel(Folder)
		
		if Folder:IsA("Folder") then
			for _, child in Folder:GetChildren() do
				considerModel(child)
			end
		end
	end
	return Player, ClosestInFovResult2_1, Flag
end

