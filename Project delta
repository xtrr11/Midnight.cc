function asColor(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "table" and typeof(value.Color) == "Color3" then
		return value.Color
	end
	return fallback
end

function flagBool(name)
	return Library.Flags[name] == true
end

function flagNum(name, fallback)
	local value = Library.Flags[name]
	if type(value) == "number" and value == value and value > -math.huge and value < math.huge then
		return value
	end
	return fallback
end

function flagColor(name, fallback)
	return asColor(Library.Flags[name], fallback)
end

saKeyOn = false
camKeyOn = false
thirdKeyOn = false

function bindActive(modeFlag, keyFlag, toggled)
	local mode = Library.Flags[modeFlag]
	if mode == "Always" then
		return true
	end
	if mode == "Hold" then
		return keyHeld(keyFlag)
	end
	return toggled == true
end

function silentOn()
	if Library.Flags["SA_Mode"] == "Camera" or not flagBool("SA_Enabled") then
		return false
	end
	return bindActive("SA_KeyMode", "SA_Key", saKeyOn)
end

function cameraOn()
	if Library.Flags["SA_Mode"] ~= "Camera" or not flagBool("SA_Enabled") then
		return false
	end
	return bindActive("Cam_KeyMode", "Cam_Key", camKeyOn)
end

function aimOn()
	return silentOn() or cameraOn()
end

function thirdActive()
	return flagBool("ThirdPerson") and thirdKeyOn == true
end

function rowByText(text)
	local roots = {}
	pcall(function()
		if Library.Holder and typeof(Library.Holder.Instance) == "Instance" then
			roots[#roots + 1] = Library.Holder.Instance
		end
	end)
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		roots[#roots + 1] = playerGui
	end
	pcall(function()
		roots[#roots + 1] = game:GetService("CoreGui")
	end)
	for _, root in roots do
		for _, obj in root:GetDescendants() do
			if obj:IsA("TextLabel") and obj.Text == text then
				local row = obj.Parent
				if row and row:IsA("GuiObject") then
					return row
				end
			end
		end
	end
	return nil
end

function refreshAimRows()
	local cameraMode = Library.Flags["SA_Mode"] == "Camera"
	local star = Library.Flags["SA_FovShape"] == "Star"
	local smooth = rowByText("Camera Smooth")
	if smooth then
		smooth.Visible = cameraMode
	end
	local spin = rowByText("Spin Star")
	if spin then
		spin.Visible = star
	end
	local speed = rowByText("Spin Speed")
	if speed then
		speed.Visible = star
	end
end

