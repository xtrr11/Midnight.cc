		end
	end
	if flagBool("QuestESP") then
		for _, value in questPins or {} do
			if typeof(value.pos) == "Vector3" and value.title then
				rememberMap("quest:" .. value.title, value.title, flagColor("QuestColor", Color3.fromRGB(255, 214, 80)), value.pos)
			end
		end
	end
	if type(liveBosses) == "table" then
		for i, liveBoss in liveBosses do
			if typeof(liveBoss) == "Instance" then
				local InstancePointResult = instancePoint(liveBoss)
				
				if InstancePointResult then
					rememberMap("boss:" .. i, i, Color3.fromRGB(255, 70, 70), InstancePointResult)
				end
			end
		end
	end
end

