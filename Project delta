				end
				if weaponIcons and weaponIcons[player] then
					weaponIcons[player].Visible = false
				end
			else
				local Box2dResult, Box2dResult2, Box2dResult3, Box2dResult4 = box2d(Character, CurrentCamera)
				
				if not Box2dResult and RootPartResult then
					Box2dResult, Box2dResult2, Box2dResult3, Box2dResult4 = fallbackBox(CurrentCamera, RootPartResult.Position)
				end
				if Box2dResult then
					local EnsurePackResult = ensurePack(player)
					
					if EnsurePackResult then
						local PlayersBoxColor1 = flagColor("PlayersBoxColor1", Color3.fromRGB(255, 255, 255))
						drawEspBox(EnsurePackResult, Box2dResult, Box2dResult2, Box2dResult3, Box2dResult4, PlayersBoxColor1, v0.Flags.PlayersBoxStyle or "Full", PlayersBoxes)
						local DrawingFontResult = drawingFont()
						EnsurePackResult.name.Visible = PlayersNames
						EnsurePackResult.name.Text = player.Name
						EnsurePackResult.name.Size = math.clamp(flagNum("EspTextSize", 13), 8, 28)
						EnsurePackResult.name.Center = true
						EnsurePackResult.name.Font = DrawingFontResult
						EnsurePackResult.name.Color = flagColor("PlayersNameColor", Color3.fromRGB(255, 255, 255))
						EnsurePackResult.name.Outline = true
						local Box2dResultDelta = Box2dResult2 - EnsurePackResult.name.Size - 1
						EnsurePackResult.name.Position = Vector2.new(Box2dResult + Box2dResult3 * 0.5, Box2dResultDelta)
						EnsurePackResult.kd.Visible = v0.Flags.PlayersKD ~= false and type(KdOfResult) == "number"
						EnsurePackResult.kd.Text = type(KdOfResult) == "number" and string.format("%.2f kd", KdOfResult) or ""
						EnsurePackResult.kd.Color = EnsurePackResult.name.Color
						EnsurePackResult.kd.Center = false
						EnsurePackResult.kd.Size = EnsurePackResult.name.Size
						EnsurePackResult.kd.Font = DrawingFontResult
						EnsurePackResult.kd.Outline = true
						EnsurePackResult.kd.OutlineColor = Color3.new(0, 0, 0)
						EnsurePackResult.kd.Position = Vector2.new(Box2dResult + Box2dResult3 * 0.5 + #player.Name * EnsurePackResult.name.Size * 0.28 + 4, Box2dResultDelta)
						EnsurePackResult.cheat.Visible = Visible
						EnsurePackResult.cheat.Text = Visible and string.format("CHEATER %dd", AccountAge) or ""
						EnsurePackResult.cheat.Size = math.max(EnsurePackResult.name.Size - 1, 8)
						EnsurePackResult.cheat.Font = DrawingFontResult
						EnsurePackResult.cheat.Outline = true
						EnsurePackResult.cheat.OutlineColor = Color3.new(0, 0, 0)
						EnsurePackResult.cheat.Position = Vector2.new(Box2dResult + Box2dResult3 * 0.5, Box2dResultDelta - EnsurePackResult.cheat.Size - 1)
						local Y2 = Box2dResult2 + Box2dResult4 + 2
						local LeftFoot = Character:FindFirstChild("LeftFoot") or (Character:FindFirstChild("RightFoot") or (Character:FindFirstChild("Left Leg") or Character:FindFirstChild("Right Leg")))
						local PositionDelta = RootPartResult and RootPartResult.Position - Vector3.new(0, 3, 0)
						
						if LeftFoot and LeftFoot:IsA("BasePart") then
							PositionDelta = LeftFoot.Position - Vector3.new(0, LeftFoot.Size.Y * 0.5, 0)
						end
						if PositionDelta then
							local ViewportPoint = CurrentCamera:WorldToViewportPoint(PositionDelta)
							
							if ViewportPoint.Z > 0.2 and (math.abs(ViewportPoint.X - (Box2dResult + Box2dResult3 * 0.5)) < 140 and Box2dResult2 - 4 <= ViewportPoint.Y) then
