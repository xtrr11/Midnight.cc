function silentRadius()
	return math.clamp(flagNum("SA_Fov", 180), 10, 800)
end

function solveQuadratic(a, b, c)
	if a == 0 then
		return nil, nil
	end
	local discriminant = b * b - 4 * a * c
	if discriminant < 0 then
		return nil, nil
	end
	local root = math.sqrt(discriminant)
	return (-b - root) / (2 * a), (-b + root) / (2 * a)
end

function ballisticTime(direction, gravity, projectileSpeed)
	local root1, root2 = solveQuadratic(gravity:Dot(gravity) / 4, gravity:Dot(direction) - projectileSpeed * projectileSpeed, direction:Dot(direction))
	if root1 and root2 then
		if root1 > 0 and root1 < root2 then
			return math.sqrt(root1)
		elseif root2 > 0 and root2 < root1 then
			return math.sqrt(root2)
		end
	end
	return 0
end

function projectileDrop(origin, target, projectileSpeed, acceleration)
	local gravity = Vector3.yAxis * (acceleration * 2)
	local time = ballisticTime(target - origin, gravity, projectileSpeed)
	return 0.5 * gravity * time * time
end

function predictPoint(target, origin, projectileSpeed, acceleration)
	local gravity = Vector3.yAxis * (acceleration * 2)
	local time = ballisticTime(target.Position - origin, gravity, projectileSpeed)
	local velocity = target.AssemblyLinearVelocity or target.Velocity
	return target.Position + velocity * time
end

function silentVisible(origin, part, extra)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { workspace.CurrentCamera }
	if LocalPlayer.Character then
		filter[#filter + 1] = LocalPlayer.Character
	end
	if extra then
		for _, item in extra do
			if typeof(item) == "Instance" then
				filter[#filter + 1] = item
			end
		end
	end
	params.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	if not hit then
		return true
	end
	return hit.Instance:IsDescendantOf(part.Parent)
end

local penCost = {
	Wood = 2, WoodPlanks = 2, Plastic = 2, Glass = 1, Ice = 1,
	Concrete = 5, Brick = 5, Cobblestone = 5, Rock = 6, Basalt = 6,
	Metal = 8, DiamondPlate = 8, CorrodedMetal = 7, Foil = 4,
}
function canPenetrate(origin, part)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { workspace.CurrentCamera }
	if LocalPlayer.Character then
		filter[#filter + 1] = LocalPlayer.Character
	end
	params.FilterDescendantsInstances = filter
	local power = 36
	local pos = origin
	for _ = 1, 5 do
		local delta = part.Position - pos
		if delta.Magnitude < 0.4 then
			return true
		end
		local hit = workspace:Raycast(pos, delta, params)
		if not hit then
			return true
		end
		if hit.Instance:IsDescendantOf(part.Parent) then
			return true
		end
		local step = math.min(delta.Magnitude, 6)
		local back = workspace:Raycast(hit.Position + delta.Unit * step, -delta.Unit * step, params)
		local thickness = back and (back.Position - hit.Position).Magnitude or 1
		power -= (penCost[hit.Material.Name] or 4) * thickness
		if power <= 0 then
			return false
		end
		pos = hit.Position + delta.Unit * (thickness + 0.08)
	end
	return false
end

function sameClan(player)
	clanCache = clanCache or {}
	local cached = clanCache[player]
	if cached and os.clock() - cached.t < 1.5 then
		return cached.v
	end
	local function clanOf(name)
		local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
		local data = folder and folder:FindFirstChild(name)
		local journey = data and data:FindFirstChild("Journey")
		local node = journey and journey:FindFirstChild("Clan")
		local value = node and node:GetAttribute("CurrentClan")
		if value == nil or value == "" or value == "nil" then
			return nil
		end
		return tostring(value)
	end
	local mine = clanOf(LocalPlayer.Name)
	local theirs = clanOf(player.Name)
	local same = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team) or (mine ~= nil and mine == theirs)
	clanCache[player] = { t = os.clock(), v = same }
	return same
end

function considerSilent(part, camera, origin, radius, bestDist, bestPart, extra)
	if not part then
		return bestDist, bestPart
	end
	local seen = silentVisible(origin, part, extra)
	if not flagBool("SA_ForceHit") and not seen then
		if not (flagBool("SA_Autowall") and canPenetrate(origin, part)) then
			if flagBool("SA_VisibleCheck") then
				return bestDist, bestPart
			end
		end
	end
	local screen, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen then
		return bestDist, bestPart
	end
	local distance = (Vector2.new(screen.X, screen.Y) - camera.ViewportSize * 0.5).Magnitude
	if distance < bestDist then
		return distance, part
	end
	return bestDist, bestPart
end

function getSilentTarget(extra)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local origin = camera.CFrame.Position
	local bestDist = silentRadius()
	local bestPart = nil
	local hitName = Library.Flags["SA_TargetPart"]
	if type(hitName) ~= "string" then
		hitName = "Head"
	end
	local who = Library.Flags["SA_Targets"]
	if type(who) == "table" then
		who = who.Name or who[1]
	end
	if type(who) ~= "string" then
		who = "Both"
	end
	local zones = workspace:FindFirstChild("AiZones")
	if who ~= "Players" and zones then
		for _, zone in zones:GetChildren() do
			for _, character in zone:GetChildren() do
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					if hitName == "Closest" then
						for _, bone in { "Head", "UpperTorso", "HumanoidRootPart" } do
							bestDist, bestPart = considerSilent(character:FindFirstChild(bone), camera, origin, bestDist, bestDist, bestPart, extra)
						end
					else
						bestDist, bestPart = considerSilent(character:FindFirstChild(hitName), camera, origin, bestDist, bestDist, bestPart, extra)
					end
				end
			end
		end
	end
	for _, player in Players:GetPlayers() do
		if who ~= "AI" and player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local alive = humanoid and humanoid.Health > 0
			local downed = humanoid and (humanoid:GetAttribute("Downed") == true or player.Character:GetAttribute("Downed") == true)
			if alive and not (flagBool("SA_DownCheck") and downed) and not (flagBool("SA_TeamCheck") and sameClan(player)) then
				if hitName == "Closest" then
					for _, bone in { "Head", "UpperTorso", "HumanoidRootPart", "LowerTorso" } do
						bestDist, bestPart = considerSilent(player.Character:FindFirstChild(bone), camera, origin, bestDist, bestDist, bestPart, extra)
					end
				else
					bestDist, bestPart = considerSilent(player.Character:FindFirstChild(hitName), camera, origin, bestDist, bestDist, bestPart, extra)
				end
			end
		end
	end
	return bestPart
end

