end

local HttpService = game:GetService("HttpService")

function saveValue(value)
	local kind = typeof(value)
	if kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return nil
		end
		return value
	end
	if kind == "string" or kind == "boolean" then
		return value
	end
	if kind == "Color3" then
		return { Color = value:ToHex(), Alpha = 1 }
	end
	if kind == "EnumItem" then
		return value.Name
	end
	if kind == "table" then
		if value.Key then
			local key = value.Key
			if typeof(key) == "EnumItem" then
				key = key.Name
			end
			return { Key = tostring(key), Mode = value.Mode }
		end
		if value.HexValue or typeof(value.Color) == "Color3" then
			local hex = value.HexValue
			if not hex and typeof(value.Color) == "Color3" then
				hex = value.Color:ToHex()
			end
			return { Color = hex, Alpha = value.Alpha }
		end
		local copy = {}
		local any = false
		for key, item in value do
			if type(key) == "string" then
				local saved = saveValue(item)
				if saved ~= nil then
					copy[key] = saved
					any = true
				end
			end
		end
		if any then
			return copy
		end
	end
	return nil
end

function saveConfigString()
	local config = {}
	for index, value in Library.Flags do
		if type(index) == "string" and index ~= "Configs List" and index ~= "Config Name" then
			local saved = saveValue(value)
			if saved ~= nil then
				config[index] = saved
			end
		end
	end
	return HttpService:JSONEncode(config)
end

function applyConfig(contents)
	local decoded = HttpService:JSONDecode(contents)
	if type(decoded) ~= "table" then
		return
	end
	for index, value in decoded do
		local set = Library.SetFlags[index]
		if set and not (type(value) == "number" and value ~= value) then
		if type(value) == "table" and value.Key then
			local key = value.Key
			pcall(function()
				key = Enum.KeyCode[value.Key]
			end)
			pcall(set, { Key = key, Mode = value.Mode })
		elseif type(value) == "table" and value.Color then
			pcall(set, value.Color, value.Alpha)
		else
			pcall(set, value)
		end
		end
	end
end

function chosenName()
	local selected = selectedConfig or Library.Flags["Configs List"]
	if type(selected) == "table" then
		selected = selected.Name or selected[1]
	end
	if type(selected) ~= "string" or selected == "" then
		return nil
	end
	selected = configFile(selected)
	if selected:sub(-5) ~= ".json" then
		selected = selected .. ".json"
	end
	return selected
end

function typedConfigName()
	local typed = configName
	if typed == "" then
		local flag = Library.Flags["Config Name"]
		if type(flag) == "string" then
			typed = flag
		end
	end
	typed = tostring(typed or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.json$", "")
	if typed == "" or typed:find("[/\\]") then
		return nil
	end
	return typed .. ".json"
end

