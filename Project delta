function drawDamagePops(Camera)
	if type(Drawing) ~= "table" then return end
	if not damageTexts then
		damageTexts = {}
		
		for _ = 1, 16 do
			local Drawing1 = Drawing.new("Text")
			Drawing1.Visible = false
			Drawing1.Center = true
			Drawing1.Outline = true
			Drawing1.OutlineColor = Color3.new(0, 0, 0)
			Drawing1.Font = 2
			damageTexts[#damageTexts + 1] = Drawing1
		end
	end
	local Count = 0
	local ClockTime = os.clock()
	
	if hitPops then
		for i = #hitPops, 1, -1 do
			local HitPop = hitPops[i]
			local ClockTimeDelta = ClockTime - HitPop.t
			
			if ClockTimeDelta > 1.45 then
				table.remove(hitPops, i)
			else
				local ViewportPoint = Camera:WorldToViewportPoint(HitPop.pos + Vector3.new(0, ClockTimeDelta * 1.6, 0))
				
				if ViewportPoint.Z > 0 then
					local Text = HitPop.text
					local Largest = math.max(1, math.floor(#Text / 2))
					local Segment = string.sub(Text, 1, Largest)
					local Segment1 = string.sub(Text, Largest + 1)
					
					if Segment1 == "" then
						Segment1 = Segment
					end
					local ClampedValue = math.clamp((ClockTimeDelta - 0.55) / 0.7, 0, 1)
					local ScaledClampedValue = ClampedValue * 16
					local Size = if HitPop.head then 22 else 18
					local _Color3 = HitPop.head and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 255, 255)
					local Transparency = 1 - math.clamp((ClockTimeDelta - 0.95) / 0.5, 0, 1)
					local _Vector2 = Vector2.new(ViewportPoint.X - 10, ViewportPoint.Y - 22)
					
					for _, value in ClampedValue <= 0 and { { Text, _Vector2 } } or {
						{
							Segment,
							_Vector2 + Vector2.new(-ScaledClampedValue, ClampedValue * 8)
						},
						{
							Segment1,
							_Vector2 + Vector2.new(ScaledClampedValue + 6, ClampedValue * -4)
						}
					} do
						Count += 1
						local DamageText = damageTexts[Count]
						
						if DamageText then
							DamageText.Visible = true
							DamageText.Text = value[1]
							DamageText.Position = value[2]
							DamageText.Size = Size
							DamageText.Color = _Color3
							DamageText.Transparency = Transparency
						end
					end
				end
			end
		end
	end
	for i1 = Count + 1, #damageTexts do
		damageTexts[i1].Visible = false
	end
end

