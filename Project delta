function muteOneSprint(AnimationTrack, p364)
	local Animation = AnimationTrack.Animation
	local Lowered = string.lower(tostring(AnimationTrack.Name or "") .. " " .. tostring(Animation and Animation.Name or "") .. " " .. tostring(Animation and Animation.Parent and Animation.Parent.Name or ""))
	local AnimationId = Animation and Animation.AnimationId
	local SprintId = sprintIds and (AnimationId and sprintIds[AnimationId])
	
	if not SprintId then
		if string.find(Lowered, "sprint", 1, true) then
			SprintId = true
		elseif p364 and string.find(Lowered, "run", 1, true) and not string.find(Lowered, "walk", 1, true) and not string.find(Lowered, "idle", 1, true) then
			SprintId = true
		end
	end
	if SprintId then
		pcall(function()
			AnimationTrack:AdjustWeight(0, 0)
			AnimationTrack:AdjustSpeed(0)
		end)
		
		return
	end
end

function watchSprintAnimator(p365)
