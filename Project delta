function harvestMapPoints()
	local noCollision = workspace:FindFirstChild("NoCollision")
	local exits = noCollision and noCollision:FindFirstChild("ExitLocations")
	if exits then
		local function walk(inst)
			local pos = nil
			if inst:IsA("BasePart") then
				pos = inst.Position
			elseif inst:IsA("Model") or inst:IsA("Folder") then
				pos = instancePoint(inst)
			end
			if typeof(pos) == "Vector3" and (inst:IsA("BasePart") or inst:IsA("Model")) then
				local key = string.format("exfil:%d:%d", math.floor(pos.X / 40), math.floor(pos.Z / 40))
				rememberMap(key, inst.Name, Color3.fromRGB(80, 220, 140), pos)
				if inst:IsA("Model") then
					return
				end
			end
			if not inst:IsA("BasePart") then
				for _, child in inst:GetChildren() do
					walk(child)
				end
			end
		end
		for _, inst in exits:GetChildren() do
			walk(inst)
		end
	end
	if flagBool("QuestESP") then
		for _, pin in questPins or {} do
			if typeof(pin.pos) == "Vector3" and pin.title then
				rememberMap("quest:" .. pin.title, pin.title, flagColor("QuestColor", Color3.fromRGB(255, 214, 80)), pin.pos)
			end
		end
	end
	if type(liveBosses) == "table" then
		for label, model in liveBosses do
			if typeof(model) == "Instance" then
				local pos = instancePoint(model)
				if pos then
					rememberMap("boss:" .. label, label, Color3.fromRGB(255, 70, 70), pos)
				end
			end
		end
	end
end

