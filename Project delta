function refreshWorld()
	local wantItems = flagBool("ItemESPEnabled")
	local wantMarks = flagBool("TraderESP") or flagBool("VehicleESP") or flagBool("MineESP") or flagBool("DropESP") or flagBool("CorpseESPEnabled")
	if not (wantItems or wantMarks) then
		if not flagBool("AIESPEnabled") and not flagBool("BossESPEnabled") then
			worldCache = {}
		end
		scanStack = nil
		return liveBosses
	end
	if not scanStack then
		if worldScanDone and os.clock() - worldScanDone < 5 then
			return liveBosses
		end
		scanStack = { workspace:FindFirstChild("DroppedItems") or workspace, workspace }
		scanFound = {}
		scanBosses = {}
	end
	local budget = 120
	while budget > 0 and #scanStack > 0 do
		budget -= 1
		local inst = table.remove(scanStack)
		if inst and inst:IsA("Model") and inst ~= workspace and not ownedCharacter(inst) then
			local humanoid = inst:FindFirstChildOfClass("Humanoid")
			local label = bossLabel(inst.Name)
			if not label and humanoid then
				label = bossLabel(humanoid.DisplayName)
			end
			if label and isEscort(inst, humanoid and humanoid.DisplayName) then
				label = nil
			end
			if label and (humanoid or label == "Mi-24" or label == "BTR-80") then
				if not scanBosses[label] then
					scanBosses[label] = inst
					liveBosses[label] = inst
					scanFound[#scanFound + 1] = { model = inst, kind = "boss", label = label, humanoid = humanoid }
				end
			elseif flagBool("CorpseESPEnabled") and humanoid and inst:FindFirstChild("UpperTorso") and workspace:FindFirstChild("DroppedItems") and inst:IsDescendantOf(workspace.DroppedItems) then
				scanFound[#scanFound + 1] = { model = inst, kind = "corpse", label = inst.Name .. "'s corpse" }
			elseif markKind(inst) then
				scanFound[#scanFound + 1] = markKind(inst)
			elseif flagBool("CorpsesEnabled") and humanoid and humanoid.Health <= 0 then
				scanFound[#scanFound + 1] = { model = inst, kind = "item", label = inst.Name .. "'s corpse", cat = "Corpses" }
			elseif wantItems and not humanoid then
				local pretty = worldName(inst)
				local lower = string.lower(pretty .. " " .. inst.Name)
				local cat = nil
				local props = inst:FindFirstChild("ItemProperties") or inst:FindFirstChild("ItemRoot")
				if flagBool("WeaponsEnabled") and (inst:FindFirstChild("ItemRoot") or inst:FindFirstChild("SettingsModule")) then
					cat = "Weapons"
				elseif flagBool("CorpsesEnabled") and (string.find(lower, "corpse", 1, true) or string.find(lower, "body", 1, true)) then
					cat = "Corpses"
				elseif flagBool("AmmoEnabled") and string.find(lower, "ammo", 1, true) then
					cat = "Ammo"
				elseif ITEM_CATS then
					for _, name in ITEM_CATS do
						if name ~= "Weapons" and name ~= "Ammo" and name ~= "Corpses" and name ~= "Other Items" and flagBool(name .. "Enabled") and string.find(lower, string.lower(name), 1, true) then
							cat = name
							break
						end
					end
				end
				if not cat and props and pretty ~= "Item" and pretty ~= "Model" and pretty ~= "Handle" then
					cat = "Other Items"
				end
				if cat then
					scanFound[#scanFound + 1] = { model = inst, kind = "item", label = pretty, cat = cat }
				end
			end
		end
		if inst and not inst:IsA("Terrain") and not (inst:IsA("Model") and ownedCharacter(inst)) then
			for _, child in inst:GetChildren() do
				scanStack[#scanStack + 1] = child
			end
		end
	end
	if #scanStack == 0 then
		worldCache = scanFound
		scanStack = nil
		worldScanDone = os.clock()
	end
	return liveBosses
end

