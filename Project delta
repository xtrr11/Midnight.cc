function visorOf(player)
	stateCache = stateCache or {}
	local key = "v:" .. player.Name
	local cached = stateCache[key]
	if cached and os.clock() - cached.t < 1 then
		return cached.v
	end
	local value = nil
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local profile = folder and (folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId)))
	if profile then
		for _, item in profile:GetDescendants() do
			local down = item:GetAttribute("VisorDown")
			if down ~= nil then
				value = down ~= false
				break
			end
		end
	end
	stateCache[key] = { t = os.clock(), v = value }
	return value
end

function aimingOf(player, character)
	stateCache = stateCache or {}
	local key = "a:" .. player.Name
	local cached = stateCache[key]
	if cached and os.clock() - cached.t < 0.7 then
		return cached.v
	end
	local value = nil
	local function read(inst)
		if not inst then
			return nil
		end
		for _, attribute in { "Aiming", "IsAiming", "ADS", "Adsing" } do
			local found = inst:GetAttribute(attribute)
			if type(found) == "boolean" then
				return found
			end
		end
		return nil
	end
	value = read(character) or read(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	value = value ~= nil and value or read(humanoid)
	local gun = character and heldGun(character)
	value = value ~= nil and value or read(gun)
	if value == nil and humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			value = false
			for _, track in animator:GetPlayingAnimationTracks() do
				local blob = string.lower(track.Name)
				if track.IsPlaying and track.WeightCurrent > 0.35 and (string.find(blob, "aim", 1, true) or string.find(blob, "ads", 1, true)) then
					value = true
					break
				end
			end
		end
	end
	stateCache[key] = { t = os.clock(), v = value }
	return value
end

