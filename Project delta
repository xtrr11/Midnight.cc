function noteHit(model, partName)
	if os.clock() - (lastShot or 0) > 0.4 then
		return
	end
	if not model or model == LocalPlayer.Character then
		return
	end
	if not model:FindFirstChildOfClass("Humanoid") then
		return
	end
	if Players:GetPlayerFromCharacter(model) == LocalPlayer then
		return
	end
	local now = os.clock()
	hitDebounce = hitDebounce or {}
	if hitDebounce[model] and now - hitDebounce[model] < 0.45 then
		return
	end
	hitDebounce[model] = now
	local where = partName or "Body"
	local meters = 0
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	local camera = workspace.CurrentCamera
	if root and camera then
		meters = math.floor((root.Position - camera.CFrame.Position).Magnitude * 0.28 + 0.5)
	end
	if flagBool("Hit_Enabled") then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local picked = Library.Flags["Hit_Sound"]
		local pitch = flagNum("Hit_Pitch", 10) / 10
		if humanoid and humanoid.Health <= 0 then
			picked = Library.Flags["Hit_Kill"] or picked
		elseif string.lower(where) == "head" then
			picked = Library.Flags["Hit_Head"] or picked
			pitch = pitch * 1.15
		else
			picked = Library.Flags["Hit_Body"] or picked
		end
		if type(picked) == "table" then
			picked = picked.Name or picked[1]
		end
		playShotSound(HIT_IDS[picked] or HIT_IDS.Neverlose, flagNum("Hit_Volume", 100) / 100, pitch)
	end
	if flagBool("Hit_Notify") then
		pushHit(string.format("%s   %s   %dm", model.Name, where, meters))
	end
	if flagBool("Hit_Marker") then
		hitMarkerUntil = os.clock() + 0.12
	end
	if flagBool("Hit_Flash") then
		hitFlashUntil = os.clock() + 0.08
	end
	if flagBool("Hit_Impact") and root then
		showImpact(root.Position)
	end
end

function syncInstantAmmo()
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("AmmoTypes")
	if not folder then
		return
	end
	ammoBase = ammoBase or {}
	local instant = Library.Flags["SA_NoDrag"] == true
	for _, ammo in folder:GetChildren() do
		local velocity = ammo:GetAttribute("MuzzleVelocity")
		local drop = ammo:GetAttribute("ProjectileDrop")
		local drag = ammo:GetAttribute("Drag")
		if not ammoBase[ammo] then
			ammoBase[ammo] = {
				Drag = drag,
				MuzzleVelocity = type(velocity) == "number" and velocity < 5000 and velocity or nil,
				ProjectileDrop = drop,
			}
		end
		local saved = ammoBase[ammo]
		if type(saved.MuzzleVelocity) == "number" and type(velocity) == "number" and velocity >= 5000 then
			ammo:SetAttribute("MuzzleVelocity", saved.MuzzleVelocity)
		end
		if saved.ProjectileDrop ~= nil and ammo:GetAttribute("ProjectileDrop") == 0 and saved.ProjectileDrop ~= 0 then
			ammo:SetAttribute("ProjectileDrop", saved.ProjectileDrop)
		end
		if instant then
			ammo:SetAttribute("Drag", 0)
		elseif saved.Drag ~= nil then
			ammo:SetAttribute("Drag", saved.Drag)
		end
	end
end

function noteAimMotion(part)
	if typeof(part) ~= "Instance" then
		return Vector3.zero
	end
	aimMotion = aimMotion or {}
	local now = os.clock()
	local prev = aimMotion[part]
	local velocity = part.AssemblyLinearVelocity
	if typeof(velocity) ~= "Vector3" then
		velocity = Vector3.zero
	end
	if prev then
		local dt = now - prev.t
		if dt > 0.01 and dt < 0.35 then
			local sampled = (part.Position - prev.pos) / dt
			if sampled.Magnitude > velocity.Magnitude and sampled.Magnitude < 90 then
				velocity = sampled
			end
		elseif prev.vel and velocity.Magnitude < 1 then
			velocity = prev.vel
		end
	end
	aimMotion[part] = { pos = part.Position, t = now, vel = velocity }
	return velocity
end

task.spawn(function()
	local ok, bullet = pcall(require, game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("FPS"):WaitForChild("Bullet"))
	if not ok or type(bullet) ~= "table" or type(bullet.CreateBullet) ~= "function" then
		Library:Notification("Bullet module not ready", 4, Color3.fromRGB(255, 80, 80))
		return
	end
	if type(hookfunction) ~= "function" then
		Library:Notification("Silent aim needs hookfunction", 4, Color3.fromRGB(255, 80, 80))
		return
	end
	local function solveQuadratic(a, b, c)
		local discriminant = b * b - 4 * a * c
		if discriminant < 0 then
			return nil, nil
		end
		local root = math.sqrt(discriminant)
		return (-b - root) / (2 * a), (-b + root) / (2 * a)
	end
	local function flightTime(direction, gravity, speed)
		local root1, root2 = solveQuadratic(gravity:Dot(gravity) / 4, gravity:Dot(direction) - speed * speed, direction:Dot(direction))
		if root1 and root2 then
			if root1 > 0 and root1 < root2 then
				return math.sqrt(root1)
			elseif root2 > 0 and root2 < root1 then
				return math.sqrt(root2)
			end
		end
		return 0
	end
	local function projectileDrop(origin, target, speed, acceleration)
		local gravity = Vector3.yAxis * (math.abs(acceleration) * 2)
		local time = flightTime(target - origin, gravity, speed)
		local drop = 0.5 * gravity * time * time
		local distance = (target - origin).Magnitude
		if drop.Y < distance * 0.012 then
			local fallback = distance / math.max(speed, 400)
			drop = Vector3.new(0, math.max(drop.Y, 0.5 * 90 * fallback * fallback), 0)
		end
		return drop
	end
	local function predictPoint(target, origin, speed, acceleration)
		local gravity = Vector3.yAxis * (math.abs(acceleration) * 2)
		local time = flightTime(target.Position - origin, gravity, speed)
		local velocity = noteAimMotion(target)
		velocity = Vector3.new(velocity.X, 0, velocity.Z)
		if velocity.Magnitude < 8 then
			velocity = Vector3.zero
		end
		return target.Position + velocity * time
	end
	local oldBullet
	oldBullet = hookfunction(bullet.CreateBullet, function(a1, a2, a3, a4, aimPart, a6, ammoType, a8, a9)
		if not silentOn() or typeof(aimPart) ~= "Instance" then
			return oldBullet(a1, a2, a3, a4, aimPart, a6, ammoType, a8, a9)
		end
		local chance = flagNum("SA_Hitchance", 100)
		if chance < 100 and math.random(1, 100) > chance then
			return oldBullet(a1, a2, a3, a4, aimPart, a6, ammoType, a8, a9)
		end
		local target = getSilentTarget({ a2, a3, a4, aimPart })
		if not target then
			return oldBullet(a1, a2, a3, a4, aimPart, a6, ammoType, a8, a9)
		end
		local ammoFolder = game:GetService("ReplicatedStorage"):FindFirstChild("AmmoTypes")
		local bulletStats = nil
		if ammoFolder then
			local seen = { ammoType, a6, a8, a9 }
			for _, value in seen do
				if typeof(value) == "Instance" and value:GetAttribute("MuzzleVelocity") ~= nil then
					bulletStats = value
					break
				end
				local name = typeof(value) == "Instance" and value.Name or (type(value) == "string" and value or nil)
				local found = name and ammoFolder:FindFirstChild(name)
				if found then
					bulletStats = found
					break
				end
			end
		end
		local instant = Library.Flags["SA_NoDrag"] == true
		local acceleration = 0
		local speed = 0
		if bulletStats then
			local saved = ammoBase and ammoBase[bulletStats]
			local liveSpeed = bulletStats:GetAttribute("MuzzleVelocity")
			if type(liveSpeed) == "number" and liveSpeed > 1 and liveSpeed < 5000 then
				speed = liveSpeed
			elseif saved and type(saved.MuzzleVelocity) == "number" then
				speed = saved.MuzzleVelocity
			end
			if saved and type(saved.ProjectileDrop) == "number" and math.abs(saved.ProjectileDrop) > 0.05 then
				acceleration = math.abs(saved.ProjectileDrop)
			else
				local liveDrop = bulletStats:GetAttribute("ProjectileDrop")
				acceleration = type(liveDrop) == "number" and math.abs(liveDrop) or 0
			end
			if acceleration < 1 then
				acceleration = 45
			end
			bulletStats:SetAttribute("Drag", 0)
		end
		if speed < 1 then
			speed = 700
		end
		if acceleration < 1 then
			acceleration = 45
		end
		if instant then
			shotInstant = os.clock()
		end
		local origin = aimPart.Position
		local targetPosition = target.Position
		if Library.Flags["SA_Prediction"] ~= false and speed > 1 then
			targetPosition = predictPoint(target, origin, speed, acceleration)
		end
		local drop = Vector3.zero
		if speed > 0 then
			drop = projectileDrop(origin, targetPosition, speed, acceleration)
		end
		if (targetPosition + drop - origin).Magnitude < 0.05 then
			return oldBullet(a1, a2, a3, a4, aimPart, a6, ammoType, a8, a9)
		end
		silentPart = target
		if onLocalShot then
			onLocalShot(aimPart)
		end
		return oldBullet(a1, a2, a3, a4, {
			CFrame = CFrame.new(origin, targetPosition + drop),
		}, a6, ammoType, a8, a9)
	end)
end)

