function profileStats(Player)
	statCache = statCache or {}
	local Stat = statCache[Player]
	
	if Stat and os.clock() - Stat.t < 2 then
		return Stat.kills, Stat.deaths, Stat.kd, Stat.reports, Stat.hours
	end
	local Players = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local Name = Players and (Players:FindFirstChild(Player.Name) or Players:FindFirstChild(tostring(Player.UserId)))
	local Number = 0
	local Number1 = 0
	local Count = 0
	local Hours = nil
	local Status = Name and Name:FindFirstChild("Status")
	local Journey = Status and Status:FindFirstChild("Journey")
	local WipeStatistics = Journey and Journey:FindFirstChild("WipeStatistics")
	
	if WipeStatistics then
		Number = tonumber(WipeStatistics:GetAttribute("Kills")) or 0
		Number1 = tonumber(WipeStatistics:GetAttribute("Deaths")) or 0
	end
	local function absorbReports(Value)
		if typeof(Value) ~= "Instance" then return end
		local Named = string.lower(Value.Name) == "reports"
		
		for i, attribute in Value:GetAttributes() do
			local Number = nil
			
			if type(attribute) == "number" then
				Number = attribute
			elseif type(attribute) == "string" then
				Number = tonumber(attribute)
			end
			if Number and (Named or string.find(string.lower(i), "report", 1, true)) then
				Count += Number
			end
		end
		if Value:IsA("ValueBase") then
			local Number = tonumber(Value.Value)
			
			if Number and (Named or string.find(string.lower(Value.Name), "report", 1, true)) then
				Count += Number
			end
		end
	end
	
	local function takeReports(Node)
		if typeof(Node) ~= "Instance" then return end
		local Before = Count
		
		absorbReports(Node)
		if Count ~= Before then return end
		for _, child in Node:GetChildren() do
			if child:IsA("ValueBase") then
				local Number = tonumber(child.Value)
				
				if Number then
					Count += Number
				end
			else
				absorbReports(child)
			end
		end
		if Count == Before then
			local Kids = #Node:GetChildren()
			
			if Kids > 0 then
				Count += Kids
			end
		end
	end
	
	local UAC = Status and Status:FindFirstChild("UAC")
	local Reports = UAC and UAC:FindFirstChild("Reports")
	
	if not Reports and Name then
		local UAC1 = Name:FindFirstChild("UAC")
		
		Reports = (UAC1 and UAC1:FindFirstChild("Reports")) or Name:FindFirstChild("Reports") or (Status and Status:FindFirstChild("Reports"))
	end
	if Reports then
		takeReports(Reports)
	end
	absorbReports(WipeStatistics)
	absorbReports(Journey)
	absorbReports(UAC)
	absorbReports(Status)
	absorbReports(Name)
	absorbReports(Player)
	local function consider(Name, Text)
		local Lowered = string.lower(tostring(Name))
		
		if string.find(Lowered, "kill", 1, true) or string.find(Lowered, "death", 1, true) or string.find(Lowered, "report", 1, true) then return end
		local Number = nil
		
		if type(Text) == "number" then
			Number = Text
		elseif type(Text) == "string" then
			Number = tonumber(string.match(Text, "%d+"))
		end
		if not Number or Number < 0 or Number > 20000000 then return end
		if not string.find(Lowered, "play", 1, true) and not string.find(Lowered, "hour", 1, true) and not string.find(Lowered, "time", 1, true) and not string.find(Lowered, "minute", 1, true) and not string.find(Lowered, "online", 1, true) and not string.find(Lowered, "session", 1, true) then return end
		local Number1 = Number
		
		if string.find(Lowered, "minute", 1, true) then
			Number1 = Number / 60
		elseif string.find(Lowered, "second", 1, true) or Number > 5000 then
			Number1 = Number / 3600
		end
		if not Hours or Hours < Number1 then
			Hours = Number1
		end
	end
	
	local function readHours(Value)
		if not Value then return end
		for i, attribute in Value:GetAttributes() do
			consider(i, attribute)
		end
		if Value:IsA("ValueBase") then
			consider(Value.Name, Value.Value)
		end
	end
	
	readHours(WipeStatistics)
	readHours(Journey)
	readHours(Status)
	readHours(Name)
	readHours(Player)
	local NumberRatio = Number1 > 0 and Number / Number1 or Number
	statCache[Player] = {
		t = os.clock(),
		kills = Number,
		deaths = Number1,
		kd = NumberRatio,
		reports = Count,
		hours = Hours
	}
	
	return Number, Number1, NumberRatio, Count, Hours
end

