local HttpService = game:GetService("HttpService")

function saveValue(Infinity)
	local ValueType = typeof(Infinity)
	
	if ValueType == "number" then
		return if Infinity == Infinity and Infinity ~= math.huge and Infinity ~= -math.huge then Infinity else nil
	end
	if ValueType == "string" or ValueType == "boolean" then
		return Infinity
	end
	if ValueType == "Color3" then
		return { Color = Infinity:ToHex(), Alpha = 1 }
	end
	if ValueType == "EnumItem" then
		return Infinity.Name
	end
	if ValueType == "table" then
		if Infinity.Key then
			local Key = Infinity.Key
			
			if typeof(Key) == "EnumItem" then
				Key = Key.Name
			end
			return { Key = tostring(Key), Mode = Infinity.Mode }
		elseif Infinity.HexValue or typeof(Infinity.Color) == "Color3" then
			local HexValue = Infinity.HexValue
			
			if not HexValue and typeof(Infinity.Color) == "Color3" then
				HexValue = Infinity.Color:ToHex()
			end
			return { Color = HexValue, Alpha = Infinity.Alpha }
		else
			local SaveValueResults = {}
			local Flag = false
			
			for i, value in Infinity do
				if type(i) == "string" then
					local SaveValueResult = saveValue(value)
					
					if SaveValueResult ~= nil then
						SaveValueResults[i] = SaveValueResult
						Flag = true
					end
				end
			end
			if Flag then
				return SaveValueResults
			end
		end
	end
	return nil
end

function saveConfigString()
	local SaveValueResults = {}
	
	for i, flag in v0.Flags do
		if type(i) == "string" and i ~= "Configs List" and i ~= "Config Name" then
			local SaveValueResult = saveValue(flag)
			
			if SaveValueResult ~= nil then
				SaveValueResults[i] = SaveValueResult
			end
		end
	end
	return HttpService:JSONEncode(SaveValueResults)
end

function applyConfig(Input)
	local Data = HttpService:JSONDecode(Input)
	
	if type(Data) ~= "table" then return end
	for i, entry in Data do
		local SetFlag = v0.SetFlags[i]
		
		if SetFlag and (type(entry) ~= "number" or entry == entry) then
			if type(entry) == "table" and entry.Key then
				local Key = entry.Key
				pcall(function()
					Key = Enum.KeyCode[entry.Key]
				end)
				pcall(SetFlag, { Key = Key, Mode = entry.Mode })
			else
				local Key = type
				Key = Key(entry)
				
				if Key == "table" then
					Key = entry.Color
					
					if Key then
						Key = pcall
						Key(SetFlag, entry.Color, entry.Alpha)
						continue
					end
				end
				Key = pcall
				Key(SetFlag, entry)
			end
		end
	end
