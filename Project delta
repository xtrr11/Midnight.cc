function iconOf(entry)
	local function read(inst)
		if not inst then
			return nil
		end
		for _, key in { "Icon", "Image", "Thumbnail", "ImageId", "IconId" } do
			local value = inst:GetAttribute(key)
			if type(value) == "number" and value > 0 then
				return "rbxassetid://" .. tostring(math.floor(value))
			end
			if type(value) == "string" and value ~= "" then
				if string.find(value, "rbxasset", 1, true) or string.find(value, "rbxthumb", 1, true) then
					return value
				end
				local id = tonumber(value)
				if id and id > 0 then
					return "rbxassetid://" .. value
				end
			end
		end
		for _, child in inst:GetChildren() do
			if child:IsA("ImageLabel") and child.Image ~= "" then
				return child.Image
			end
			if child:IsA("Decal") and child.Texture ~= "" then
				return child.Texture
			end
		end
		return nil
	end
	return read(entry) or read(entry:FindFirstChild("ItemProperties"))
end

function templateFor(name)
	if templateCache[name] then
		return templateCache[name]
	end
	local replicated = game:GetService("ReplicatedStorage")
	local found = false
	for _, rootName in { "ItemsList", "RangedWeapons", "MeleeWeapons", "Melee", "Clothing", "Armor", "Gear", "Items", "HandModels", "WorldModels", "Medical", "Consumables", "Attachments", "Throwables", "Misc" } do
		local folder = replicated:FindFirstChild(rootName)
		if folder then
			local hit = folder:FindFirstChild(name) or folder:FindFirstChild(name, true)
			if hit then
				found = hit
				break
			end
		end
	end
	if found then
		templateCache[name] = found
	end
	return found or nil
end

function frameModel(viewport, source)
	local ok = pcall(function()
		local clone = source:Clone()
		for _, object in clone:GetDescendants() do
			if object:IsA("LuaSourceContainer") or object:IsA("Sound") or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
				object:Destroy()
			end
		end
		local model = Instance.new("Model")
		if clone:IsA("Model") then
			model:Destroy()
			model = clone
		else
			clone.Parent = model
		end
		local parts = {}
		for _, object in model:GetDescendants() do
			if object:IsA("BasePart") then
				object.Anchored = true
				parts[#parts + 1] = object
			end
		end
		if clone:IsA("BasePart") then
			clone.Anchored = true
			parts[#parts + 1] = clone
		end
		if #parts == 0 then
			model:Destroy()
			error("no view")
		end
		if #parts > 70 then
			local meshes = {}
			for _, part in parts do
				if part:IsA("MeshPart") then
					meshes[#meshes + 1] = part
				end
			end
			if #meshes > 0 then
				parts = meshes
			end
		end
		model.Parent = viewport
		local minV = Vector3.new(math.huge, math.huge, math.huge)
		local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
		local corners = { Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1), Vector3.new(1, -1, -1), Vector3.new(1, -1, 1), Vector3.new(1, 1, -1), Vector3.new(1, 1, 1) }
		for _, part in parts do
			local half = part.Size * 0.5
			for _, corner in corners do
				local point = part.CFrame:PointToWorldSpace(half * corner)
				minV = Vector3.new(math.min(minV.X, point.X), math.min(minV.Y, point.Y), math.min(minV.Z, point.Z))
				maxV = Vector3.new(math.max(maxV.X, point.X), math.max(maxV.Y, point.Y), math.max(maxV.Z, point.Z))
			end
		end
		local center = (minV + maxV) * 0.5
		local dist = math.max((maxV - minV).Magnitude, 0.4) * 0.85
		local camera = Instance.new("Camera")
		camera.FieldOfView = 35
		camera.CFrame = CFrame.new(center + Vector3.new(dist, dist * 0.35, dist), center)
		camera.Parent = viewport
		viewport.CurrentCamera = camera
	end)
	return ok
end

