	end
	if scanFrame and scanUntil and scanUntil < os.clock() and not remotesWatched then
		scanFrame.Visible = false
	end
	if v8 then
		v8.Text = string.format("midnight.cc  |  FPS: %d  |  Ping: %d  |  Cheaters: %d  |  Staff: %s", math.floor(NewLargest + 0.5), Ping, Count, #List > 0 and table.concat(List, ", ") or "0")
