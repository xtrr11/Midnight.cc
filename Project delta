function suspicious(player, character, root)
	if player.AccountAge < 30 then
		return true
	end
	if not root then
		return false
	end
	local now = os.clock()
	local pos = root.Position
	local rec = motion[player]
	if not rec or rec.character ~= character then
		motion[player] = { character = character, pos = pos, time = now, expires = 0 }
		return false
	end
	local step = now - rec.time
	if step > 0 and step < 0.5 then
		local delta = pos - rec.pos
		local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
		if horiz > 28 and step < 0.12 then
			rec.expires = now + 2
		elseif horiz / step > 65 then
			rec.expires = now + 1.5
		end
		local head = character:FindFirstChild("Head")
		if head and (head.Position - pos).Magnitude > 10 then
			rec.expires = now + 1.5
		end
		local flat = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
		if flat > 80 then
			rec.expires = now + 1
		end
	end
	rec.pos = pos
	rec.time = now
	return rec.expires > now
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

function canSee(character, camera)
	local part = character:FindFirstChild("Head") or rootPart(character)
	if not part or not camera then
		return false
	end
	local origin = camera.CFrame.Position
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
	local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
	if not hit then
		return true
	end
	return hit.Instance:IsDescendantOf(character)
end

function partVisible(part, camera)
	local origin = camera.CFrame.Position
	local offset = part.Position - origin
	if offset.Magnitude < 0.2 then
		return true
	end
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
	local hit = workspace:Raycast(origin, offset, rayParams)
	if not hit or hit.Instance == part then
		return true
	end
	return (hit.Position - part.Position).Magnitude <= math.max(part.Size.Magnitude * 0.55, 1.1)
end

function clearPartHighlight(part)
	local highlight = part:FindFirstChild("MidnightWalls")
