function heldGun(Key)
	local ClockTime = os.clock()
	local Entry = t2[Key]
	
	if Entry and ClockTime - Entry.time < 0.6 then
		return Entry.model
	end
	local HandPartResult = handPart(Key)
	local Model = nil
	local Infinity = math.huge
	
	local function consider(Model1)
		if not Model1:IsA("Model") or isWornGear(Model1) or not Model1:FindFirstChild("ItemRoot") then return end
		local ItemRoot = Model1:FindFirstChild("ItemRoot")
		local Position = if ItemRoot:IsA("BasePart") then ItemRoot.Position else Model1:GetPivot().Position
		local Magnitude = HandPartResult and (Position - HandPartResult.Position).Magnitude or 0
		
		if Magnitude < Infinity then
			Infinity = Magnitude
			Model = Model1
		end
	end
	
	for _, descendant in Key:GetDescendants() do
		if descendant.Name == "ItemRoot" then
			local Model1 = descendant:FindFirstAncestorOfClass("Model")
			
			if Model1 and Model1 ~= Key and not isWornGear(Model1) then
				consider(Model1)
			end
		end
	end
	if Model and Infinity > 25 then
		Model = nil
	end
	t2[Key] = { time = ClockTime, model = Model }
	
	return Model
end

