	local function asDown(Text)
		if type(Text) == "boolean" then
			return Text
		end
		if type(Text) == "number" then
			return Text ~= 0
		end
		if type(Text) == "string" then
			local Lowered = string.lower(Text)
			
			if Lowered == "true" or Lowered == "down" or Lowered == "on" or Lowered == "1" then
				return true
			elseif Lowered == "false" or Lowered == "up" or Lowered == "off" or Lowered == "0" then
				return false
