local GEAR_WORDS = {
	"helmet", "mask", "visor", "nvg", "goggle", "altyn", "tor-s", "tors", "maska",
	"vest", "armor", "armour", "rig", "plate", "backpack", "balaclava", "gas",
	"ssh", "6b2", "6b4", "ratnik", "headset", "glasses", "shield", "gp-5", "gp5", "pmk",
	"respirator", "hood", "glove", "boot", "knee", "pouch", "carrier", "beret", "collar", "shirt", "pants", "jacket", "faceshield", "face shield",
}

function isWornGear(inst)
	local name = string.lower(inst.Name)
	for _, word in GEAR_WORDS do
		if string.find(name, word, 1, true) then
			return true
		end
	end
	return false
end

function handPart(character)
	return character:FindFirstChild("RightHand")
		or character:FindFirstChild("Right Arm")
		or character:FindFirstChild("LeftHand")
		or character:FindFirstChild("Left Arm")
end

local gunCache = {}

function heldGun(character)
	local now = os.clock()
	local cached = gunCache[character]
	if cached and now - cached.time < 0.6 then
		return cached.model
	end
	local hand = handPart(character)
	local best, bestDist = nil, math.huge
	local function consider(model)
		if not model:IsA("Model") or isWornGear(model) or not model:FindFirstChild("ItemRoot") then
			return
		end
		local root = model:FindFirstChild("ItemRoot")
		local pos
		if root:IsA("BasePart") then
			pos = root.Position
		else
			pos = model:GetPivot().Position
		end
		local dist = hand and (pos - hand.Position).Magnitude or 0
		if dist < bestDist then
			bestDist = dist
			best = model
		end
	end
	for _, child in character:GetDescendants() do
		if child.Name == "ItemRoot" then
			local model = child:FindFirstAncestorOfClass("Model")
			if model and model ~= character and not isWornGear(model) then
				consider(model)
			end
		end
	end
	if best and bestDist > 25 then
		best = nil
	end
	gunCache[character] = { time = now, model = best }
	return best
end

function inWeapon(part, character)
	local gun = heldGun(character)
	if gun and part:IsDescendantOf(gun) then
		return true
	end
	return false
end

function shouldPaint(part, character)
	return part:IsA("BasePart")
		and part.Name ~= "HumanoidRootPart"
		and part.Transparency < 1
		and not inWeapon(part, character)
end

function applyForce(part, color, style, intensity)
	style = style or "ForceField"
	local solid = math.clamp(intensity or 100, 10, 100) / 100
	local material = Enum.Material.ForceField
	local transparency = 0
	local reflectance = 0
	if style == "Glass" then
		material = Enum.Material.Glass
		transparency = (1 - solid) * 0.72
		reflectance = 0.2
	elseif style == "Neon" or style == "Glow" then
		material = Enum.Material.Neon
		transparency = style == "Glow" and (1 - solid) * 0.45 or 0
	elseif style == "Smooth" then
		material = Enum.Material.SmoothPlastic
	end
	part.Material = material
	part.Color = color
	part.Transparency = transparency
	part.Reflectance = reflectance
	pcall(function()
		part.MaterialVariant = ""
	end)
	if part:IsA("MeshPart") then
		part.TextureID = ""
	end
	local mesh = part:FindFirstChildOfClass("SpecialMesh")
	if mesh then
		mesh.TextureId = ""
	end
end

function blankClothing(inst)
	if inst:IsA("Shirt") then
		inst.ShirtTemplate = ""
	elseif inst:IsA("Pants") then
		inst.PantsTemplate = ""
	elseif inst:IsA("ShirtGraphic") then
		inst.Graphic = ""
	end
end

function suppressOne(state, inst)
	if charState[state.character] ~= state then
		return
	end
	if not (inst:IsA("Shirt") or inst:IsA("Pants") or inst:IsA("ShirtGraphic")) then
		return
	end
	if state.clothes[inst] == nil then
		if inst:IsA("Shirt") then
			state.clothes[inst] = inst.ShirtTemplate
		elseif inst:IsA("Pants") then
			state.clothes[inst] = inst.PantsTemplate
		else
			state.clothes[inst] = inst.Graphic
		end
	end
	blankClothing(inst)
end

local function paintPart(state, part)
	if charState[state.character] ~= state or not shouldPaint(part, state.character) then
		return
	end
	if not painted[part] then
		local surfaces = {}
		for _, child in part:GetChildren() do
			if child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture") then
				surfaces[#surfaces + 1] = child
				child.Parent = nil
			end
		end
		local mesh = part:FindFirstChildOfClass("SpecialMesh")
		local snap = {
			Material = part.Material,
			Color = part.Color,
			Transparency = part.Transparency,
			Reflectance = part.Reflectance,
			TextureID = part:IsA("MeshPart") and part.TextureID or nil,
			Mesh = mesh,
			MeshTexture = mesh and mesh.TextureId or nil,
			Surfaces = surfaces,
		}
		pcall(function()
			snap.MaterialVariant = part.MaterialVariant
		end)
		painted[part] = snap
		state.parts[#state.parts + 1] = part
	end
	applyForce(part, state.color)
end

function showOriginal(part)
	local snap = painted[part]
	if not snap or not part.Parent then
		return
	end
	pcall(function()
		part.Material = snap.Material
		part.Color = snap.Color
		part.Transparency = snap.Transparency or 0
		part.Reflectance = snap.Reflectance
		if snap.MaterialVariant ~= nil then
			part.MaterialVariant = snap.MaterialVariant
		end
		if snap.TextureID ~= nil and part:IsA("MeshPart") then
			part.TextureID = snap.TextureID
		end
		if snap.Mesh and snap.MeshTexture ~= nil then
			snap.Mesh.TextureId = snap.MeshTexture
		end
		for _, child in snap.Surfaces do
			if child then
				child.Parent = part
			end
		end
	end)
end

function hideSurfaces(part)
	local snap = painted[part]
	if not snap then
		return
	end
	if part:IsA("MeshPart") then
		part.TextureID = ""
	end
	if snap.Mesh then
		snap.Mesh.TextureId = ""
	end
	for _, child in snap.Surfaces do
		if child then
			child.Parent = nil
		end
	end
end

local function restorePart(part)
	local snap = painted[part]
	if not snap then
		return
	end
	painted[part] = nil
	if not part.Parent then
		return
	end
	pcall(function()
		part.Material = snap.Material
		part.Color = snap.Color
		part.Transparency = snap.Transparency or 0
		part.Reflectance = snap.Reflectance
		if snap.MaterialVariant ~= nil then
			part.MaterialVariant = snap.MaterialVariant
		end
		if snap.TextureID ~= nil and part:IsA("MeshPart") then
			part.TextureID = snap.TextureID
		end
		if snap.Mesh and snap.MeshTexture ~= nil then
			snap.Mesh.TextureId = snap.MeshTexture
		end
		for _, child in snap.Surfaces do
			if child then
				child.Parent = part
			end
		end
	end)
end

function restoreCharacter(character)
	for _, object in character:GetDescendants() do
		if object.Name == "MidnightWalls" then
			object:Destroy()
		end
	end
	local state = charState[character]
	if not state then
		return
	end
	charState[character] = nil
	if state.addConn then
		state.addConn:Disconnect()
	end
	for index = #state.parts, 1, -1 do
		restorePart(state.parts[index])
	end
	for inst, template in state.clothes do
		if inst.Parent then
			pcall(function()
				if inst:IsA("Shirt") then
					inst.ShirtTemplate = template
				elseif inst:IsA("Pants") then
					inst.PantsTemplate = template
				elseif inst:IsA("ShirtGraphic") then
					inst.Graphic = template
				end
			end)
		end
	end
end

function paintCharacter(character, color)
	local state = charState[character]
	if not state then
		state = { character = character, color = color, clothes = {}, parts = {} }
		charState[character] = state
		state.addConn = character.DescendantAdded:Connect(function(object)
			local current = charState[character]
			if not current then
				return
			end
			if object:IsA("BasePart") then
				task.defer(paintPart, current, object)
			else
				task.defer(suppressOne, current, object)
			end
		end)
		for _, object in character:GetDescendants() do
			if object:IsA("BasePart") then
				paintPart(state, object)
			else
				suppressOne(state, object)
			end
		end
	end
	state.color = color
	local style = character == LocalPlayer.Character and "ForceField" or (Library.Flags["PlayersChamStyle"] or "ForceField")
	local intensity = character == LocalPlayer.Character and 100 or flagNum("PlayersChamIntensity", 70)
	if os.clock() < (state.nextPaint or 0) then
		return
	end
	state.nextPaint = os.clock() + 0.45
	for _, part in state.parts do
		if part.Parent then
			applyForce(part, color, style, intensity)
		end
	end
	for inst in state.clothes do
		if inst.Parent then
			blankClothing(inst)
		end
	end
end

function syncChams(wanted)
	for character, color in wanted do
		paintCharacter(character, color)
	end
	local stale = nil
	for character in charState do
		if not wanted[character] then
			stale = stale or {}
			stale[#stale + 1] = character
		end
	end
	if stale then
		for _, character in stale do
			restoreCharacter(character)
		end
	end
end

