			end
			local PlayersChamsColor1 = flagColor("PlayersChamsColor1", Color3.fromRGB(50, 220, 110))
			local PlayersChamsColor2 = flagColor("PlayersChamsColor2", Color3.fromRGB(255, 60, 60))
