function dragOverlay(frame)
	if not frame or frame:GetAttribute("MidnightDrag") then
		return
	end
	frame:SetAttribute("MidnightDrag", true)
	frame.Active = true
	local dragging = false
	local startPos
	local origin
	frame.InputBegan:Connect(function(input)
		local open = Window.IsOpen
		if open == nil and Window.Items and Window.Items.Outline and Window.Items.Outline.Instance then
			open = Window.Items.Outline.Instance.Visible
		end
		if open == false then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			frame:SetAttribute("Dragged", true)
			startPos = input.Position
			origin = frame.Position
		end
	end)
	local input = game:GetService("UserInputService")
	input.InputChanged:Connect(function(move)
		if not dragging or not origin or not startPos then
			return
		end
		if move.UserInputType ~= Enum.UserInputType.MouseMovement and move.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = move.Position - startPos
		frame.Position = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X, origin.Y.Scale, origin.Y.Offset + delta.Y)
	end)
	input.InputEnded:Connect(function(ended)
		if ended.UserInputType == Enum.UserInputType.MouseButton1 or ended.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local moon = ""
local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for index = 1, #alphabet do
	lookup[alphabet:sub(index, index)] = index - 1
end
local bytes = {}
local buffer, bits = 0, 0
for index = 1, #moon do
	local value = lookup[moon:sub(index, index)]
	if value then
		buffer = buffer * 64 + value
		bits += 6
		if bits >= 8 then
			bits -= 8
			bytes[#bytes + 1] = string.char(math.floor(buffer / (2 ^ bits)) % 256)
			buffer %= (2 ^ bits)
		end
	end
end
writefile("midnight_moon.png", table.concat(bytes))

