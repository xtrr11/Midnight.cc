function quickBosses()
	local found = {}
	local function consider(inst)
		if typeof(inst) ~= "Instance" or ownedCharacter(inst) then
			return
		end
		if isWhisper(inst) then
			found["Whisper"] = inst
			return
		end
		if not inst:IsA("Model") and not inst:IsA("BasePart") and not inst:IsA("Folder") then
			return
		end
		local humanoid = inst:FindFirstChildOfClass("Humanoid")
		if isEscort(inst, humanoid and humanoid.DisplayName) then
			return
		end
		local label = bossLabel(inst.Name)
		if not label and humanoid then
			label = bossLabel(humanoid.DisplayName)
		end
		if not label then
			local named = inst:GetAttribute("BossName") or inst:GetAttribute("NPCName")
			if type(named) == "string" then
				label = bossLabel(named)
			end
		end
		if not label then
			return
		end
		local alive = true
		if humanoid and humanoid.Health <= 0 then
			alive = false
		end
		if alive then
			local current = found[label]
			local better = typeof(current) ~= "Instance"
			if not better and humanoid then
				local old = current:FindFirstChildOfClass("Humanoid")
				local oldHp = old and old.MaxHealth or 0
				better = humanoid.MaxHealth > oldHp or (string.lower(inst.Name) == string.lower(label) and string.lower(current.Name) ~= string.lower(label))
			end
			if better then
				found[label] = inst
			end
		elseif found[label] == nil then
			found[label] = false
		end
	end
	local function considerNpc(inst)
		if inst:IsA("Model") then
			consider(inst)
		elseif inst:IsA("Folder") then
			for _, inner in inst:GetChildren() do
				if inner:IsA("Model") then
					consider(inner)
				end
			end
		end
	end
	local zones = workspace:FindFirstChild("AiZones")
	if zones then
		for _, zone in zones:GetChildren() do
			considerNpc(zone)
			if not zone:IsA("Model") then
				for _, npc in zone:GetChildren() do
					considerNpc(npc)
				end
			end
		end
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("Model") then
			consider(child)
		end
	end
	return found
end

function instancePoint(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local root = inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChild("Head") or inst:FindFirstChildWhichIsA("BasePart")
		if root then
			return root.Position
		end
		local ok, pivot = pcall(inst.GetPivot, inst)
		if ok and typeof(pivot) == "CFrame" then
			return pivot.Position
		end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position
end

function questPhrase(text)
	return string.gsub(string.lower(tostring(text or "")), "[^%w]", "")
end

function questFits(itemName, phrase)
	if itemName == "" or phrase == "" or #phrase < 4 then
		return false
	end
	if itemName == phrase then
		return true
	end
	local generic = {
		rations = true,
		ration = true,
		documents = true,
		document = true,
		meds = true,
		bandage = true,
		bandages = true,
		food = true,
		water = true,
		ammo = true,
		supplies = true,
		supply = true,
		gear = true,
		loot = true,
		parts = true,
	}
	if generic[phrase] then
		return false
	end
	return #phrase >= 8 and string.find(itemName, phrase, 1, true) ~= nil
end

function questWordHit(itemName, phrase)
	return questFits(itemName, phrase)
end

function readQuestWords()
	local words = {}
	local seen = {}
	local function add(title, phrase)
		local filler = { find = true, collect = true, bring = true, the = true, some = true, get = true, grab = true, locate = true, search = true, retrieve = true, deliver = true, turn = true, of = true, ["and"] = true, ["for"] = true, a = true, an = true, ["in"] = true, to = true, from = true, with = true, your = true, you = true, quest = true }
		local bits = {}
		for word in string.gmatch(string.lower(tostring(phrase or "")), "%a+") do
			if not filler[word] and #word >= 3 then
				bits[#bits + 1] = word
			end
		end
		phrase = #bits > 0 and table.concat(bits) or questPhrase(phrase)
		if #phrase < 4 or seen[phrase] or phrase == "complete" then
			return
		end
		seen[phrase] = true
		words[#words + 1] = { phrase = phrase, title = title }
	end
	questPageFound = false
	local quests = questPage
	if not quests or not quests.Parent then
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		local main = playerGui and playerGui:FindFirstChild("MainGui")
		local frame = main and main:FindFirstChild("MainFrame")
		quests = frame and frame:FindFirstChild("Quests", true)
		questPage = quests
	end
	questPageFound = quests ~= nil
	if quests then
		for _, inst in quests:GetDescendants() do
			local leaf = string.lower(inst.Name)
			if leaf ~= "questdescrij" and leaf ~= "questdescription" and leaf ~= "queststory" and (inst:IsA("TextLabel") or inst:IsA("TextButton")) then
				local text = inst.Text
				if type(text) == "string" then
					text = string.gsub(text, "<.->", "")
					if #text <= 72 and not string.find(text, "\n", 1, true) and not string.find(text, "[Complete]", 1, true) then
						local trader, name = string.match(text, "%[([^%]]+)%]%s*(.+)")
						if trader and name and trader ~= "Complete" then
							add("[" .. trader .. "] " .. name, name)
						end
					end
				end
			end
		end
	end
	return words
end

function stepQuestPins()
	local now = os.clock()
	if now - (questWordTime or 0) < 8 then
		return
	end
	questWordTime = now
	if not questWords or now - (questListTime or 0) >= 20 then
		questWords = readQuestWords()
		questListTime = now
	end
	local phraseByTitle = {}
	for _, entry in questWords or {} do
		phraseByTitle[entry.title] = entry.phrase
	end
	local kept = {}
	for _, pin in questPins or {} do
		local phrase = pin.title and phraseByTitle[pin.title]
		if phrase and pin.item and questFits(questPhrase(pin.item), phrase) and typeof(pin.pos) == "Vector3" then
			kept[pin.title] = pin
		end
	end
	local folder = workspace:FindFirstChild("Questitems") or workspace:FindFirstChild("QuestItems")
	local lines = {}
	local foundName = {}
	if #questWords == 0 then
		lines[1] = questPageFound and "none read" or "quest page missing"
	elseif folder then
		local samples = {}
		local stack = { folder }
		local steps = 0
		while #stack > 0 and steps < 400 do
			local inst = table.remove(stack)
			steps += 1
			if inst ~= folder and (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")) then
				local itemName = questPhrase(inst.Name)
				for _, entry in questWords do
					if not foundName[entry.title] and questWordHit(itemName, entry.phrase) then
						local pos = nil
						if inst:IsA("BasePart") then
							pos = inst.Position
						else
							local okPos, pivot = pcall(inst.GetPivot, inst)
							if okPos and typeof(pivot) == "CFrame" then
								pos = pivot.Position
							end
						end
						if typeof(pos) == "Vector3" then
							kept[entry.title] = { pos = pos, title = entry.title, item = inst.Name }
							foundName[entry.title] = inst.Name
							rememberMap("quest:" .. entry.title, entry.title, flagColor("QuestColor", Color3.fromRGB(255, 214, 80)), pos)
						end
						break
					end
				end
			end
			if inst and not inst:IsA("BasePart") then
				for _, child in inst:GetChildren() do
					stack[#stack + 1] = child
				end
			end
		end
		local anyFound = false
		for _ in foundName do
			anyFound = true
			break
		end
		if not anyFound and #samples > 0 then
			lines[#lines + 1] = "in folder: " .. table.concat(samples, ", ")
		end
	else
		lines[#lines + 1] = "no Questitems"
	end
	local allowed = {}
	for _, entry in questWords do
		allowed[entry.title] = true
	end
	questPins = {}
	if #questWords == 0 then
		for _, pin in kept do
			questPins[#questPins + 1] = pin
		end
	else
		for title, pin in kept do
			if allowed[title] then
				questPins[#questPins + 1] = pin
			end
		end
	end
	for _, entry in questWords do
		lines[#lines + 1] = entry.title .. (foundName[entry.title] and ("  " .. foundName[entry.title]) or (kept[entry.title] and "  saved" or "  no item"))
	end
	if mapSaved then
		local live = {}
		for _, pin in questPins do
			if pin.title then
				live["quest:" .. pin.title] = true
			end
		end
		for key in mapSaved do
			if string.sub(key, 1, 6) == "quest:" and not live[key] then
				mapSaved[key] = nil
			end
		end
	end
	if questReadout then
		questReadout.Text = table.concat(lines, "\n")
		if questPanel then
			questPanel.Visible = true
		end
	end
end

function refreshActors()
	local list = {}
	local picks = {}
	local extras = {}
	local function pushAi(model, humanoid, display)
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local aiName = model.Name
		if bossLabel(aiName) or isEscort(model, display) then
			aiName = "Guard"
		elseif aiName == "Model" or aiName == "NPC" or aiName == "Character" then
			aiName = (display ~= "" and display ~= "Humanoid") and display or aiName
		end
		list[#list + 1] = { model = model, kind = "ai", label = aiName, humanoid = humanoid }
	end
	local function take(model)
		if not model or not model:IsA("Model") or ownedCharacter(model) then
			return
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local display = humanoid and humanoid.DisplayName or ""
		local escort = isEscort(model, display)
		local bossName = nil
		if not escort then
			if isWhisper(model) then
				bossName = "Whisper"
			else
				bossName = bossLabel(model.Name) or (display ~= "" and bossLabel(display))
			end
		end
		if bossName and (not humanoid or humanoid.Health > 0 or bossName == "Mi-24" or bossName == "BTR-80") then
			local hp = humanoid and humanoid.MaxHealth or 0
			local exact = string.lower(model.Name) == string.lower(bossName)
			local prev = picks[bossName]
			if not prev or (exact and not prev.exact) or (exact == prev.exact and hp > prev.hp) then
				if prev then
					extras[#extras + 1] = prev.model
				end
				picks[bossName] = { model = model, humanoid = humanoid, label = bossName, hp = hp, exact = exact }
			else
				extras[#extras + 1] = model
			end
			return
		end
		pushAi(model, humanoid, display)
	end
	local zones = workspace:FindFirstChild("AiZones")
	if zones then
		for _, zone in zones:GetChildren() do
			if zone:IsA("Model") then
				take(zone)
			else
				for _, npc in zone:GetChildren() do
					if npc:IsA("Model") then
						take(npc)
					elseif npc:IsA("Folder") then
						for _, inner in npc:GetChildren() do
							if inner:IsA("Model") then
								take(inner)
							end
						end
					end
				end
			end
		end
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("Model") then
			local label = bossLabel(child.Name)
			if label == "Mi-24" or label == "BTR-80" then
				list[#list + 1] = { model = child, kind = "boss", label = label }
			end
		end
	end
	for _, pick in picks do
		list[#list + 1] = { model = pick.model, kind = "boss", label = pick.label, humanoid = pick.humanoid }
	end
	for _, model in extras do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		pushAi(model, humanoid, humanoid and humanoid.DisplayName or "")
	end
	actorCache = list
end

function npcBox(model, camera)
	local head = model:FindFirstChild("Head")
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not head and not root then
		return nil
	end
	local anchor = root or head
	local topPos = head and head:IsA("BasePart") and (head.Position + Vector3.new(0, head.Size.Y * 0.55, 0)) or (anchor.Position + Vector3.new(0, 2.2, 0))
	local bottomPos = anchor.Position - Vector3.new(0, 3, 0)
	local foot = model:FindFirstChild("LeftFoot") or model:FindFirstChild("RightFoot") or model:FindFirstChild("Left Leg") or model:FindFirstChild("Right Leg")
	if foot and foot:IsA("BasePart") then
		bottomPos = foot.Position - Vector3.new(0, foot.Size.Y * 0.45, 0)
	end
	local top = camera:WorldToViewportPoint(topPos)
	local bottom = camera:WorldToViewportPoint(bottomPos)
	if top.Z < 0.25 or bottom.Z < 0.25 then
		return nil
	end
	local height = math.max(math.abs(bottom.Y - top.Y), 16)
	local width = math.max(height * 0.5, 12)
	local centerX = (top.X + bottom.X) * 0.5
	local topY = math.min(top.Y, bottom.Y)
	return centerX - width * 0.5 - 2, topY - 2, width + 4, height + 4
end

function drawActors(camera, origin, active)
	actorSeen = {}
	if not flagBool("AIESPEnabled") and not flagBool("BossESPEnabled") then
		if actorPacks then
			for _, pack in actorPacks do
				hidePack(pack)
			end
		end
		return
	end
	for _, entry in actorCache or {} do
		local model = entry.model
		if model and model.Parent then
			local isBoss = entry.kind == "boss"
			local enabled = isBoss and flagBool("BossESPEnabled") or (not isBoss and flagBool("AIESPEnabled"))
			if enabled then
				local prefix = isBoss and "Boss" or "AI"
				local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
				local pos = root and root:IsA("BasePart") and root.Position
				if not pos then
					local okPos, pivot = pcall(model.GetPivot, model)
					if okPos and typeof(pivot) == "CFrame" then
						pos = pivot.Position
					end
				end
				if pos then
					local dist = (pos - origin).Magnitude
					local limit = rangeStuds(prefix .. "MaxDistance", isBoss and 800 or 400)
					if dist <= limit then
						local chams = flagBool(prefix .. "Chams")
						local mark = model:FindFirstChild("MidnightMark")
						if chams then
							if not mark then
								mark = Instance.new("Highlight")
								mark.Name = "MidnightMark"
								mark.Adornee = model
								mark.Parent = model
								mark.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							end
							mark.Enabled = true
							mark.FillColor = flagColor(prefix .. "ChamsColor1", Color3.fromRGB(255, 160, 80))
							mark.OutlineColor = flagColor(prefix .. "ChamsColor2", Color3.new(1, 1, 1))
							active[mark] = true
						elseif mark then
							mark.Enabled = false
						end
						local ahead = camera:WorldToViewportPoint(pos)
						if ahead.Z > 0.15 then
							actorPacks = actorPacks or {}
							local pack = actorPacks[model]
							if not pack then
								local okPack, created = pcall(makePack)
								if okPack then
									actorPacks[model] = created
									pack = created
								end
							end
							actorSeen[model] = true
							if pack then
								local showName = flagBool(prefix .. "Names")
								local showDist = flagBool(prefix .. "Distance")
								local showBox = flagBool(prefix .. "Boxes")
								local showHealth = flagBool(prefix .. "Health")
								local showHealthText = flagBool(prefix .. "HealthText")
								local x, y, w, h
								if entry.label == "Mi-24" or entry.label == "BTR-80" then
									x, y, w, h = vehicleBox(model, camera)
								else
									x, y, w, h = box2d(model, camera)
								end
								if not x then
									hidePack(pack)
								else
									local textFont = drawingFont()
									local nameColor = flagColor(prefix .. "NameColor", isBoss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 160, 80))
									drawEspBox(pack, x, y, w, h, flagColor(prefix .. "BoxColor1", nameColor), Library.Flags[prefix .. "BoxStyle"] or "Full", showBox)
									local textSize = math.clamp(math.floor(h * 0.22), 9, 13)
									pack.name.Visible = showName
									pack.name.Text = entry.label or ""
									pack.name.Size = textSize
									pack.name.Center = true
									pack.name.Font = textFont
									pack.name.Color = nameColor
									pack.name.Outline = true
									pack.name.Position = Vector2.new(x + w * 0.5, y - textSize - 1)
									pack.kd.Visible = false
									pack.cheat.Visible = false
									pack.weapon.Visible = false
									pack.visor.Visible = false
									pack.aim.Visible = false
									pack.dist.Visible = showDist
									pack.dist.Text = string.format("%dm", math.floor(dist * 0.28 + 0.5))
									pack.dist.Size = textSize
									pack.dist.Font = textFont
									pack.dist.Color = flagColor(prefix .. "DistanceColor", nameColor)
									pack.dist.Outline = true
									pack.dist.Center = true
									pack.dist.Position = Vector2.new(x + w * 0.5, y + h + 2)
									local hp, maxHp = healthOf(model)
									local ratio = math.clamp(maxHp > 0 and hp / maxHp or 0, 0, 1)
									local barH = math.max(h, textSize + 2)
									local barW = math.clamp(math.floor(textSize * 0.34), 3, 5)
									local barX = x - barW - 3
									local barY = (y + h * 0.5) - barH * 0.5
									pack.hpOutline.Visible = showHealth
									pack.hpOutline.Position = Vector2.new(barX - 1, barY - 1)
									pack.hpOutline.Size = Vector2.new(barW + 2, barH + 2)
									pack.hpOutline.Color = Color3.new(0, 0, 0)
									pack.hpOutline.Filled = false
									pack.hpOutline.Thickness = 1
									pack.hpBack.Visible = showHealth
									pack.hpBack.Position = Vector2.new(barX, barY)
									pack.hpBack.Size = Vector2.new(barW, barH)
									pack.hpBack.Color = Color3.new(0, 0, 0)
									pack.hpFill.Visible = showHealth
									pack.hpFill.Position = Vector2.new(barX, barY + barH * (1 - ratio))
									pack.hpFill.Size = Vector2.new(barW, math.max(barH * ratio, 1))
									pack.hpFill.Color = healthTint(ratio, Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 220, 70), Color3.fromRGB(80, 255, 120))
									pack.hpText.Visible = showHealthText
									pack.hpText.Text = tostring(math.floor(hp + 0.5))
									pack.hpText.Size = textSize
									pack.hpText.Font = textFont
									pack.hpText.Outline = true
									pack.hpText.OutlineColor = Color3.new(0, 0, 0)
									pack.hpText.Color = Color3.new(1, 1, 1)
									pack.hpText.Center = false
									local hpWidth = #pack.hpText.Text * textSize * 0.62
									pack.hpText.Position = Vector2.new(barX - hpWidth - 3, barY + barH * 0.5 - textSize * 0.5)
									drawSkeleton(pack, model, camera, flagColor(prefix .. "SkeletonColor", Color3.new(1, 1, 1)), flagBool(prefix .. "Skeleton"))
									drawBody(pack, model, camera, nameColor, flagBool(prefix .. "Body"))
								end
							end
						elseif actorPacks and actorPacks[model] then
							hidePack(actorPacks[model])
						end
					end
				end
			end
		end
	end
	if actorPacks then
		for model, pack in actorPacks do
			if not actorSeen[model] or not model.Parent then
				hidePack(pack)
				actorPacks[model] = nil
			end
		end
	end
end

function drawWorldEsp(camera, doScan)
	local trackBoss = Library.Flags["BossTracker"] ~= false
	if doScan and bossReadout and bossReadout.Parent then
		local bosses = quickBosses()
		liveBosses = bosses
		bossReadout.Parent.Visible = trackBoss
		if trackBoss then
			local lines = {}
			for _, boss in BOSS_LIST do
				local model = bosses[boss.label]
				if typeof(model) == "Instance" and model.Parent then
					lines[#lines + 1] = boss.label .. "  True"
				else
					lines[#lines + 1] = boss.label .. "  False"
				end
			end
			bossReadout.Text = table.concat(lines, "\n")
		end
	end
	local anyWorld = flagBool("ItemESPEnabled") or flagBool("AIESPEnabled") or flagBool("BossESPEnabled") or flagBool("ExfilESPEnabled") or flagBool("CorpseESPEnabled") or flagBool("VehicleESP") or flagBool("MineESP") or flagBool("TraderESP") or flagBool("DropESP") or flagBool("QuestESP") or trackBoss
	if not anyWorld then
		for index = 1, #worldPool do
			worldPool[index].text.Visible = false
			worldPool[index].box.Visible = false
		end
		return
	end
	if doScan then
		refreshWorld()
		if flagBool("AIESPEnabled") or flagBool("BossESPEnabled") then
			refreshActors()
		else
			actorCache = {}
		end
	end

	worldUsed = 0
	local origin = camera.CFrame.Position
	local active = {}
	drawActors(camera, origin, active)
	for _, entry in worldCache do
		if entry.kind == "ai" or entry.kind == "boss" then
			continue
		end
		local model = entry.model
		if model and model.Parent then
			local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
			if entry.kind == "corpse" then
				root = model:FindFirstChild("UpperTorso") or root
			end
			local pos = nil
			if root and root:IsA("BasePart") then
				pos = root.Position
			else
				local okPos, pivot = pcall(model.GetPivot, model)
				if okPos and typeof(pivot) == "CFrame" then
					pos = pivot.Position
				end
			end
			local skip = not pos
			if not skip then
			local dist = (pos - origin).Magnitude
			local limit = 1200
			local color = Color3.fromRGB(255, 220, 120)
			local show = false
			local boxes = false
			local chams = false
			if entry.kind == "boss" and flagBool("BossESPEnabled") then
				show = true
				boxes = flagBool("BossBoxes")
				chams = flagBool("BossChams")
				color = flagColor("BossNameColor", Color3.fromRGB(255, 80, 80))
				limit = rangeStuds("BossMaxDistance", 800)
			elseif entry.kind == "ai" and flagBool("AIESPEnabled") then
				show = true
				boxes = flagBool("AIBoxes")
				chams = flagBool("AIChams")
				color = flagColor("AINameColor", Color3.fromRGB(255, 160, 80))
				limit = rangeStuds("AIMaxDistance", 400)
			elseif entry.kind == "corpse" and flagBool("CorpseESPEnabled") then
				show = true
				color = flagColor("CorpseColor", Color3.fromRGB(255, 255, 255))
				limit = rangeStuds("CorpseMaxDistance", 300)
			elseif entry.kind == "mark" and flagBool(entry.flag) then
				show = true
				color = entry.color
				limit = rangeStuds(entry.distFlag, 400)
			elseif entry.kind == "item" then
				show = true
				color = flagColor(entry.cat .. "Color", Color3.fromRGB(235, 255, 240))
				limit = rangeStuds(entry.cat .. "MaxDistance", 150)
			end
			local mark = model:FindFirstChild("MidnightMark")
			if chams and dist <= limit then
				if not mark then
					mark = Instance.new("Highlight")
					mark.Name = "MidnightMark"
					mark.Adornee = model
					mark.Parent = model
					mark.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				end
				mark.Enabled = true
				mark.FillColor = flagColor(entry.kind == "boss" and "BossChamsColor1" or "AIChamsColor1", color)
				mark.OutlineColor = flagColor(entry.kind == "boss" and "BossChamsColor2" or "AIChamsColor2", Color3.new(1, 1, 1))
				active[mark] = true
			elseif mark then
				mark.Enabled = false
			end
			if show and dist <= limit then
				local screen, onScreen = camera:WorldToViewportPoint(pos)
				local viewport = camera.ViewportSize
				local sane = onScreen and screen.Z > 0.4 and screen.X > -20 and screen.X < viewport.X + 20 and screen.Y > -20 and screen.Y < viewport.Y + 20
				if sane then
					local row = nextWorldDraw()
					if row then
						local text = entry.label
						if entry.humanoid and entry.kind ~= "corpse" then
							text = string.format("%s  %dhp", entry.label, math.floor(entry.humanoid.Health + 0.5))
						end
						if entry.kind ~= "corpse" and entry.kind ~= "mark" or (entry.kind == "corpse" and flagBool("CorpseDistance")) or (entry.kind == "mark" and true) then
							if entry.kind ~= "mark" or true then
								text = string.format("%s  [%dm]", text, math.floor(dist * 0.28 + 0.5))
							end
						end
						row.text.Visible = true
						row.text.Font = drawingFont()
						row.text.Text = text
						row.text.Color = color
						row.text.Position = Vector2.new(screen.X, screen.Y - 36)
						if boxes and (entry.kind == "ai" or entry.kind == "boss") then
							local bx, by, bw, bh = box2d(model, camera)
							row.box.Visible = bx ~= nil
							if bx then
								row.box.Size = Vector2.new(bw, bh)
								row.box.Position = Vector2.new(bx, by)
								row.box.Color = color
							end
						else
							row.box.Visible = boxes
							if boxes then
								local size = 18
								row.box.Size = Vector2.new(size, size)
								row.box.Position = Vector2.new(screen.X - size * 0.5, screen.Y - size * 0.5)
								row.box.Color = color
							end
						end
					end
				end
			end
			end
		end
	end
	if flagBool("ExfilESPEnabled") then
		local showName = Library.Flags["ExfilName"] ~= false
		local showDist = Library.Flags["ExfilDistance"] ~= false
		if showName or showDist then
			if not exitFolder or not exitFolder.Parent then
				local noCollision = workspace:FindFirstChild("NoCollision")
				exitFolder = noCollision and noCollision:FindFirstChild("ExitLocations")
			end
			if exitFolder then
				local color = flagColor("ExfilNameColor", Color3.fromRGB(80, 220, 140))
				local limit = rangeStuds("ExfilMaxDistance", 1000)
				for _, inst in exitFolder:GetChildren() do
					local okPos, pos = pcall(function()
						return inst:GetPivot().Position
					end)
					if okPos and pos then
						local dist = (pos - origin).Magnitude
						if dist <= limit then
							local screen, onScreen = camera:WorldToViewportPoint(pos)
							local viewport = camera.ViewportSize
							if onScreen and screen.Z > 0.4 and screen.X > 0 and screen.X < viewport.X and screen.Y > 0 and screen.Y < viewport.Y then
								local row = nextWorldDraw()
								if row then
									local meters = math.floor(dist * 0.28 + 0.5)
									local text = inst.Name
									if showName and showDist then
										text = string.format("%s  [%dm]", inst.Name, meters)
									elseif showDist then
										text = string.format("[%dm]", meters)
									end
									row.text.Visible = true
									row.text.Text = text
									row.text.Color = color
									row.text.Position = Vector2.new(screen.X, screen.Y)
									row.box.Visible = false
								end
							end
						end
					end
				end
			end
		end
	end
	if flagBool("QuestESP") then
		pcall(stepQuestPins)
		local color = flagColor("QuestColor", Color3.fromRGB(255, 214, 80))
		local limit = rangeStuds("QuestMaxDistance", 400)
		for _, pin in questPins or {} do
			local pos = pin.pos
			if typeof(pos) == "Vector3" then
				local dist = (pos - origin).Magnitude
				if dist <= limit then
					local screen, onScreen = camera:WorldToViewportPoint(pos)
					local viewport = camera.ViewportSize
					if onScreen and screen.Z > 0.4 and screen.X > 0 and screen.X < viewport.X and screen.Y > 0 and screen.Y < viewport.Y then
						local row = nextWorldDraw()
						if row then
							local meters = math.floor(dist * 0.28 + 0.5)
							row.text.Visible = true
							row.text.Text = string.format("%s  [%dm]", pin.title, meters)
							row.text.Color = color
							row.text.Position = Vector2.new(screen.X, screen.Y)
							row.box.Visible = false
						end
					end
				end
			end
		end
	elseif questPanel then
		questPanel.Visible = false
	end
	for index = worldUsed + 1, #worldPool do
		worldPool[index].text.Visible = false
		worldPool[index].box.Visible = false
	end
	for _, mark in worldMarks do
		if not active[mark] and mark.Parent then
			mark.Enabled = false
		end
	end
	table.clear(worldMarks)
	for mark in active do
		worldMarks[#worldMarks + 1] = mark
	end
end

function profileStats(player)
	statCache = statCache or {}
	local cached = statCache[player]
	if cached and os.clock() - cached.t < 2 then
		return cached.kills, cached.deaths, cached.kd, cached.reports, cached.hours
	end
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local profile = folder and (folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId)))
	local kills, deaths, reports, hours = 0, 0, 0, nil
	local stats = profile and profile:FindFirstChild("Status")
	local journey = stats and stats:FindFirstChild("Journey")
	local wipe = journey and journey:FindFirstChild("WipeStatistics")
	if wipe then
		kills = tonumber(wipe:GetAttribute("Kills")) or 0
		deaths = tonumber(wipe:GetAttribute("Deaths")) or 0
	end
	local uac = stats and stats:FindFirstChild("UAC")
	local function absorbReports(inst)
		if not inst then
			return
		end
		for name, value in inst:GetAttributes() do
			local lower = string.lower(name)
			if type(value) == "number" and (string.find(lower, "report", 1, true) or string.lower(inst.Name) == "reports") then
				reports += value
			end
		end
		if inst:IsA("ValueBase") then
			local number = tonumber(inst.Value)
			if number and string.find(string.lower(inst.Name), "report", 1, true) then
				reports += number
			end
		end
	end
	absorbReports(uac)
	absorbReports(stats)
	absorbReports(profile)
	absorbReports(player)
	if stats then
		for _, inst in stats:GetChildren() do
			if string.find(string.lower(inst.Name), "report", 1, true) then
				absorbReports(inst)
				if inst:GetAttribute("Count") == nil and #inst:GetChildren() > 0 and reports == 0 then
					reports = #inst:GetChildren()
				end
			end
		end
	end
	local function consider(name, value)
		local lower = string.lower(tostring(name))
		if string.find(lower, "kill", 1, true) or string.find(lower, "death", 1, true) or string.find(lower, "report", 1, true) then
			return
		end
		local number = nil
		if type(value) == "number" then
			number = value
		elseif type(value) == "string" then
			number = tonumber(string.match(value, "%d+"))
		end
		if not number or number < 0 or number > 20000000 then
			return
		end
		local isTime = string.find(lower, "play", 1, true) or string.find(lower, "hour", 1, true) or string.find(lower, "time", 1, true) or string.find(lower, "minute", 1, true) or string.find(lower, "online", 1, true) or string.find(lower, "session", 1, true)
		if not isTime then
			return
		end
		local asHours = number
		if string.find(lower, "minute", 1, true) then
			asHours = number / 60
		elseif string.find(lower, "second", 1, true) or number > 5000 then
			asHours = number / 3600
		end
		if not hours or asHours > hours then
			hours = asHours
		end
	end
	local function readHours(inst)
		if not inst then
			return
		end
		for name, value in inst:GetAttributes() do
			consider(name, value)
		end
		if inst:IsA("ValueBase") then
			consider(inst.Name, inst.Value)
		end
	end
	readHours(wipe)
	readHours(journey)
	readHours(stats)
	readHours(profile)
	readHours(player)
	local kd = deaths > 0 and (kills / deaths) or kills
	statCache[player] = { t = os.clock(), kills = kills, deaths = deaths, kd = kd, reports = reports, hours = hours }
	return kills, deaths, kd, reports, hours
end

