function scanInventories()
	local ScanItems = v0.Flags.ScanItems
	
	if type(ScanItems) ~= "table" or #ScanItems == 0 then
		showScan("Inventory scan", { "select items first" })
		
		return
	end
	local Players1 = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local t = {}
	
	local function nameHit(Text)
		local Lowered = string.lower(Text)
		local v1308 = nil
		
		for _, scanItem in ScanItems do
			local SCANITEMKEY = SCAN_ITEM_KEYS and SCAN_ITEM_KEYS[scanItem]
			
			if SCANITEMKEY then
				for _, value in SCANITEMKEY do
					if string.find(Lowered, value, 1, true) then
						v1308 = scanItem
						break
					end
				end
			end
			if v1308 then break end
		end
		return v1308
	end
	
	for _, player in Players:GetPlayers() do
