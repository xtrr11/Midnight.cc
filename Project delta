						EnsurePackResult.hpText.Center = false
						EnsurePackResult.hpText.Position = Vector2.new(X - #EnsurePackResult.hpText.Text * ClampedValue1 * 0.62 - 3, Y + Largest * 0.5 - ClampedValue1 * 0.5)
