	end
	return best
end

function installLiveGun()
	if liveGunHooked or type(getgc) ~= "function" then
		return
	end
	local fpsObject, reloadTypes
	for _, value in getgc(true) do
		if type(value) == "table" then
			if not fpsObject and rawget(value, "springs") and type(rawget(value, "updateClient")) == "function" then
				fpsObject = value
			end
			if not reloadTypes and type(rawget(value, "magazine")) == "function" and type(rawget(value, "loadByHand")) == "function" then
				reloadTypes = value
			end
			if not useTypes and type(rawget(value, "RangedWeaponDefault")) == "function" and type(rawget(value, "MeleeWeaponDefault")) == "function" then
				useTypes = value
			end
		end
		if fpsObject and reloadTypes and useTypes then
			break
		end
	end
	if fpsObject then
		local oldUpdate = fpsObject.updateClient
		fpsObject.updateClient = function(...)
			local self = ...
			pcall(applyLiveGun, self)
			return oldUpdate(...)
		end
	end
	if reloadTypes then
		local oldMagazine = reloadTypes.magazine
		local oldHand = reloadTypes.loadByHand
		reloadTypes.magazine = function(fpsObject, mag)
			if not flagBool("InstantReload") then
				return oldMagazine(fpsObject, mag)
			end
			mag = mag or compatibleMag(fpsObject)
			local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
			local equip = remotes and remotes:FindFirstChild("Equip")
			local move = remotes and remotes:FindFirstChild("InventoryMove")
			local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
			local profile = folder and folder:FindFirstChild(LocalPlayer.Name)
			local gameplay = profile and profile:FindFirstChild("Status")
			gameplay = gameplay and gameplay:FindFirstChild("GameplayVariables")
			local equipped = gameplay and gameplay:FindFirstChild("EquippedTool")
			equipped = equipped and equipped.Value
			local equipId = gameplay and gameplay:GetAttribute("EquipId")
			if mag and equipped and equip and move and equipId then
				pcall(function()
					equip:FireServer()
					move:FireServer(mag:GetAttribute("Slot") or mag:GetAttribute("SlotType"), "Magazine", mag.Parent, equipped:FindFirstChild("Attachments"), nil)
					equip:FireServer(equipped, equipId)
				end)
				return
			end
			return oldMagazine(fpsObject, mag)
		end
		reloadTypes.loadByHand = function(fpsObject, ammo)
			if not flagBool("InstantReload") then
				return oldHand(fpsObject, ammo)
			end
			local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
			local reload = remotes and remotes:FindFirstChild("Reload")
			if reload and ammo then
				pcall(function()
					reload:InvokeServer(nil, 0.01, ammo)
				end)
				return
			end
			return oldHand(fpsObject, ammo)
		end
	end
	if fpsObject or reloadTypes then
		liveGunHooked = true
	end
end

