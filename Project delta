		end
		return nil
	end
	
	local function readItem(Object)
		if typeof(Object) ~= "Instance" then
			return nil
		end
		local AsDownResult = asDown(Object:GetAttribute("VisorDown"))
		
		if AsDownResult == nil then
			local ItemProperties = Object:FindFirstChild("ItemProperties")
			AsDownResult = ItemProperties and asDown(ItemProperties:GetAttribute("VisorDown"))
		end
		return AsDownResult
	end
	
	local function isVisorName(Name, Slot)
		local Lowered = string.lower(tostring(Name))
		local SlotName = string.lower(tostring(Slot or ""))
		if string.find(SlotName, "visor", 1, true) then
			return true
		end
		return string.find(Lowered, "visor", 1, true) or string.find(Lowered, "goggle", 1, true) or string.find(Lowered, "titan", 1, true) or string.find(Lowered, "shield", 1, true) or string.find(Lowered, "maska", 1, true) or string.find(Lowered, "zsh", 1, true) or string.find(Lowered, "low cut", 1, true) or string.find(Lowered, "faceshield", 1, true) or string.find(Lowered, "nvg", 1, true)
