						local NewY = Y2 + (if PlayersDistance then 14 else 2)
						local ViewportSize = CurrentCamera.ViewportSize
						local IsNewYBelow: boolean = XOffset > 0 and (XOffset < ViewportSize.X and NewY > 0) and NewY < ViewportSize.Y
