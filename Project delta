function isEscort(model, display)
	local blob = string.lower(tostring(model and model.Name or "") .. " " .. tostring(display or ""))
	return string.find(blob, "guard", 1, true) ~= nil
		or string.find(blob, "soldier", 1, true) ~= nil
		or string.find(blob, "escort", 1, true) ~= nil
		or string.find(blob, "minion", 1, true) ~= nil
		or string.find(blob, "bodyguard", 1, true) ~= nil
end

function bossLabel(name)
	local raw = string.lower(tostring(name or ""))
	if raw == "" or isEscort({ Name = raw }, raw) then
		return nil
	end
	local lower = string.gsub(raw, "[^%w%-]", "")
	for _, boss in BOSS_LIST do
		for _, key in boss.keys do
			if string.find(lower, key, 1, true) then
				return boss.label
			end
		end
	end
	return nil
end

function isWhisper(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") or ownedCharacter(model) then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local blob = string.lower(model.Name .. " " .. (humanoid.DisplayName or ""))
	return string.find(blob, "whisper", 1, true) ~= nil
end

function ownedCharacter(model)
	local current = model
	while current do
		if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
			return true
		end
		current = current.Parent
	end
	return false
end

function worldName(inst)
	local props = inst:FindFirstChild("ItemProperties")
	if props then
		for _, key in { "CallSign", "ItemName", "DisplayName", "Name" } do
			local value = props:GetAttribute(key)
			if type(value) == "string" and value ~= "" and value ~= "Item" then
				return value
			end
		end
	end
	for _, key in { "CallSign", "ItemName", "DisplayName" } do
		local value = inst:GetAttribute(key)
		if type(value) == "string" and value ~= "" and value ~= "Item" then
			return value
		end
	end
	local named = inst:FindFirstChild("ItemName") or inst:FindFirstChild("CallSign")
	if named and named:IsA("StringValue") and named.Value ~= "" then
		return named.Value
	end
	if inst.Name == "Item" or inst.Name == "Model" then
		local board = inst:FindFirstChildWhichIsA("BillboardGui")
		local text = board and board:FindFirstChildWhichIsA("TextLabel", true)
		if text and text.Text ~= "" and text.Text ~= "Item" then
			return text.Text
		end
	end
	if inst.Name ~= "Item" and inst.Name ~= "Model" and inst.Name ~= "Handle" then
		return inst.Name
	end
	if inst.Parent and inst.Parent.Name ~= "Item" and inst.Parent.Name ~= "Model" then
		return inst.Parent.Name
	end
	return inst.Name
end

