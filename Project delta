			local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
			if head and myHead then
				local delta = myHead.Position - head.Position
				if delta.Magnitude > 1 then
					local facing = head.CFrame.LookVector:Dot(delta.Unit)
					if facing > 0.55 then
						local percent = math.floor(math.clamp((facing - 0.55) / 0.45, 0, 1) * 100 + 0.5)
						if percent >= 70 then
							lookLines[#lookLines + 1] = string.format("[%dm] %s is looking at you [%d%%]", math.floor(dist * 0.28 + 0.5), player.Name, percent)
						end
					end
				end
			end
		end

		if onEsp and showChams and character and camera then
			local rec = seeCache and seeCache[character]
			local seen
			if rec and os.clock() - rec.t < 0.25 then
				seen = rec.v
			else
				seen = canSee(character, camera)
				seeCache = seeCache or {}
				seeCache[character] = { t = os.clock(), v = seen }
			end
			local visibleColor = flagColor("PlayersChamsColor1", Color3.fromRGB(50, 220, 110))
			local hiddenColor = flagColor("PlayersChamsColor2", Color3.fromRGB(255, 60, 60))
			local color = (seen or not throughWalls) and visibleColor or hiddenColor
			if throughWalls or seen then
				wanted[character] = color
			end
			if throughWalls then
				applyHighlight(character, color, Library.Flags["PlayersChamStyle"] or "ForceField", flagNum("PlayersChamIntensity", 70))
			else
				clearHighlight(character)
			end
		elseif character and character ~= (LocalPlayer.Character) then
			clearHighlight(character)
		end

		if not onEsp or not camera or not root then
			if pack then
				hidePack(pack)
			end
			if weaponIcons and weaponIcons[player] then
				weaponIcons[player].Visible = false
			end
		else
			local ahead = camera:WorldToViewportPoint(root.Position)
			if ahead.Z < 0.15 then
				if pack then
					hidePack(pack)
				end
				if weaponIcons and weaponIcons[player] then
					weaponIcons[player].Visible = false
				end
			else
			local x, y, w, h = box2d(character, camera)
			if not x then
				if pack then
					hidePack(pack)
				end
				if weaponIcons and weaponIcons[player] then
					weaponIcons[player].Visible = false
				end
			else
				pack = ensurePack(player)
				if pack then
					local boxColor = flagColor("PlayersBoxColor1", Color3.fromRGB(255, 255, 255))
					drawEspBox(pack, x, y, w, h, boxColor, Library.Flags["PlayersBoxStyle"] or "Full", showBox)

					local textFont = drawingFont()
					pack.name.Visible = showName
					pack.name.Text = player.Name
					pack.name.Size = math.clamp(math.floor(h * 0.22), 9, 13)
					pack.name.Center = true
					pack.name.Font = textFont
					pack.name.Color = flagColor("PlayersNameColor", Color3.fromRGB(255, 255, 255))
					pack.name.Outline = true
					local nameY = y - pack.name.Size - 1
					pack.name.Position = Vector2.new(x + w * 0.5, nameY)

					local showKd = Library.Flags["PlayersKD"] ~= false
					pack.kd.Visible = showKd and type(kd) == "number"
					pack.kd.Text = type(kd) == "number" and string.format("%.2f kd", kd) or ""
					pack.kd.Color = pack.name.Color
					pack.kd.Center = false
					pack.kd.Size = pack.name.Size
					pack.kd.Font = textFont
					pack.kd.Outline = true
					pack.kd.OutlineColor = Color3.new(0, 0, 0)
					pack.kd.Position = Vector2.new(x + w * 0.5 + (#player.Name * pack.name.Size * 0.28) + 4, nameY)

					pack.cheat.Visible = flagged
					pack.cheat.Text = flagged and string.format("CHEATER %dd", age) or ""
					pack.cheat.Size = math.max(pack.name.Size - 1, 8)
					pack.cheat.Font = textFont
					pack.cheat.Outline = true
					pack.cheat.OutlineColor = Color3.new(0, 0, 0)
					pack.cheat.Position = Vector2.new(x + w * 0.5, nameY - pack.cheat.Size - 1)

					local footY = y + h + 2
					local footPart = character:FindFirstChild("LeftFoot") or character:FindFirstChild("RightFoot") or character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
					local footWorld = root and (root.Position - Vector3.new(0, 3, 0))
					if footPart and footPart:IsA("BasePart") then
						footWorld = footPart.Position - Vector3.new(0, footPart.Size.Y * 0.5, 0)
					end
					if footWorld then
						local footScreen = camera:WorldToViewportPoint(footWorld)
						if footScreen.Z > 0.2 and math.abs(footScreen.X - (x + w * 0.5)) < 140 and footScreen.Y >= y - 4 then
							footY = footScreen.Y + 2
						end
					end
					pack.dist.Visible = showDist
					pack.dist.Text = string.format("%dm", math.floor(dist * 0.28 + 0.5))
					pack.dist.Size = pack.name.Size
					pack.dist.Font = textFont
					pack.dist.Color = flagColor("PlayersDistanceColor", Color3.fromRGB(255, 255, 255))
					pack.dist.Outline = true
					pack.dist.Position = Vector2.new(x + w * 0.5, footY)

					local gunModel = showWeapon and heldGun(character) or nil
					local gun = gunModel and gunModel.Name or ""
					local weaponMode = Library.Flags["PlayersWeaponMode"]
					if type(weaponMode) == "table" then
						weaponMode = weaponMode.Name or weaponMode[1]
					end
					local useIcon = weaponMode ~= "Text"
					local icon = nil
					if useIcon and gun ~= "" then
						icon = weaponIcon(player)
					elseif weaponIcons and weaponIcons[player] then
						weaponIcons[player].Visible = false
					end
					local iconX = x + w * 0.5
					local iconY = footY + (showDist and 14 or 2)
					local viewport = camera.ViewportSize
					local iconOnScreen = iconX > 0 and iconX < viewport.X and iconY > 0 and iconY < viewport.Y
					local image = ""
					if icon and iconOnScreen then
						image = itemIcon(gun, gunModel)
					end
					if useIcon and icon and image ~= "" then
						icon.Image = image
						icon.BackgroundTransparency = 1
						icon.Visible = true
						local iconSize = math.clamp(flagNum("PlayersIconSize", 48), 20, 96)
						icon.Size = UDim2.fromOffset(iconSize, iconSize)
						icon.Position = UDim2.fromOffset(iconX, iconY)
						icon:SetAttribute("Seen", iconStamp)
						pack.weapon.Visible = false
					else
						if icon then
							icon.Visible = false
						end
						pack.weapon.Visible = showWeapon and gun ~= ""
						pack.weapon.Text = gun
						pack.weapon.Size = 13
						pack.weapon.Font = textFont
						pack.weapon.Color = flagColor("PlayersWeaponColor", Color3.fromRGB(255, 255, 255))
						pack.weapon.Outline = true
						pack.weapon.Position = Vector2.new(x + w * 0.5, y + h + (showDist and 16 or 2))
					end

					local hp, maxHp = healthOf(character)
					local ratio = math.clamp(maxHp > 0 and hp / maxHp or 0, 0, 1)
					local textSize = math.clamp(pack.name.Size, 11, 14)
					local barH = math.max(h, textSize + 2)
					local barW = math.clamp(math.floor(textSize * 0.34), 3, 5)
					local barX = x - barW - 3
					local barY = (y + h * 0.5) - barH * 0.5
					pack.hpOutline.Visible = showHealth
					pack.hpOutline.Position = Vector2.new(barX - 1, barY - 1)
					pack.hpOutline.Size = Vector2.new(barW + 2, barH + 2)
					pack.hpOutline.Color = Color3.new(0, 0, 0)
					pack.hpOutline.Filled = false
					pack.hpOutline.Thickness = 1
					pack.hpBack.Visible = showHealth
					pack.hpBack.Position = Vector2.new(barX, barY)
					pack.hpBack.Size = Vector2.new(barW, barH)
					pack.hpBack.Color = Color3.new(0, 0, 0)
					pack.hpFill.Visible = showHealth
					pack.hpFill.Position = Vector2.new(barX, barY + barH * (1 - ratio))
					pack.hpFill.Size = Vector2.new(barW, math.max(barH * ratio, 1))
					pack.hpFill.Color = healthTint(
						ratio,
						flagColor("PlayersHealthColor1", Color3.fromRGB(255, 70, 70)),
						flagColor("PlayersHealthColor2", Color3.fromRGB(255, 220, 70)),
						flagColor("PlayersHealthColor3", Color3.fromRGB(80, 255, 120))
					)
					pack.hpText.Visible = showHealthText
					pack.hpText.Text = tostring(math.floor(hp + 0.5))
					pack.hpText.Size = textSize
					pack.hpText.Font = textFont
					pack.hpText.Outline = true
					pack.hpText.OutlineColor = Color3.new(0, 0, 0)
					pack.hpText.Color = flagColor("PlayersHealthTextColor", Color3.fromRGB(255, 255, 255))
					pack.hpText.Center = false
					local hpWidth = #pack.hpText.Text * textSize * 0.62
					pack.hpText.Position = Vector2.new(barX - hpWidth - 3, barY + barH * 0.5 - textSize * 0.5)
					local infoY = pack.hpText.Position.Y + textSize + 2
					local showVisor = Library.Flags["PlayersVisor"] ~= false
					local visor = showVisor and visorOf(player) or nil
					pack.visor.Visible = visor ~= nil
					pack.visor.Text = visor == true and "v:t" or "v:f"
					pack.visor.Size = pack.hpText.Size
					pack.visor.Font = textFont
					pack.visor.Center = true
					pack.visor.Outline = true
					pack.visor.Color = visor and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(255, 90, 90)
					pack.visor.Position = Vector2.new(barX - 16, infoY)
					local showAim = Library.Flags["PlayersAiming"] ~= false
					local aiming = showAim and aimingOf(player, character) or nil
					if visor ~= nil then
						infoY += 11
					end
					pack.aim.Visible = aiming ~= nil
					pack.aim.Text = aiming and "a:t" or "a:f"
					pack.aim.Size = pack.hpText.Size
					pack.aim.Font = textFont
					pack.aim.Center = true
					pack.aim.Outline = true
					pack.aim.Color = aiming and Color3.fromRGB(80, 180, 255) or Color3.fromRGB(220, 220, 220)
					pack.aim.Position = Vector2.new(barX - 16, infoY)
					drawSkeleton(pack, character, camera, flagColor("PlayersSkeletonColor", Color3.fromRGB(255, 255, 255)), showSkeleton)
					drawBody(pack, character, camera, boxColor, flagBool("PlayersBody"))
				end
			end
			end
		end
	end

	if weaponIcons then
		for _, icon in weaponIcons do
			if icon:IsA("GuiObject") and icon:GetAttribute("Seen") ~= iconStamp then
				icon.Visible = false
			end
		end
	end

	if lookList then
		lookList.Text = flagBool("LookAtYou") and table.concat(lookLines, "\n") or ""
		lookList.TextColor3 = flagColor("LookColor", Color3.fromRGB(255, 214, 64))
		if lookFrame then
			lookFrame.Visible = lookList.Text ~= ""
		end
	end

	if aimChamModel and aimChamColor and aimChamModel ~= LocalPlayer.Character then
		wanted[aimChamModel] = aimChamColor
	end
	syncChams(wanted)

	if invPanel and camera then
		if not flagBool("Inv_Enabled") then
			invPanel.Visible = false
		else
			local target, meters = closestInFov(camera)
			if not target then
				invPanel.Visible = false
				invSignature = ""
			else
				invPanel.Visible = true
				local iconSize = math.clamp(flagNum("Inv_IconSize", 64), 36, 120)
				local gridWidth = 4 * iconSize + 18
				invPanel.Size = UDim2.fromOffset(gridWidth + 16, 0)
				invPanel.AutomaticSize = Enum.AutomaticSize.Y
				if not invPanel:GetAttribute("Dragged") then
					local viewport = camera.ViewportSize
					invPanel.Position = UDim2.fromOffset(viewport.X * flagNum("Inv_X", 2) / 100, viewport.Y * flagNum("Inv_Y", 12) / 100)
				end
				invPanel.AnchorPoint = Vector2.new(0, 0)
				invPanel.BackgroundTransparency = math.clamp(flagNum("Inv_Transparency", 15), 0, 90) / 100
				if invGrid then
					invGrid.Visible = false
				end
				if invBody then
					invBody.Visible = false
				end
				invName.Text = target.Name
				invMeters.Text = string.format("%dm", math.floor(meters + 0.5))
				if os.clock() - (invCheckAt or 0) > 0.4 then
					invCheckAt = os.clock()
					local signature = inventorySignature(target) .. "|" .. tostring(iconSize)
					if signature ~= invSignature then
						invSignature = signature
						rebuildInventory(target)
					end
				end
			end
		end
	end

	if selfStats then
		if Library.Flags["PlayersKD"] ~= false then
			local _, _, myKd, reports = profileStats(LocalPlayer)
			selfStats.Text = string.format("kd%s\nreports %d", myKd and string.format("%.2f", myKd) or "--", reports or 0)
			if selfStats.Parent then
				selfStats.Parent.Visible = true
			end
		elseif selfStats.Parent then
			selfStats.Parent.Visible = false
		end
	end

	if scanFrame and scanUntil and os.clock() > scanUntil and not remotesWatched then
		scanFrame.Visible = false
	end

	if watermarkLabel then
		local staffText = #staff > 0 and table.concat(staff, ", ") or "0"
		watermarkLabel.Text = string.format(
			"midnight.cc  |  FPS: %d  |  Ping: %d  |  Cheaters: %d  |  Staff: %s",
			math.floor(fpsSmooth + 0.5),
			pingMs,
			cheatCount,
			staffText
		)
		watermarkLabel.TextTruncate = Enum.TextTruncate.None
		watermarkLabel.AutomaticSize = Enum.AutomaticSize.X
		local frame = watermarkLabel.Parent
		if frame then
			frame.AutomaticSize = Enum.AutomaticSize.X
			frame.ClipsDescendants = false
		end
	end
	if hitLog then
		local lines = {}
		if hitFeed then
			for index = #hitFeed, 1, -1 do
				local row = hitFeed[index]
				if os.clock() - row.t < 4 then
					lines[#lines + 1] = row.text
				end
			end
		end
		hitLog.Text = table.concat(lines, "\n")
		hitLog.TextColor3 = flagColor("Hit_Color", Color3.fromRGB(255, 255, 255))
		if hitBack then
			hitBack.Visible = hitLog.Text ~= ""
			if not hitBack:GetAttribute("Dragged") then
				hitBack.Position = UDim2.new(0.5, 0, 1, -250)
			end
		end
	end
end)

