function barrelScreen(camera)
	local viewmodel = camera:FindFirstChild("ViewModel")
	if not viewmodel then
		return nil
	end
	local named = nil
	local best = nil
	local bestDot = -math.huge
	local look = camera.CFrame.LookVector
	local origin = camera.CFrame.Position
	for _, obj in viewmodel:GetDescendants() do
		if obj:IsA("BasePart") then
			local name = string.lower(obj.Name)
			if string.find(name, "muzzle", 1, true) or string.find(name, "barrel", 1, true) then
				named = obj
				break
			end
			if obj:FindFirstAncestor("Item") then
				local dot = (obj.Position - origin):Dot(look)
				if dot > bestDot then
					bestDot = dot
					best = obj
				end
			end
		end
	end
	local part = named or best
	if not part then
		return nil
	end
	local screen, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen then
		return nil
	end
	return Vector2.new(screen.X, screen.Y)
end

function drawSnapline(camera)
