function drawSkeleton(pack, character, camera, color, enabled)
	local lines = pack.bones
	if not enabled then
		for _, line in lines do
			line.Visible = false
		end
		return
	end
	local links = character:FindFirstChild("UpperTorso") and BONES_R15 or BONES_R6
	local used = 0
	for _, link in links do
		local a = character:FindFirstChild(link[1]) or character:FindFirstChild(link[1], true)
		local b = character:FindFirstChild(link[2]) or character:FindFirstChild(link[2], true)
		local outline = lines[used + 1]
		local line = lines[used + 2]
		used += 2
		if outline and line and a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			local va = camera:WorldToViewportPoint(a.Position)
			local vb = camera:WorldToViewportPoint(b.Position)
			if va.Z < 0.4 or vb.Z < 0.4 then
				outline.Visible = false
				line.Visible = false
			else
				local viewport = camera.ViewportSize
				local far = math.abs(va.X) > viewport.X * 1.4 or math.abs(vb.X) > viewport.X * 1.4 or math.abs(va.Y) > viewport.Y * 1.4 or math.abs(vb.Y) > viewport.Y * 1.4
				if far or (va - vb).Magnitude > viewport.Y then
					outline.Visible = false
					line.Visible = false
				else
					local from = Vector2.new(va.X, va.Y)
					local to = Vector2.new(vb.X, vb.Y)
					outline.From = from
					outline.To = to
					outline.Color = Color3.new(0, 0, 0)
					outline.Thickness = 3
					outline.Visible = true
					line.From = from
					line.To = to
					line.Color = color
					line.Thickness = 1
					line.Visible = true
				end
			end
		else
			if outline then
				outline.Visible = false
			end
			if line then
				line.Visible = false
			end
		end
	end
	for index = used + 1, #lines do
		lines[index].Visible = false
	end
end

function drawBody(pack, character, camera, color, enabled)
	local squares = pack.limbs
	if not squares then
		return
	end
	if not enabled then
		for _, square in squares do
			square.Visible = false
		end
		return
	end
	local names = { "Head", "UpperTorso", "LowerTorso", "Torso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
	local used = 0
	for _, name in names do
		local part = character:FindFirstChild(name) or character:FindFirstChild(name, true)
		if part and part:IsA("BasePart") and used < #squares then
			used += 1
			local square = squares[used]
			local screen, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen then
				local dist = math.max((part.Position - camera.CFrame.Position).Magnitude, 1)
				local height = math.clamp(part.Size.Y / dist * camera.ViewportSize.Y * 0.9, 3, 90)
				local width = math.clamp(math.max(part.Size.X, part.Size.Z) / dist * camera.ViewportSize.Y * 0.9, 3, 90)
				square.Visible = true
				square.Color = color
				square.Size = Vector2.new(width, height)
				square.Position = Vector2.new(screen.X - width * 0.5, screen.Y - height * 0.5)
			else
				square.Visible = false
			end
		end
	end
	for index = used + 1, #squares do
		squares[index].Visible = false
	end
end

local STAT_NAMES = { "KD", "KDR", "K/D", "KillDeath", "KillDeathRatio" }
local KILL_NAMES = { "Kills", "Kill", "Eliminations", "Frags" }
local DEATH_NAMES = { "Deaths", "Death" }

function statValue(root, names)
	if not root then
		return nil
	end
	for _, name in names do
		local found = root:FindFirstChild(name, true)
		if found and found:IsA("ValueBase") then
			local number = tonumber(found.Value)
			if number then
				return number
			end
		end
		local attr = root.GetAttribute and root:GetAttribute(name)
		if type(attr) == "number" then
			return attr
		end
	end
	return nil
end

function kdOf(player)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local profile = folder and (folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId)))
	local stats = profile and profile:FindFirstChild("Status")
	stats = stats and stats:FindFirstChild("Journey")
	stats = stats and stats:FindFirstChild("WipeStatistics")
	if stats then
		local kills = tonumber(stats:GetAttribute("Kills"))
		local deaths = tonumber(stats:GetAttribute("Deaths"))
		if kills and deaths then
			if deaths <= 0 then
				return kills
			end
			return kills / deaths
		end
	end
	local direct = statValue(player, STAT_NAMES) or statValue(profile, STAT_NAMES)
	if direct then
		return direct
	end
	local kills = statValue(player, KILL_NAMES) or statValue(profile, KILL_NAMES)
	local deaths = statValue(player, DEATH_NAMES) or statValue(profile, DEATH_NAMES)
	if kills and deaths then
		if deaths <= 0 then
			return kills > 0 and kills or 0
		end
		return kills / deaths
	end
	return nil
end

