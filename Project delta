			Parent.ClipsDescendants = false
		end
	end
	if hitLog then
		local List2 = {}
		
		if hitFeed then
			for i = #hitFeed, 1, -1 do
				local HitFeedEntry = hitFeed[i]
				
				if os.clock() - HitFeedEntry.t < 4 then
					List2[#List2 + 1] = HitFeedEntry.text
				end
			end
		end
		hitLog.Text = table.concat(List2, "\n")
		hitLog.TextColor3 = flagColor("Hit_Color", Color3.fromRGB(255, 255, 255))
		
		if hitBack then
			hitBack.Visible = hitLog.Text ~= ""
			hitBack.BackgroundTransparency = if v0.Flags.Hit_Bg == false then 1 else 0.2
			
			if not hitBack:GetAttribute("Dragged") then
				hitBack.Position = UDim2.new(0.5, 0, 1, -250)
			end
		end
	end
