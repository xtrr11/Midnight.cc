function harvestMapPoints()
	local NoCollision = workspace:FindFirstChild("NoCollision")
	local ExitLocations = NoCollision and NoCollision:FindFirstChild("ExitLocations")
	
	if ExitLocations then
		local function walk(Object)
			local InstancePointResult = nil
			
			if Object:IsA("BasePart") then
				InstancePointResult = Object.Position
			elseif Object:IsA("Model") or Object:IsA("Folder") then
				InstancePointResult = instancePoint(Object)
			end
			if typeof(InstancePointResult) == "Vector3" and (Object:IsA("BasePart") or Object:IsA("Model")) then
				rememberMap(string.format("exfil:%d:%d", math.floor(InstancePointResult.X / 40), math.floor(InstancePointResult.Z / 40)), Object.Name, Color3.fromRGB(80, 220, 140), InstancePointResult)
				
				if Object:IsA("Model") then return end
			end
			if not Object:IsA("BasePart") then
				for _, child in Object:GetChildren() do
					walk(child)
				end
			end
		end
		
		for _, child in ExitLocations:GetChildren() do
