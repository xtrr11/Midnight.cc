					IsTransparencyBelow = if Item == nil then math.abs(Part.CFrame.LookVector:Dot(Head.CFrame.LookVector)) > 0.35 and Part.Transparency < 0.85 else Item
					break
				end
			end
		end
	end
	if IsTransparencyBelow == "equipped" then
