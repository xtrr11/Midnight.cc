		return nil, nil
	end
	local bestY, loaded, capacity = -1, nil, nil
	for _, label in playerGui:GetDescendants() do
		if label:IsA("TextLabel") and label.Visible then
			local current, maxAmmo = string.match(label.Text, "^(%d+)%s*/%s*(%d+)$")
			current, maxAmmo = tonumber(current), tonumber(maxAmmo)
			if current and maxAmmo and maxAmmo > 0 and maxAmmo <= 250 and label.AbsolutePosition.Y > bestY then
