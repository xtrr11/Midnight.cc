function playingReload()
	local function from(animator)
		if not animator then
			return nil
		end
		for _, track in animator:GetPlayingAnimationTracks() do
			local anim = track.Animation
			local name = anim and string.lower(anim.Name) or ""
			if string.find(name, "reload", 1, true) and track.Length > 0 then
				return track
			end
		end
		return nil
	end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local track = from(humanoid and humanoid:FindFirstChildOfClass("Animator"))
	if track then
		return track
	end
	local camera = workspace.CurrentCamera
	if camera then
		for _, child in camera:GetDescendants() do
			if child:IsA("Animator") then
				track = from(child)
				if track then
					return track
				end
			end
		end
	end
	return nil
end

function rememberPart(part)
	if part:GetAttribute("MidnightGunSaved") then
		return
	end
	part:SetAttribute("MidnightGunSaved", true)
	part:SetAttribute("MidnightGunColor", part.Color)
	part:SetAttribute("MidnightGunMaterial", part.Material.Name)
	if part:IsA("MeshPart") then
		part:SetAttribute("MidnightGunTexture", part.TextureID)
	end
end

local function restorePart(part)
	if not part:GetAttribute("MidnightGunSaved") then
		return
	end
	local color = part:GetAttribute("MidnightGunColor")
	if typeof(color) == "Color3" then
		part.Color = color
	end
	local material = part:GetAttribute("MidnightGunMaterial")
	if type(material) == "string" then
		pcall(function()
			part.Material = Enum.Material[material]
		end)
	end
	if part:IsA("MeshPart") then
		local texture = part:GetAttribute("MidnightGunTexture")
		if type(texture) == "string" then
			part.TextureID = texture
		end
	end
	part:SetAttribute("MidnightGunSaved", nil)
end

local function paintPart(part, color, materialName)
	rememberPart(part)
	paintedGuns[part] = true
	part.Color = color
	pcall(function()
		part.Material = Enum.Material[materialName]
	end)
end

function armPart(part)
	local name = string.lower(part.Name)
	return string.find(name, "arm", 1, true) or string.find(name, "hand", 1, true) or string.find(name, "sleeve", 1, true)
