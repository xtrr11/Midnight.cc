function patchHealItems()
	healBase = healBase or {}
	local InstantHeal = flagBool("InstantHeal")
	local Names = {}
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	for _, child in ReplicatedStorage:GetChildren() do
		local Lowered = string.lower(child.Name)
		
		if string.find(Lowered, "item", 1, true) or string.find(Lowered, "med", 1, true) or string.find(Lowered, "consum", 1, true) or string.find(Lowered, "gear", 1, true) or string.find(Lowered, "hand", 1, true) then
			Names[#Names + 1] = child
		end
	end
	local Players = ReplicatedStorage:FindFirstChild("Players")
	local Name = Players and Players:FindFirstChild(LocalPlayer.Name)
	
	if Name then
		Names[#Names + 1] = Name
	end
	
	local function remember(Text, Number)
		if healBase[Text] == nil then
			healBase[Text] = Number
		end
		return if InstantHeal then 0.05 else healBase[Text]
	end
	
	local function patchModule(ModuleScript)
		local Parent = ModuleScript.Parent
		
		if not Parent or not isHealName(Parent.Name) then return end
		local Success, Result = pcall(require, ModuleScript)
		
		if not Success or type(Result) ~= "table" then return end
		for i, value in Result do
			if type(i) == "string" and type(value) == "number" and value > 0.12 and value < 60 and isDurationKey(i) then
				Result[i] = remember(ModuleScript:GetFullName() .. ":" .. i, value)
			end
		end
	end
	
	local function visit(Object)
		if Object:IsA("ModuleScript") and string.lower(Object.Name) == "settingsmodule" then
			patchModule(Object)
			
			return
		end
		if not isHealName(Object.Name) then return end
		for attributeName, attribute in Object:GetAttributes() do
			if type(attribute) == "number" and attribute > 0 and isDurationKey(attributeName) then
				Object:SetAttribute(attributeName, remember(Object:GetFullName() .. ":" .. attributeName, attribute))
			end
		end
		for _, child in Object:GetChildren() do
			if child:IsA("ValueBase") and isDurationKey(child.Name) then
				local Number = tonumber(child.Value)
				
				if Number and Number > 0 then
					child.Value = remember(child:GetFullName(), Number)
				end
			end
		end
	end
	
	for _, name in Names do
		visit(name)
		
		for _, descendant in name:GetDescendants() do
			visit(descendant)
		end
	end
end

