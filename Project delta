function box2d(character, camera)
	local root = rootPart(character)
	if not root then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		head = character:FindFirstChild("Head", true)
	end
	local topPos = (head and head:IsA("BasePart")) and (head.Position + Vector3.new(0, math.max(head.Size.Y, 1) * 0.55, 0)) or (root.Position + Vector3.new(0, 2.6, 0))
	local bottomPos = root.Position - Vector3.new(0, 3, 0)
	local foot = character:FindFirstChild("LeftFoot") or character:FindFirstChild("RightFoot") or character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
	if not (foot and foot:IsA("BasePart")) then
		foot = character:FindFirstChild("LeftFoot", true) or character:FindFirstChild("RightFoot", true)
	end
	if foot and foot:IsA("BasePart") then
		bottomPos = foot.Position - Vector3.new(0, foot.Size.Y * 0.45, 0)
	end
	local top = camera:WorldToViewportPoint(topPos)
	local bottom = camera:WorldToViewportPoint(bottomPos)
	if top.Z < 0.2 or bottom.Z < 0.2 then
		return nil
	end
	local height = math.abs(bottom.Y - top.Y)
	if height < 4 then
		return nil
	end
	local width = math.max(height * 0.55, 6)
	local centerX = (top.X + bottom.X) * 0.5
	local topY = math.min(top.Y, bottom.Y)
	local left = centerX - width * 0.5
	local viewport = camera.ViewportSize
	if left > viewport.X + 80 or left + width < -80 or topY > viewport.Y + 80 or topY + height < -80 then
		return nil
	end
	return left, topY, width, height
end

function vehicleBox(model, camera)
	local function boundsOf(inst)
		if inst:IsA("BasePart") then
			return inst.CFrame, inst.Size
		end
		if inst:IsA("Model") then
			local ok, boxCf, boxSize = pcall(inst.GetBoundingBox, inst)
			if ok and typeof(boxCf) == "CFrame" and typeof(boxSize) == "Vector3" then
				return boxCf, boxSize
			end
		end
		return nil, nil
	end
	local cf, size
	local best = 0
	local current = model
	for _ = 1, 5 do
		if not current or current == workspace or current == game then
			break
		end
		local boxCf, boxSize = boundsOf(current)
		if boxCf and boxSize then
			local longest = math.max(boxSize.X, boxSize.Y, boxSize.Z)
			if longest > best and longest < 220 then
				best = longest
				cf = boxCf
				size = boxSize
			end
		end
		current = current.Parent
	end
	if not cf then
		local minV = Vector3.new(math.huge, math.huge, math.huge)
		local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
		local found = false
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				found = true
				local half = part.Size * 0.5
				local partCf = part.CFrame
				local samples = { Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1), Vector3.new(1, -1, -1), Vector3.new(1, -1, 1), Vector3.new(1, 1, -1), Vector3.new(1, 1, 1) }
				for _, corner in samples do
					local point = partCf:PointToWorldSpace(half * corner)
					minV = Vector3.new(math.min(minV.X, point.X), math.min(minV.Y, point.Y), math.min(minV.Z, point.Z))
					maxV = Vector3.new(math.max(maxV.X, point.X), math.max(maxV.Y, point.Y), math.max(maxV.Z, point.Z))
				end
			end
		end
		if found then
			cf = CFrame.new((minV + maxV) * 0.5)
			size = maxV - minV
		end
	end
	if not cf or not size then
		return nil
	end
	local half = size * 0.5
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local viewport = camera.ViewportSize
	local points = { Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1), Vector3.new(1, -1, -1), Vector3.new(1, -1, 1), Vector3.new(1, 1, -1), Vector3.new(1, 1, 1) }
	for _, corner in points do
		local screen = camera:WorldToViewportPoint(cf:PointToWorldSpace(half * corner))
		local sx, sy = screen.X, screen.Y
		if screen.Z <= 0.05 then
			local cx = viewport.X * 0.5
			local cy = viewport.Y * 0.5
			local dx = cx - screen.X
			local dy = cy - screen.Y
			local mag = math.sqrt(dx * dx + dy * dy)
			local reach = math.max(viewport.X, viewport.Y)
			if mag < 1 then
				sx, sy = cx, 0
			else
				sx = cx + dx / mag * reach
				sy = cy + dy / mag * reach
			end
		end
		if sx < minX then
			minX = sx
		end
		if sx > maxX then
			maxX = sx
		end
		if sy < minY then
			minY = sy
		end
		if sy > maxY then
			maxY = sy
		end
	end
	if maxX < -80 or minX > viewport.X + 80 or maxY < -80 or minY > viewport.Y + 80 then
		return nil
	end
	return minX, minY, math.max(maxX - minX, 10), math.max(maxY - minY, 10)
end

function drawEspBox(pack, x, y, w, h, color, style, visible)
	local cornersOn = visible and style == "Corners"
	pack.outline.Visible = visible and not cornersOn
	pack.box.Visible = visible and not cornersOn
	if visible and not cornersOn then
		pack.outline.Position = Vector2.new(x - 1, y - 1)
		pack.outline.Size = Vector2.new(w + 2, h + 2)
		pack.outline.Color = Color3.new(0, 0, 0)
		pack.outline.Thickness = 3
		pack.outline.Filled = false
		pack.box.Position = Vector2.new(x, y)
		pack.box.Size = Vector2.new(w, h)
		pack.box.Color = color
		pack.box.Thickness = 1
		pack.box.Filled = false
	end
	local lines = pack.corners
	if not lines then
		return
	end
	if not cornersOn then
		for _, line in lines do
			line.Visible = false
		end
		return
	end
	local len = math.clamp(math.min(w, h) * 0.28, 4, 28)
	local segs = {
		{ x, y, x + len, y },
		{ x, y, x, y + len },
		{ x + w, y, x + w - len, y },
		{ x + w, y, x + w, y + len },
		{ x, y + h, x + len, y + h },
		{ x, y + h, x, y + h - len },
		{ x + w, y + h, x + w - len, y + h },
		{ x + w, y + h, x + w, y + h - len },
	}
	for index = 1, 8 do
		local seg = segs[index]
		local outline = lines[index]
		local inner = lines[index + 8]
		if outline then
			outline.Visible = true
			outline.Color = Color3.new(0, 0, 0)
			outline.Thickness = 3
			outline.From = Vector2.new(seg[1], seg[2])
			outline.To = Vector2.new(seg[3], seg[4])
		end
		if inner then
			inner.Visible = true
			inner.Color = color
			inner.Thickness = 1
			inner.From = Vector2.new(seg[1], seg[2])
			inner.To = Vector2.new(seg[3], seg[4])
		end
	end
end

