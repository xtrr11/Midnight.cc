			if Inventory then
				local function walk(Inventory, p333)
					if p333 > 7 then return end
					local NameHitResult = nameHit(Inventory.Name)
					
					if NameHitResult then
						Names[NameHitResult] = Inventory.Name
					end
					for _, child in Inventory:GetChildren() do
						walk(child, p333 + 1)
					end
				end
				
				walk(Inventory, 0)
			end
			local List = {}
			
			for name in Names do
				List[#List + 1] = name
			end
			if #List > 0 then
				table.sort(List)
				local _, _, ProfileStatsResult3, ProfileStatsResult4, ProfileStatsResult5 = profileStats(player)
				t[#t + 1] = string.format("%s | %s | age %dd | kd %s | %s", player.Name, table.concat(List, ", "), player.AccountAge, ProfileStatsResult3 and string.format("%.2f", ProfileStatsResult3) or "--", ProfileStatsResult5 and string.format("%.0fh", ProfileStatsResult5) or (ProfileStatsResult4 and "reports " .. ProfileStatsResult4 or "--"))
			end
		end
	end
	if #t == 0 then
