function itemLabel(entry)
	local props = entry:FindFirstChild("ItemProperties")
	if props then
		local call = props:GetAttribute("CallSign")
		if type(call) == "string" and call ~= "" then
			return call
		end
	end
	if entry:IsA("StringValue") and type(entry.Value) == "string" and entry.Value ~= "" then
		return entry.Value
	end
	if entry:IsA("ObjectValue") and entry.Value then
		return entry.Value.Name
	end
	return entry.Name
end

local guiIconCache = {}

function guiIcon(name)
	if guiIconCache[name] ~= nil then
		return guiIconCache[name] or nil
	end
	local found = nil
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, object in playerGui:GetDescendants() do
			if object:IsA("TextLabel") and object.Text == name and object.Parent then
				local image = object.Parent:FindFirstChildWhichIsA("ImageLabel", true)
				if image and image.Image ~= "" then
					found = image.Image
					break
				end
			end
		end
	end
	guiIconCache[name] = found or false
	return found
end

function addInvSlot(order, entry)
	local slot = Instance.new("Frame")
	slot.LayoutOrder = order
	slot.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	slot.BorderSizePixel = 0
	slot.Parent = invGrid
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(58, 58, 58)
	stroke.Parent = slot
	local label = itemLabel(entry)
	local image = iconOf(entry) or guiIcon(label) or guiIcon(entry.Name)
	local shown = false
	if image then
		local icon = Instance.new("ImageLabel")
		icon.BackgroundTransparency = 1
		icon.Size = UDim2.fromScale(1, 1)
		icon.ScaleType = Enum.ScaleType.Fit
		icon.Image = image
		icon.Parent = slot
		shown = true
	else
		local source = entry
		local hasPart = entry:IsA("BasePart") or entry:FindFirstChildWhichIsA("BasePart", true)
		if not hasPart then
			source = templateFor(label) or templateFor(entry.Name) or entry
		end
		local view = Instance.new("ViewportFrame")
		view.BackgroundTransparency = 1
		view.Size = UDim2.fromScale(1, 1)
		view.Ambient = Color3.fromRGB(210, 210, 210)
		view.LightColor = Color3.fromRGB(255, 255, 255)
		view.Parent = slot
		shown = frameModel(view, source)
		if not shown then
			local copied = false
			pcall(function()
				local mesh = source:FindFirstChildWhichIsA("MeshPart", true)
				if not mesh then
					return
				end
				local cloned = mesh:Clone()
				cloned.Anchored = true
				cloned.Parent = view
				local cam = Instance.new("Camera")
				cam.FieldOfView = 30
				cam.CFrame = CFrame.new(cloned.Position + Vector3.new(cloned.Size.Magnitude, cloned.Size.Magnitude * 0.4, cloned.Size.Magnitude), cloned.Position)
				cam.Parent = view
				view.CurrentCamera = cam
				copied = true
			end)
			shown = copied
			if not shown then
				view:Destroy()
			end
		end
	end
	if not shown then
		slot:Destroy()
		return
	end
	invSlots[#invSlots + 1] = slot
end

function listIcon(name)
	if type(name) ~= "string" or name == "" then
		return ""
	end
	iconCache = iconCache or {}
	local cached = iconCache["list:" .. name]
	if type(cached) == "string" then
		return cached
	end
	local function thumb(id)
		return "rbxthumb://type=Asset&id=" .. tostring(math.floor(tonumber(id))) .. "&w=150&h=150"
	end
	local function asset(value)
		if type(value) == "number" and value > 1000 then
			return thumb(value)
		end
		if type(value) ~= "string" or value == "" then
			return ""
		end
		if string.find(value, "rbxthumb://", 1, true) then
			return value
		end
		local id = string.match(value, "(%d%d%d%d%d%d+)")
		if id and (string.find(value, "rbxasset", 1, true) or string.find(value, "id=", 1, true) or tonumber(value)) then
			return thumb(id)
		end
		if string.find(value, "rbxasset", 1, true) then
			return value
		end
		return ""
	end
	local function read(inst)
		if typeof(inst) ~= "Instance" then
			return ""
		end
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			local image = asset(inst.Image)
			if image ~= "" then
				return image
			end
		end
		if inst:IsA("Decal") or inst:IsA("Texture") then
			local image = asset(inst.Texture)
			if image ~= "" then
				return image
			end
		end
		if inst:IsA("StringValue") or inst:IsA("NumberValue") or inst:IsA("IntValue") then
			local image = asset(inst.Value)
			if image ~= "" then
				return image
			end
		end
		for attribute, value in inst:GetAttributes() do
			local image = asset(value)
			if image ~= "" and (type(value) == "number" or string.find(string.lower(attribute), "icon", 1, true) or string.find(string.lower(attribute), "image", 1, true) or (type(value) == "string" and string.find(value, "rbxasset", 1, true))) then
				return image
			end
		end
		local ok, content = pcall(function()
			return inst.ImageContent
		end)
		if ok and content ~= nil then
			local image = asset(tostring(content))
			if image ~= "" then
				return image
			end
		end
		return ""
	end
	local list = game:GetService("ReplicatedStorage"):FindFirstChild("ItemsList")
	local item = list and (list:FindFirstChild(name) or list:FindFirstChild(name, true))
	if not item and list then
		local lower = string.lower(name)
		for _, child in list:GetChildren() do
			if string.lower(child.Name) == lower then
				item = child
				break
			end
		end
	end
	local image = ""
	if item then
		local icon = item:FindFirstChild("Icon", true) or item:FindFirstChild("ItemIcon", true) or item:FindFirstChild("Thumbnail", true)
		image = read(icon)
		if image == "" then
			image = read(item)
		end
		if image == "" then
			for _, child in item:GetDescendants() do
				local blob = string.lower(child.Name)
				if blob == "icon" or string.find(blob, "icon", 1, true) or child:IsA("ImageLabel") or child:IsA("ImageButton") then
					image = read(child)
					if image ~= "" then
						break
					end
				end
			end
		end
		if image == "" then
			local props = item:FindFirstChild("ItemProperties") or item:FindFirstChildWhichIsA("ModuleScript")
			if props and props:IsA("ModuleScript") then
				local ok, data = pcall(require, props)
				if ok and type(data) == "table" then
					image = asset(data.Icon or data.Image or data.IconId or data.Thumbnail or data.AssetId)
				end
			end
		end
	end
	iconCache["list:" .. name] = image
	return image
end

