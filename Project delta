end

function showPartThrough(part, color, style, intensity)
	local highlight = part:FindFirstChild("MidnightWalls")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "MidnightWalls"
		highlight.Adornee = part
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = part
	end
	local solid = math.clamp(intensity or 70, 10, 100) / 100
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = style == "Glass" and (0.25 + (1 - solid) * 0.55) or (1 - solid)
	highlight.OutlineTransparency = style == "Glow" and 0 or math.clamp(0.4 - solid * 0.4, 0, 0.8)
	highlight.Enabled = true
end

function applySplit(character, camera, visibleColor, hiddenColor, through)
	paintCharacter(character, visibleColor)
	local state = charState[character]
	if not state or not camera then
		return
	end
	local style = Library.Flags["PlayersChamStyle"] or "ForceField"
	local intensity = flagNum("PlayersChamIntensity", 70)
	for _, part in state.parts do
		if part.Parent then
			if partVisible(part, camera) then
				applyForce(part, visibleColor, style, intensity)
				hideSurfaces(part)
				clearPartHighlight(part)
			elseif through then
				applyForce(part, hiddenColor, style, intensity)
				hideSurfaces(part)
				showPartThrough(part, hiddenColor, style, intensity)
			else
				showOriginal(part)
				clearPartHighlight(part)
			end
		end
	end
end

local STAFF_GROUP = 3765739
local STAFF_WORDS = { "admin", "mod", "staff", "dev", "owner", "manager", "creator", "head", "helper", "support", "trial" }
local staffCache = {}

function roleIsStaff(role, rank)
	if type(rank) == "number" and rank >= 200 then
		return true
	end
	if type(role) ~= "string" then
		return false
	end
	local lower = role:lower()
	if lower == "" or lower == "guest" or lower == "member" or lower == "fan" then
		return false
	end
	for _, word in STAFF_WORDS do
		if string.find(lower, word, 1, true) then
			return true
		end
	end
	return false
end

function staffOf(player)
	if player.UserId == game.CreatorId or player.UserId == game.PrivateServerOwnerId then
		return "Owner"
	end
	for _, attribute in { "Admin", "Moderator", "Staff", "IsStaff", "IsAdmin", "IsMod" } do
		local value = player:GetAttribute(attribute)
		if value == true then
			return attribute
		end
		if type(value) == "string" and value ~= "" then
			return value
		end
		if type(value) == "number" and value > 0 then
			return attribute
		end
	end
	local cached = staffCache[player]
	if cached == nil then
		staffCache[player] = false
		task.spawn(function()
			local okRole, role = pcall(function()
				return player:GetRoleInGroup(STAFF_GROUP)
			end)
			local okRank, rank = pcall(function()
				return player:GetRankInGroup(STAFF_GROUP)
			end)
			if okRole and roleIsStaff(role, okRank and rank or 0) then
				staffCache[player] = role
			end
		end)
		return nil
	end
	if cached == false then
		return nil
	end
	return cached
end

