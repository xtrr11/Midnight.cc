function scanInventories()
	local picked = Library.Flags["ScanItems"]
	if type(picked) ~= "table" or #picked == 0 then
		showScan("Inventory scan", { "select items first" })
		return
	end
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local lines = {}
	local function nameHit(itemName)
		local lower = string.lower(itemName)
		local matched = nil
		for _, label in picked do
			local keys = SCAN_ITEM_KEYS and SCAN_ITEM_KEYS[label]
			if keys then
				for _, key in keys do
					if string.find(lower, key, 1, true) then
						matched = label
						break
					end
				end
			end
			if matched then
				break
			end
		end
		return matched
	end
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and folder then
			local profile = folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId))
			local inventory = profile and profile:FindFirstChild("Inventory")
			local found = {}
			if inventory then
				local function walk(inst, depth)
					if depth > 7 then
						return
					end
					local label = nameHit(inst.Name)
					if label then
						found[label] = inst.Name
					end
					for _, child in inst:GetChildren() do
						walk(child, depth + 1)
					end
				end
				walk(inventory, 0)
			end
			local names = {}
			for label in found do
				names[#names + 1] = label
			end
			if #names > 0 then
				table.sort(names)
				local _, _, kd, reports, hours = profileStats(player)
				lines[#lines + 1] = string.format("%s | %s | age %dd | kd %s | %s", player.Name, table.concat(names, ", "), player.AccountAge, kd and string.format("%.2f", kd) or "--", hours and string.format("%.0fh", hours) or (reports and ("reports " .. reports) or "--"))
			end
		end
	end
	if #lines == 0 then
		lines[1] = "none"
	end
	showScan("Items " .. tostring(lines[1] == "none" and 0 or #lines), lines)
end

