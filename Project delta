function addInvBox(parent, order, info, size)
	if not parent then
		return
	end
	local box = Instance.new("Frame")
	box.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
	box.BorderSizePixel = 0
	box.LayoutOrder = order
	box.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = info.color or Color3.fromRGB(90, 90, 90)
	stroke.Thickness = info.attach and 1 or 1.5
	stroke.Parent = box
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.ScaleType = Enum.ScaleType.Fit
	img.Image = listIcon(info.name)
	img.Parent = box
	local function tag(text, anchor, pos, width)
		local label = Instance.new("TextLabel")
		label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		label.BackgroundTransparency = 0.25
		label.BorderSizePixel = 0
		label.AnchorPoint = anchor
		label.Position = pos
		label.Size = UDim2.fromOffset(width, 14)
		label.Font = Enum.Font.Code
		label.TextSize = math.clamp(math.floor(size * 0.2), 10, 14)
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Text = text
		label.Parent = box
	end
	if info.amount and info.amount > 1 then
		tag("x" .. tostring(info.amount), Vector2.new(1, 1), UDim2.new(1, -2, 1, -2), math.max(28, math.floor(size * 0.45)))
	end
	if info.durability then
		tag(tostring(info.durability) .. "%", Vector2.new(0, 1), UDim2.new(0, 2, 1, -2), math.max(32, math.floor(size * 0.5)))
	end
	if info.ammo and info.ammo > 0 then
		tag(tostring(info.ammo), Vector2.new(1, 0), UDim2.new(1, -2, 0, 2), math.max(24, math.floor(size * 0.4)))
	end
	invRowPool[#invRowPool + 1] = box
end

function rebuildInventory(player)
	if invGrid then
		invGrid.Visible = false
	end
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local profile = folder and (folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId)))
	local function colorFor(name, kind)
		local lower = string.lower(name)
		local function pick(flag, r, g, b)
			local color = flagColor(flag, Color3.fromRGB(r, g, b))
			return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
		end
		if kind == "gun" then
			return pick("InvColor_Gun", 255, 80, 80)
		end
		if kind == "armor" then
			return pick("InvColor_Armor", 90, 170, 255)
		end
		if string.find(lower, "med", 1, true) or string.find(lower, "bandage", 1, true) or string.find(lower, "ifak", 1, true) or string.find(lower, "salewa", 1, true) or string.find(lower, "splint", 1, true) or string.find(lower, "morphine", 1, true) or string.find(lower, "stim", 1, true) or string.find(lower, "blood", 1, true) or string.find(lower, "grizzly", 1, true) or string.find(lower, "pain", 1, true) or string.find(lower, "heal", 1, true) then
			return pick("InvColor_Heal", 80, 255, 130)
		end
		if string.find(lower, "ammo", 1, true) or string.find(lower, "7.62", 1, true) or string.find(lower, "5.56", 1, true) or string.find(lower, "9x", 1, true) or string.find(lower, "12g", 1, true) or string.find(lower, ".45", 1, true) then
			return pick("InvColor_Ammo", 255, 210, 80)
		end
		if string.find(lower, "key", 1, true) then
			return pick("InvColor_Key", 255, 150, 60)
		end
		if string.find(lower, "mre", 1, true) or string.find(lower, "water", 1, true) or string.find(lower, "food", 1, true) or string.find(lower, "can", 1, true) then
			return pick("InvColor_Food", 255, 170, 90)
		end
		return pick("InvColor_Other", 220, 220, 220)
	end
	local function tint(text, r, g, b)
		return string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, (text:gsub("<", "")))
	end
	local lines = {}
	local function pushGroup(title, rows)
		lines[#lines + 1] = tint(title, 255, 255, 255)
		if #rows == 0 then
			lines[#lines + 1] = tint("- none", 140, 140, 140)
		else
			for _, row in rows do
				lines[#lines + 1] = row
			end
		end
	end
	local weapons = {}
	local armor = {}
	local bags = {}
	local other = {}
	local armorItems = {}
	local gunItems = {}
	local medItems = {}
	local function isMed(name)
		local lower = string.lower(name)
		return string.find(lower, "med", 1, true) or string.find(lower, "bandage", 1, true) or string.find(lower, "ifak", 1, true) or string.find(lower, "salewa", 1, true) or string.find(lower, "splint", 1, true) or string.find(lower, "morphine", 1, true) or string.find(lower, "stim", 1, true) or string.find(lower, "blood", 1, true) or string.find(lower, "grizzly", 1, true) or string.find(lower, "heal", 1, true)
	end
	local weaponSlots = { ItemBack1 = 1, ItemBack2 = 2, ItemHip1 = 3, Melee = 4 }
	local armorSlots = {
		ClothingHeadware = true,
		ClothingChestRig = true,
		ClothingMask = true,
		ClothingLegArmor = true,
		ClothingPants = true,
		ClothingShirt = true,
		ClothingGloves = true,
		ClothingBoots = true,
	}
	local function loadedAmmo(item)
		local amount = item:GetAttribute("LoadedAmmo")
		if amount ~= nil then
			return amount
		end
		local attachments = item:FindFirstChild("Attachments")
		if attachments then
			for _, attachment in attachments:GetChildren() do
				local ammo = attachment:GetAttribute("LoadedAmmo")
				if ammo ~= nil then
					return ammo
				end
			end
		end
		return 0
	end
	local function takeItem(item)
		local slot = tostring(item:GetAttribute("Slot") or item:GetAttribute("SlotType") or "")
		local weaponIndex = weaponSlots[slot]
		if weaponIndex then
			local durability = tonumber(item:GetAttribute("Durability")) or 1
			local maxDurability = tonumber(item:GetAttribute("MaxDurability")) or 1
			local percent = maxDurability > 0 and math.floor(durability / maxDurability * 100) or 100
			local attachments = {}
			local folder = item:FindFirstChild("Attachments")
			if folder then
				for _, attachment in folder:GetChildren() do
					local realItem = attachment:FindFirstChild("ItemProperties") or attachment:GetAttribute("Slot") or attachment:GetAttribute("SlotType")
					if realItem and not attachment:IsA("BasePart") and not attachment:IsA("Attachment") then
						local slotName = string.lower(tostring(attachment:GetAttribute("SlotType") or attachment:GetAttribute("Slot") or attachment.Name))
						local wantedSlot = string.find(slotName, "mag", 1, true) or string.find(slotName, "optic", 1, true) or string.find(slotName, "sight", 1, true) or string.find(slotName, "scope", 1, true) or string.find(slotName, "muzzle", 1, true) or string.find(slotName, "suppress", 1, true) or string.find(slotName, "silencer", 1, true)
						local partSlot = string.find(slotName, "stock", 1, true) or string.find(slotName, "grip", 1, true) or string.find(slotName, "handguard", 1, true) or string.find(slotName, "bayonet", 1, true) or string.find(slotName, "receiver", 1, true) or string.find(slotName, "barrel", 1, true) or string.find(slotName, "dust", 1, true)
						if wantedSlot and not partSlot then
							attachments[#attachments + 1] = attachment.Name
						end
					end
				end
			end
			weapons[weaponIndex] = {
				name = item.Name,
				durability = percent,
				ammo = tonumber(loadedAmmo(item)) or 0,
				color = Color3.fromRGB(colorFor(item.Name, "gun")),
				attachments = attachments,
			}
			gunItems[weaponIndex] = item
			if isMed(item.Name) then
				medItems[#medItems + 1] = item
			end
		elseif armorSlots[slot] or string.find(string.lower(slot), "cloth", 1, true) then
			armor[#armor + 1] = {
				name = item.Name,
				amount = tonumber(item:GetAttribute("Amount")) or 1,
				color = Color3.fromRGB(colorFor(item.Name, "armor")),
			}
			armorItems[#armorItems + 1] = item
		else
			other[#other + 1] = {
				name = item.Name,
				amount = tonumber(item:GetAttribute("Amount")) or 1,
				color = Color3.fromRGB(colorFor(item.Name, "other")),
			}
		end
		local inside = item:FindFirstChild("Inventory")
		if inside and #inside:GetChildren() > 0 then
			bags[#bags + 1] = {
				name = item.Name,
				amount = tonumber(item:GetAttribute("Amount")) or 1,
				color = Color3.fromRGB(colorFor(item.Name, "other")),
			}
			for _, subitem in inside:GetChildren() do
				local amount = tonumber(subitem:GetAttribute("Amount")) or 1
				bags[#bags + 1] = {
					name = subitem.Name,
					amount = amount,
					color = Color3.fromRGB(colorFor(subitem.Name, "other")),
				}
				if weaponIndex and isMed(subitem.Name) then
					medItems[#medItems + 1] = subitem
				end
			end
		end
	end
	local inventory = profile and profile:FindFirstChild("Inventory")
	if inventory then
		for _, item in inventory:GetChildren() do
			takeItem(item)
		end
	end
	local clothing = profile and profile:FindFirstChild("Clothing")
	if clothing then
		for _, item in clothing:GetChildren() do
			armor[#armor + 1] = {
				name = item.Name,
				amount = tonumber(item:GetAttribute("Amount")) or 1,
				color = Color3.fromRGB(colorFor(item.Name, "armor")),
			}
			armorItems[#armorItems + 1] = item
			local inside = item:FindFirstChild("Inventory")
			if inside and #inside:GetChildren() > 0 then
				for _, subitem in inside:GetChildren() do
					bags[#bags + 1] = {
						name = subitem.Name,
						amount = tonumber(subitem:GetAttribute("Amount")) or 1,
						color = Color3.fromRGB(colorFor(subitem.Name, "other")),
					}
				end
			end
		end
	end
	local hotbar = {}
	for index = 1, 4 do
		if weapons[index] then
			hotbar[#hotbar + 1] = weapons[index]
		end
	end
	local size = math.clamp(flagNum("Inv_IconSize", 64), 36, 120)
	local columns = 4
	local width = columns * size + (columns - 1) * 6
	if invGridLayout then
		invGridLayout.CellSize = UDim2.fromOffset(size, size)
	end
	if invRows then
		invRows.Size = UDim2.fromOffset(width, 0)
	end
	if invPanel then
		invPanel.Size = UDim2.fromOffset(width + 16, 0)
	end
	local order = 0
	local function showGroup(title, rows)
		order += 1
		local wrap = Instance.new("Frame")
		wrap.BackgroundTransparency = 1
		wrap.BorderSizePixel = 0
		wrap.Size = UDim2.fromOffset(width, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.LayoutOrder = order
		wrap.Parent = invRows
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 4)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = wrap
		local header = Instance.new("TextLabel")
		header.BackgroundTransparency = 1
		header.Size = UDim2.new(1, 0, 0, 16)
		header.Font = Enum.Font.Code
		header.TextSize = 13
		header.TextXAlignment = Enum.TextXAlignment.Left
		header.TextColor3 = Color3.fromRGB(255, 255, 255)
		header.Text = title
		header.LayoutOrder = 1
		header.Parent = wrap
		if #rows == 0 then
			local empty = Instance.new("TextLabel")
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, 14)
			empty.Font = Enum.Font.Code
			empty.TextSize = 12
			empty.TextXAlignment = Enum.TextXAlignment.Left
			empty.TextColor3 = Color3.fromRGB(140, 140, 140)
			empty.Text = "none"
			empty.LayoutOrder = 2
			empty.Parent = wrap
		else
			local gridFrame = Instance.new("Frame")
			gridFrame.BackgroundTransparency = 1
			gridFrame.BorderSizePixel = 0
			gridFrame.Size = UDim2.fromOffset(width, 0)
			gridFrame.AutomaticSize = Enum.AutomaticSize.Y
			gridFrame.LayoutOrder = 2
			gridFrame.Parent = wrap
			local grid = Instance.new("UIGridLayout")
			grid.CellPadding = UDim2.fromOffset(6, 6)
			grid.CellSize = UDim2.fromOffset(size, size)
			grid.SortOrder = Enum.SortOrder.LayoutOrder
			grid.FillDirectionMaxCells = 4
			grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
			grid.Parent = gridFrame
			local cell = 0
			for _, row in rows do
				cell += 1
				addInvBox(gridFrame, cell, row, size)
				if row.attachments then
					for _, attachmentName in row.attachments do
						cell += 1
						addInvBox(gridFrame, cell, { name = attachmentName, attach = true, color = Color3.fromRGB(170, 170, 170) }, size)
					end
				end
			end
		end
		invRowPool[#invRowPool + 1] = wrap
	end
	clearInvRows()
	showGroup("Hotbar", hotbar)
	showGroup("Armor", armor)
	showGroup("Backpack", bags)
	showGroup("Other", other)
	if invBody then
		invBody.Visible = false
	end
end

function inventorySignature(player)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("Players")
	local profile = folder and (folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId)))
	if not profile then
		return player.Name
	end
	local names = { player.Name }
	local count = 0
	for _, entry in profile:GetDescendants() do
		if entry:FindFirstChild("ItemProperties") or entry:IsA("StringValue") then
			count += 1
			local props = entry:FindFirstChild("ItemProperties")
			names[#names + 1] = entry.Name .. tostring(entry:GetAttribute("Amount") or "") .. tostring(entry:GetAttribute("Durability") or "") .. tostring(entry:GetAttribute("LoadedAmmo") or "")
			if count > 120 then
				break
			end
		end
	end
	names[#names + 1] = tostring(count)
	return table.concat(names, "|")
end

function closestInFov(camera)
	local radius = silentRadius()
	local center = camera.ViewportSize * 0.5
	local origin = camera.CFrame.Position
	local best, bestScreen, bestMeters = nil, math.huge, 0
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local part = player.Character:FindFirstChild("Head") or rootPart(player.Character)
			if humanoid and humanoid.Health > 0 and part then
				local screen, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local flat = (Vector2.new(screen.X, screen.Y) - center).Magnitude
					if flat <= radius and flat < bestScreen then
						local root = rootPart(player.Character)
						best = player
						bestScreen = flat
						bestMeters = root and (root.Position - origin).Magnitude * 0.28 or 0
					end
				end
			end
		end
	end
	return best, bestMeters
end

