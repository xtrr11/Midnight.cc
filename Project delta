function muteSprintAnims(p367, Object)
	sprintIds = sprintIds or {}
	local ClockTime = os.clock()
	
	if ClockTime - (sprintScanTime or 0) > 0.4 then
		sprintScanTime = ClockTime
		sprintAnims = {}
		
		local function collect(ViewModel)
			if not ViewModel then return end
			for _, descendant in ViewModel:GetDescendants() do
				if descendant:IsA("Animation") then
					if string.find(string.lower(descendant.Name .. " " .. (descendant.Parent and descendant.Parent.Name or "")), "sprint", 1, true) and descendant.AnimationId ~= "" then
						sprintIds[descendant.AnimationId] = true
					end
				elseif descendant:IsA("Animator") then
					sprintAnims[#sprintAnims + 1] = descendant
				end
			end
		end
		
		collect(p367)
		collect(Object and (Object:FindFirstChild("ViewModel") or Object:FindFirstChild("Viewmodel")) or Object)
	end
	local IsKeyDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	
	for _, value in sprintAnims or {} do
		if value.Parent then
			watchSprintAnimator(value)
			
			for _, playingAnimationTrack in value:GetPlayingAnimationTracks() do
				muteOneSprint(playingAnimationTrack, IsKeyDown)
			end
		end
	end
end

