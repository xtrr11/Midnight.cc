function readQuestWords()
	local t = {}
	local t1 = {}
	
	local function add(Title, p263)
		local config = {
			find = true,
			collect = true,
			bring = true,
			the = true,
			some = true,
			get = true,
			grab = true,
			locate = true,
			search = true,
			retrieve = true,
			deliver = true,
			turn = true,
			of = true,
			["and"] = true,
			["for"] = true,
			a = true,
			an = true,
			["in"] = true,
			to = true,
			from = true,
			with = true,
			your = true,
			you = true,
			quest = true
		}
		local List = {}
		
		for i in string.gmatch(string.lower(tostring(p263 or "")), "%a+") do
			if not config[i] and #i >= 3 then
				List[#List + 1] = i
			end
		end
		local Joined = #List > 0 and table.concat(List) or questPhrase(p263)
		
		if #Joined >= 4 and not t1[Joined] and Joined ~= "complete" then
			t1[Joined] = true
			t[#t + 1] = { phrase = Joined, title = Title }
			
			return
		end
	end
	
	questPageFound = false
	local Quests = questPage
	
	if not Quests or not Quests.Parent then
		local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
		local MainGui = PlayerGui and PlayerGui:FindFirstChild("MainGui")
		local MainFrame = MainGui and MainGui:FindFirstChild("MainFrame")
		Quests = MainFrame and MainFrame:FindFirstChild("Quests", true)
		questPage = Quests
	end
	questPageFound = Quests ~= nil
	
	if Quests then
		for _, descendant in Quests:GetDescendants() do
			local Lowered = string.lower(descendant.Name)
			
			if Lowered ~= "questdescrij" and Lowered ~= "questdescription" and Lowered ~= "queststory" and (descendant:IsA("TextLabel") or descendant:IsA("TextButton")) then
				local Text = descendant.Text
				
				if type(Text) == "string" then
					local Replaced = string.gsub(Text, "<.->", "")
					
					if #Replaced <= 72 and not string.find(Replaced, "\n", 1, true) and not string.find(Replaced, "[Complete]", 1, true) then
						local Match, Match2 = string.match(Replaced, "%[([^%]]+)%]%s*(.+)")
						
						if Match and Match2 and Match ~= "Complete" then
							add("[" .. Match .. "] " .. Match2, Match2)
						end
					end
				end
			end
		end
	end
	return t
end

function stepQuestPins()
	local ClockTime = os.clock()
	
	if ClockTime - (questWordTime or 0) < 8 then return end
	questWordTime = ClockTime
	
	if not questWords or ClockTime - (questListTime or 0) >= 20 then
		questWords = readQuestWords()
		questListTime = ClockTime
	end
	local Phrases = {}
	
	for _, value in questWords or {} do
		Phrases[value.title] = value.phrase
	end
	local t = {}
	
	for _, value1 in questPins or {} do
		local Phras = value1.title and Phrases[value1.title]
		
		if Phras and value1.item and questFits(questPhrase(value1.item), Phras) and typeof(value1.pos) == "Vector3" then
			t[value1.title] = value1
		end
	end
	local Questitems = workspace:FindFirstChild("Questitems") or workspace:FindFirstChild("QuestItems")
	local List = {}
	local Names = {}
	
	if #questWords == 0 then
		List[1] = if questPageFound then "none read" else "quest page missing"
	elseif Questitems then
		local List1 = {}
		local List2 = { Questitems }
		local Count = 0
		local Removed = nil
		local Position = nil
		while #List2 > 0 and Count < 400 do
			Removed = table.remove(List2)
			Count += 1
			
			if Removed ~= Questitems and (Removed:IsA("Model") or Removed:IsA("BasePart") or Removed:IsA("Folder")) then
				local QuestPhraseResult = questPhrase(Removed.Name)
				
				for _, questWord in questWords do
					if not Names[questWord.title] and questWordHit(QuestPhraseResult, questWord.phrase) then
						Position = nil
						
						if Removed:IsA("BasePart") then
							Position = Removed.Position
						else
							local Success, Result = pcall(Removed.GetPivot, Removed)
							
							if Success and typeof(Result) == "CFrame" then
								Position = Result.Position
							end
						end
						if typeof(Position) ~= "Vector3" then break end
						t[questWord.title] = {
							pos = Position,
							title = questWord.title,
							item = Removed.Name
						}
						Names[questWord.title] = Removed.Name
						rememberMap("quest:" .. questWord.title, questWord.title, flagColor("QuestColor", Color3.fromRGB(255, 214, 80)), Position)
						break
					end
				end
			end
			if not Removed or Removed:IsA("BasePart") then continue end
			for _, child in Removed:GetChildren() do
				List2[#List2 + 1] = child
			end
		end
		local Flag = false
		
		for _ in Names do
			Flag = true
			break
		end
		if not Flag and #List1 > 0 then
			List[#List + 1] = "in folder: " .. table.concat(List1, ", ")
		end
	else
		List[#List + 1] = "no Questitems"
	end
	local t1 = {}
	
	for _, questWord2 in questWords do
		t1[questWord2.title] = true
	end
	questPins = {}
	
	if #questWords == 0 then
		for _, value2 in t do
			questPins[#questPins + 1] = value2
		end
	else
		for i1, value3 in t do
			if t1[i1] then
				questPins[#questPins + 1] = value3
			end
		end
	end
	for _, questWord1 in questWords do
		List[#List + 1] = questWord1.title .. (Names[questWord1.title] and "  " .. Names[questWord1.title] or (if t[questWord1.title] then "  saved" else "  no item"))
	end
	if mapSaved then
		local t2 = {}
		
		for _, questPin in questPins do
			if questPin.title then
				t2["quest:" .. questPin.title] = true
			end
		end
		for i in mapSaved do
			if string.sub(i, 1, 6) == "quest:" and not t2[i] then
				mapSaved[i] = nil
			end
		end
	end
	if questReadout then
		questReadout.Text = table.concat(List, "\n")
		
		if questPanel then
			questPanel.Visible = true
			paintBack(questPanel, v0.Flags.QuestBg ~= false, 0, Color3.fromRGB(12, 12, 12))
		end
	end
end

function refreshActors()
	local t = {}
	local t1 = {}
	local Models = {}
	
	local function pushAi(Model, Humanoid, DisplayName)
		if not Humanoid or Humanoid.Health <= 0 then return end
		local Name = Model.Name
		
		if bossLabel(Name) or isEscort(Model, DisplayName) then
			Name = "Guard"
		elseif (Name == "Model" or Name == "NPC" or Name == "Character") and (DisplayName ~= "" and DisplayName ~= "Humanoid") then
			Name = DisplayName or Name
		end
		t[#t + 1] = {
			model = Model,
			kind = "ai",
			label = Name,
			humanoid = Humanoid
		}
	end
	
	local function take(Model)
		if not Model or not Model:IsA("Model") or ownedCharacter(Model) or isFrozenPlayerCopy(Model) then return end
		local Humanoid = Model:FindFirstChildOfClass("Humanoid")
		local DisplayName = Humanoid and Humanoid.DisplayName or ""
		local Whisper = if isEscort(Model, DisplayName) then nil elseif isWhisper(Model) then "Whisper" else bossLabel(Model.Name) or DisplayName ~= "" and bossLabel(DisplayName)
		
		if not Whisper or Humanoid and Humanoid.Health <= 0 and Whisper ~= "Mi-24" and Whisper ~= "BTR-80" then
			pushAi(Model, Humanoid, DisplayName)
			
			return
		end
		local MaxHealth = Humanoid and Humanoid.MaxHealth or 0
		local IsLoweredMatch = string.lower(Model.Name) == string.lower(Whisper)
		local Entry = t1[Whisper]
		
		if Entry and (not IsLoweredMatch or Entry.exact) and (IsLoweredMatch ~= Entry.exact or MaxHealth <= Entry.hp) then
			Models[#Models + 1] = Model
			
			return
		end
		if Entry then
			Models[#Models + 1] = Entry.model
		end
		t1[Whisper] = {
			model = Model,
			humanoid = Humanoid,
			label = Whisper,
			hp = MaxHealth,
			exact = IsLoweredMatch
		}
	end
	
	local AiZones = workspace:FindFirstChild("AiZones")
	
	if AiZones then
		for _, Model in AiZones:GetChildren() do
			if Model:IsA("Model") then
				take(Model)
				continue
			end
			for _, child in Model:GetChildren() do
				if child:IsA("Model") then
					take(child)
				elseif child:IsA("Folder") then
					for _, Model1 in child:GetChildren() do
						if Model1:IsA("Model") then
							take(Model1)
						end
					end
				end
			end
		end
	end
	for _, Model2 in workspace:GetChildren() do
		if Model2:IsA("Model") then
			local BossLabelResult = bossLabel(Model2.Name)
			
			if BossLabelResult == "Mi-24" or BossLabelResult == "BTR-80" then
				t[#t + 1] = { model = Model2, kind = "boss", label = BossLabelResult }
			end
		end
	end
	for _, value in t1 do
		t[#t + 1] = {
			model = value.model,
			kind = "boss",
			label = value.label,
			humanoid = value.humanoid
		}
	end
	for _, model in Models do
		local Humanoid = model:FindFirstChildOfClass("Humanoid")
		pushAi(model, Humanoid, Humanoid and Humanoid.DisplayName or "")
	end
	actorCache = t
end

function npcBox(Object, Camera)
	local Head = Object:FindFirstChild("Head")
	local HumanoidRootPart = Object:FindFirstChild("HumanoidRootPart") or (Object:FindFirstChild("UpperTorso") or Object:FindFirstChild("Torso"))
	
	if not Head and not HumanoidRootPart then
		return nil
	end
	local HumanoidRootPart1 = HumanoidRootPart or Head
	local NewPosition = Head and Head:IsA("BasePart") and Head.Position + Vector3.new(0, Head.Size.Y * 0.55, 0) or HumanoidRootPart1.Position + Vector3.new(0, 2.2, 0)
	local PositionDelta = HumanoidRootPart1.Position - Vector3.new(0, 3, 0)
	local LeftFoot = Object:FindFirstChild("LeftFoot") or (Object:FindFirstChild("RightFoot") or (Object:FindFirstChild("Left Leg") or Object:FindFirstChild("Right Leg")))
	
	if LeftFoot and LeftFoot:IsA("BasePart") then
		PositionDelta = LeftFoot.Position - Vector3.new(0, LeftFoot.Size.Y * 0.45, 0)
	end
	local ViewportPoint = Camera:WorldToViewportPoint(NewPosition)
	local ViewportPoint1 = Camera:WorldToViewportPoint(PositionDelta)
	
	if ViewportPoint.Z < 0.25 or ViewportPoint1.Z < 0.25 then
		return nil
	else
		local Largest = math.max(math.abs(ViewportPoint1.Y - ViewportPoint.Y), 16)
		local Largest1 = math.max(Largest * 0.5, 12)
		
		return (ViewportPoint.X + ViewportPoint1.X) * 0.5 - Largest1 * 0.5 - 2, math.min(ViewportPoint.Y, ViewportPoint1.Y) - 2, Largest1 + 4, Largest + 4
	end
end

